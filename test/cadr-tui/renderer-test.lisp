(in-package #:cadr-tui/tests)
(in-suite cadr-tui-suite)

(test main-renderer-keeps-raw-document-lines-and-clips-only-at-the-terminal-boundary
  ;; TuiMainScreen receives the natural document.  Retaining a separately
  ;; clipped copy of every off-screen line makes stable large transcripts
  ;; allocate in proportion to history on every frame.
  (let* ((terminal
           (cadr-tui:make-virtual-terminal
            :columns 8 :rows 3))
         (renderer
           (cadr-tui:make-terminal-renderer terminal))
         (document
           (list "first-line-is-wide"
                 "second-line-is-wide"
                 "third-line-is-wide"
                 "fourth-line-is-wide")))
    (cadr-tui:render-frame
     renderer document :cursor-row 3 :cursor-column 0)
    (is
     (equal
      document
      (cadr-tui::terminal-renderer-previous-lines renderer)))
    (is
     (every
      (lambda (line)
        (<= (cadr-tui:visible-width line) 8))
      (cadr-tui:virtual-terminal-snapshot terminal)))
    (let ((output
            (cadr-tui:render-frame
             renderer document :cursor-row 3 :cursor-column 0)))
      (is (null (search "first-li" output)))
      (is (null (search "fourth-l" output))))))

(test main-screen-first-render-preserves-scrollback-and-stop-position
  (let* ((terminal
           (cadr-tui:make-virtual-terminal
            :columns 20 :rows 3))
         (renderer
           (cadr-tui:make-terminal-renderer terminal))
         (document
           '("one" "two" "three" "four" "five"))
         (output
           (cadr-tui:render-frame renderer document)))
    (is (null
         (search (format nil "~C[2J" #\Escape)
                 output)))
    (is (search "one" output))
    (is (search "five" output))
    (is (= 5
           (length
            (cadr-tui::terminal-renderer-previous-lines
             renderer))))
    (setf
     (cadr-tui::virtual-writes terminal)
     nil)
    (cadr-tui:renderer-before-stop renderer)
    (let ((stop-output
            (first
             (cadr-tui::virtual-writes terminal))))
      (is (search
           (format nil "~C~C"
                   #\Return #\Newline)
           stop-output))
      (is (null
           (search
            (format nil "~C[?1049l" #\Escape)
            stop-output))))))

(test differential-renderer-updates-only-changed-lines
  (let* ((terminal (cadr-tui:make-virtual-terminal :columns 12 :rows 4))
         (renderer (cadr-tui:make-terminal-renderer terminal)))
    (cadr-tui:render-frame renderer '("one" "two") :cursor-row 1 :cursor-column 3)
    (is (equal '("one" "two" "" "")
               (cadr-tui:virtual-terminal-snapshot terminal)))
    (let ((output
            (cadr-tui:render-frame
             renderer '("one" "TWO")
             :cursor-row 1 :cursor-column 3)))
      (is (null (search (format nil "~C[1;1H" #\Escape) output)))
      (is (search
           (format nil "~C~C[2KTWO"
                   #\Return #\Escape)
           output))
      (is (null (search "one" output))))
    (is (equal '("one" "TWO" "" "")
               (cadr-tui:virtual-terminal-snapshot terminal)))))

(test renderer-clears-shrunk-content-and-redraws-on-resize
  (let* ((terminal (cadr-tui:make-virtual-terminal :columns 10 :rows 4))
         (renderer (cadr-tui:make-terminal-renderer terminal)))
    (cadr-tui:render-frame renderer '("a" "b" "c"))
    (let ((output
            (cadr-tui:render-frame renderer '("a"))))
      ;; pi@16787ad5b TuiMainScreen.ts:297-343 clears deleted tail rows
      ;; differentially when clear-on-shrink is disabled; it does not erase
      ;; scrollback merely because a selector or document became shorter.
      (is (null (search (format nil "~C[2J" #\Escape) output)))
      (is (search (format nil "~C[2K" #\Escape) output)))
    (is (equal '("a" "" "" "")
               (cadr-tui:virtual-terminal-snapshot terminal)))
    (setf (cadr-tui:terminal-columns terminal) 8)
    (let ((output (cadr-tui:render-frame renderer '("z"))))
      (is (search (format nil "~C[2J" #\Escape) output)))
    (is (equal '("z" "" "" "")
               (cadr-tui:virtual-terminal-snapshot terminal)))))

(test renderer-clear-on-shrink-is-explicit-and-resets-the-working-area
  ;; pi@16787ad5b TuiMainScreen.ts:250-259 only takes the full-clear shrink
  ;; path when the setting is enabled.  This assertion is derived from that
  ;; branch condition, not from a snapshot generated by cadr.
  (let* ((terminal
           (cadr-tui:make-virtual-terminal
            :columns 12 :rows 5))
         (renderer
           (cadr-tui:make-terminal-renderer
            terminal :clear-on-shrink-p t)))
    (cadr-tui:render-frame renderer '("one" "two" "three"))
    (let ((output
            (cadr-tui:render-frame renderer '("one"))))
      (is (search (format nil "~C[2J" #\Escape) output))
      (is (search (format nil "~C[3J" #\Escape) output))
      (is (= 1
             (cadr-tui::terminal-renderer-max-lines-rendered
              renderer))))
    (cadr-tui:renderer-set-clear-on-shrink renderer nil)
    (cadr-tui:render-frame renderer '("one" "two" "three"))
    (let ((output
            (cadr-tui:render-frame renderer '("one"))))
      (is (null (search (format nil "~C[2J" #\Escape) output)))
      (is (equal '("one" "" "" "" "")
                 (cadr-tui:virtual-terminal-snapshot terminal))))))

(test renderer-clear-on-shrink-is-suppressed-while-an-overlay-is-active
  ;; pi@16787ad5b TuiMainScreen.ts:250-259 excludes overlay-active frames
  ;; from clear-on-shrink so opening a short custom overlay cannot erase the
  ;; transcript beneath it.
  (let* ((terminal
           (cadr-tui:make-virtual-terminal
            :columns 12 :rows 5))
         (renderer
           (cadr-tui:make-terminal-renderer
            terminal :clear-on-shrink-p t)))
    (cadr-tui:render-frame renderer '("one" "two" "three"))
    (let ((overlay-output
            (cadr-tui:render-frame
             renderer '("overlay")
             :overlay-active-p t)))
      (is (null (search (format nil "~C[2J" #\Escape)
                        overlay-output)))
      (is (search (format nil "~C[2K" #\Escape)
                  overlay-output)))
    (cadr-tui:render-frame renderer '("one" "two" "three"))
    (let ((root-output
            (cadr-tui:render-frame renderer '("root"))))
      (is (search (format nil "~C[2J" #\Escape)
                  root-output)))))

(test renderer-differential-shrink-preserves-the-maximum-line-high-water-mark
  ;; pi@16787ad5b TuiMainScreen.ts:297-343 keeps maxLinesRendered as a
  ;; high-water mark until an explicit full clear.  A shrink followed by an
  ;; append must therefore clear the entire stale tail without inventing a
  ;; full-screen erase.
  (let* ((terminal
           (cadr-tui:make-virtual-terminal
            :columns 12 :rows 6))
         (renderer
           (cadr-tui:make-terminal-renderer terminal)))
    (cadr-tui:render-frame renderer '("one" "two" "three" "four"))
    (cadr-tui:render-frame renderer '("one" "two"))
    (let ((output
            (cadr-tui:render-frame
             renderer '("one" "TWO" "three"))))
      (is (null (search (format nil "~C[2J" #\Escape) output)))
      (is (= 4
             (cadr-tui::terminal-renderer-max-lines-rendered
              renderer)))
      (is (equal '("one" "TWO" "three" "" "" "")
                 (cadr-tui:virtual-terminal-snapshot terminal))))))

#+sbcl
(test renderer-termux-height-resize-recomputes-the-viewport-without-full-clear
  ;; pi@16787ad5b TuiMainScreen.ts:233-243 deliberately avoids the usual
  ;; height-change full redraw on Termux and instead recomputes viewportTop.
  (require :sb-posix)
  (let ((previous (uiop:getenv "TERMUX_VERSION")))
    (unwind-protect
         (progn
           (sb-posix:setenv "TERMUX_VERSION" "0.119" 1)
           (let* ((terminal
                    (cadr-tui:make-virtual-terminal
                     :columns 12 :rows 3))
                  (renderer
                    (cadr-tui:make-terminal-renderer terminal)))
             (cadr-tui:render-frame
              renderer '("zero" "one" "two" "three" "four"))
             (setf (cadr-tui:terminal-rows terminal) 4)
             (let ((output
                     (cadr-tui:render-frame
                      renderer '("zero" "one" "two" "THREE" "four"))))
               (is (null (search (format nil "~C[2J" #\Escape)
                                 output)))
               (is (= 1
                      (cadr-tui::terminal-renderer-previous-viewport-top
                       renderer)))
               (is (equal '("zero" "one" "two" "THREE" "four")
                          (mapcar
                           #'cadr-tui::strip-ansi
                           (cadr-tui::terminal-renderer-previous-lines
                            renderer)))))))
      (if previous
          (sb-posix:setenv "TERMUX_VERSION" previous 1)
          (sb-posix:unsetenv "TERMUX_VERSION")))))

(test renderer-isolates-line-styles
  (let* ((terminal
           (cadr-tui:make-virtual-terminal
            :columns 20 :rows 3))
         (renderer
           (cadr-tui:make-terminal-renderer terminal))
         (styled
           (format nil "~C[3mitalic" #\Escape))
         (output
           (cadr-tui:render-frame
            renderer (list styled "plain"))))
    (is (search
         (format nil "~C[3mitalic~C[0m"
                 #\Escape #\Escape)
         output))
    (is (search
         (format nil "plain~C[0m" #\Escape)
         output))))

(test renderer-deletes-changed-kitty-images-before-redraw
  (let* ((terminal
           (cadr-tui:make-virtual-terminal
            :columns 40 :rows 6))
         (renderer
           (cadr-tui:make-terminal-renderer terminal))
         (old
           (cadr-tui:encode-kitty-image
            "AAAA" :columns 2 :rows 2
            :image-id 42 :move-cursor-p nil))
         (new
           (cadr-tui:encode-kitty-image
            "BBBB" :columns 2 :rows 1
            :image-id 42 :move-cursor-p nil)))
    (cadr-tui:render-frame renderer (list "top" old ""))
    (let* ((output
             (cadr-tui:render-frame
              renderer (list new "")))
           (delete
             (cadr-tui:delete-kitty-image 42))
           (delete-position (search delete output))
           (draw-position (search new output)))
      (is (integerp delete-position))
      (is (integerp draw-position))
      (is (< delete-position draw-position)))
    (cadr-tui:render-frame renderer (list old ""))
    (cadr-tui:invalidate-renderer renderer)
    (let* ((output
             (cadr-tui:render-frame
              renderer '("plain")))
           (delete-position
             (search
              (cadr-tui:delete-kitty-image 42)
              output))
           (clear-position
             (search (format nil "~C[2J" #\Escape)
                     output)))
      (is (integerp delete-position))
      (is (integerp clear-position))
      (is (< delete-position clear-position)))))

(test renderer-preclears-kitty-reserved-rows
  (let* ((terminal
           (cadr-tui:make-virtual-terminal
            :columns 40 :rows 6))
         (renderer
           (cadr-tui:make-terminal-renderer terminal))
         (image
           (cadr-tui:encode-kitty-image
            "AAAA" :columns 2 :rows 3
            :image-id 77 :move-cursor-p nil)))
    (cadr-tui:render-frame renderer '("before"))
    (let ((output
            (cadr-tui:render-frame
             renderer
             (list "before" image "" "" "after"))))
      (is (search
           (format nil
                   "~C[2K~C~C~C[2K~C~C~C[2K~C[2A"
                   #\Escape
                   #\Return #\Newline #\Escape
                   #\Return #\Newline #\Escape
                   #\Escape)
           output)))))

(test renderer-hides-hardware-cursor-by-default-in-main-and-alt-modes
  (dolist (alt-p '(nil t))
    (let* ((terminal
             (cadr-tui:make-virtual-terminal
              :columns 20 :rows 4))
           (renderer
             (cadr-tui:make-terminal-renderer
              terminal :alt-p alt-p))
           (output
             (cadr-tui:render-frame
              renderer '("editor")
              :cursor-row 0 :cursor-column 3)))
      (is (search
           (format nil "~C[?25l" #\Escape)
           output))
      (is (null
           (search
            (format nil "~C[?25h" #\Escape)
            output))))))

(test renderer-explicit-hardware-cursor-option-is-main-alt-symmetric
  (dolist (alt-p '(nil t))
    (let* ((terminal
             (cadr-tui:make-virtual-terminal
              :columns 20 :rows 4))
           (renderer
             (cadr-tui:make-terminal-renderer
              terminal
              :alt-p alt-p
              :show-hardware-cursor-p t))
           (output
             (cadr-tui:render-frame
              renderer '("editor")
              :cursor-row 0 :cursor-column 3)))
      (is (search
           (if alt-p
               (format nil "~C[1;4H" #\Escape)
               (format nil "~C[4G" #\Escape))
           output))
      (is (search
           (format nil "~C[?25h" #\Escape)
           output)))))

(test goal15-nil-cursor-hides-without-reposition-in-main-and-alt
  ;; pi@16787ad5b Tui.ts:1127-1151 and TuiMainScreen.ts:515-523 hide the
  ;; cursor when no focused component returns a marker.  NIL must never be
  ;; coerced to the top-left corner.
  (dolist (alt-p '(nil t))
    (let* ((terminal
             (cadr-tui:make-virtual-terminal
              :columns 20 :rows 4))
           (renderer
             (cadr-tui:make-terminal-renderer
              terminal :alt-p alt-p
              :show-hardware-cursor-p t)))
      (cadr-tui:render-frame
       renderer '("one" "two")
       :cursor-row 1 :cursor-column 3)
      (let* ((previous-row
               (cadr-tui::terminal-renderer-hardware-cursor-row
                renderer))
             (output
               (cadr-tui:render-frame
                renderer '("one" "two")
                :cursor-row nil :cursor-column nil)))
        (is
         (search (format nil "~C[?25l" #\Escape) output))
        (is
         (null
          (search (format nil "~C[?25h" #\Escape) output)))
        (is
         (null
          (search
           (if alt-p
               (format nil "~C[1;1H" #\Escape)
               (format nil "~C[1G" #\Escape))
           output)))
        (is
         (= previous-row
            (cadr-tui::terminal-renderer-hardware-cursor-row
             renderer)))))))

(test goal15-main-screen-hides-a-cursor-above-the-bottom-viewport
  ;; pi@16787ad5b tui.ts:1142-1159 scans cursor markers only in the bottom
  ;; terminal-height rows.  An input retained in the natural document above
  ;; that viewport must not drag the hardware cursor into scrollback.
  (let* ((terminal
           (cadr-tui:make-virtual-terminal
            :columns 20 :rows 3))
         (renderer
           (cadr-tui:make-terminal-renderer
            terminal :show-hardware-cursor-p t)))
    (cadr-tui:render-frame
     renderer '("zero" "one" "two" "three" "four")
     :cursor-row 4 :cursor-column 2)
    (let* ((previous-row
             (cadr-tui::terminal-renderer-hardware-cursor-row
              renderer))
           (output
             (cadr-tui:render-frame
              renderer
              '("zero" "one" "two" "three" "four")
              :cursor-row 1 :cursor-column 2)))
      (is (search (format nil "~C[?25l" #\Escape) output))
      (is (null (search (format nil "~C[?25h" #\Escape) output)))
      (is (= previous-row
             (cadr-tui::terminal-renderer-hardware-cursor-row
              renderer))))))

(test tui-debug-redraw-helper-reads-cadr-tui-debug-redraw
  (flet ((call-with-env (entries thunk)
           (let ((cadr-tui::*tui-environment-function*
                   (lambda (name)
                     (cdr (assoc name entries :test #'string=)))))
             (funcall thunk))))
    (call-with-env
     '(("CADR_TUI_DEBUG_REDRAW" . "1"))
     (lambda ()
       (is (eq t (cadr-tui:tui-debug-redraw-p)))))
    (call-with-env
     '(("CADR_TUI_DEBUG_REDRAW" . "0"))
     (lambda ()
       (is (null (cadr-tui:tui-debug-redraw-p)))))
    (call-with-env
     '(("PI_TUI_DEBUG_REDRAW" . "1")
       ("PI_DEBUG_REDRAW" . "1"))
     (lambda ()
       (is (null (cadr-tui:tui-debug-redraw-p)))))
    (call-with-env
     nil
     (lambda ()
       (is (null (cadr-tui:tui-debug-redraw-p)))))))

(test tui-debug-redraw-logs-first-full-render-when-gated
  (let* ((root
           (uiop:ensure-directory-pathname
            (merge-pathnames
             (format nil "cadr-tui-debug-redraw-~D/"
                     (get-internal-real-time))
             (uiop:temporary-directory))))
         (log-path
           (merge-pathnames "cadr-tui-debug.log" root)))
    (unwind-protect
         (let ((cadr-tui::*tui-environment-function*
                 (lambda (name)
                   (when (string= name "CADR_TUI_DEBUG_REDRAW")
                     "1")))
               (cadr-core::*path-environment-function*
                 (lambda (name)
                   (when (string= name "CADR_CODING_AGENT_DIR")
                     (namestring root)))))
           (ensure-directories-exist root)
           (let* ((terminal
                    (cadr-tui:make-virtual-terminal
                     :columns 20 :rows 3))
                  (renderer
                    (cadr-tui:make-terminal-renderer terminal)))
             (cadr-tui:render-frame renderer '("one" "two"))
             (is (probe-file log-path))
             (let ((text (uiop:read-file-string log-path)))
               (is (search "fullRender: first render" text))
               (is (search "prev=0" text))
               (is (search "new=2" text)))))
      (uiop:delete-directory-tree
       root :validate t :if-does-not-exist :ignore))))
