;;; Goal 19 Part B golden tests for the pure-Lisp mermaid renderer.
;;;
;;; The authority is test/fixtures/mermaid-golden/reference.json, produced
;;; from the checked-in grok-mermaid@0.2.2 fixture by
;;; scripts/grok-mermaid-golden.mjs.  The full corpus is mirrored into
;;; +mermaid-golden-results+ (generated by scripts/gen-mermaid-golden-data.py
;;; and kept in sync by verify.sh), and every corpus entry is judged
;;; byte-exact: null/width/warnings/plain/styled (text and class per span).
;;;
;;; Each snapshot-style assertion below carries an independent semantic
;;; assertion derived from the baseline golden itself (width, row count,
;;; first row, marker characters) - not from cadr's implementation - per the
;;; project rule that a byte-exact SHA/golden proves "unchanged" but not
;;; "correct".
(in-package #:cadr-tui/tests)
(in-suite cadr-tui-suite)

(defun gm-render-captured (input)
  "Render input, capturing errors so one failing case reports instead of
   aborting the whole suite."
  (handler-case (cadr-tui::gm-render input)
    (error (e) (list :gm-error (princ-to-string e)))))

(test mermaid-golden-all-47-cases-byte-exact
  (let ((results +mermaid-golden-results+))
    (is (= 47 (length results))
        "golden data must carry exactly 47 cases, got ~D"
        (length results))
    (is (= 47 (length (remove-duplicates
                       (mapcar (lambda (c) (getf c :id)) results)
                       :test #'string=)))
        "golden case ids must be unique")
    (dolist (case results)
      (destructuring-bind (&key id input ((:null nullp))
                                width warnings plain styled)
          case
        (let ((rendered (gm-render-captured input)))
          (cond
            (nullp
             (is (null rendered) "~A: expected null render" id))
            ((and (consp rendered) (eq (first rendered) :gm-error))
             (fail "~A: renderer errored: ~A" id (second rendered)))
            ((null rendered)
             (fail "~A: expected art, got nil" id))
            (t
             (is (= width (getf rendered :width))
                 "~A: width ~D != expected ~D"
                 id (getf rendered :width) width)
             (is (equal warnings (getf rendered :warnings))
                 "~A: warnings ~S != expected ~S"
                 id (getf rendered :warnings) warnings)
             (is (equal plain (getf rendered :plain))
                 "~A: plain rows differ" id)
             (is (equal styled (getf rendered :styled))
                 "~A: styled spans differ" id))))))))

(test mermaid-reference-cases-render-exactly
  ;; The 29 embedded reference cases are the same corpus subset as the full
  ;; golden; keeping them inline makes the renderer's contract readable
  ;; without opening the 47-entry data file.
  (dolist (case +mermaid-reference-cases+)
    (destructuring-bind (id input &rest expected) case
      (let ((rendered (gm-render-captured input)))
        (cond
          ((eq (first expected) :null)
           (is (null rendered) "~A: expected null render" id))
          (t
           (destructuring-bind (expected-width expected-warnings expected-plain)
               expected
             (is (not (null rendered)) "~A: expected art, got nil" id)
             (when rendered
               (is (= expected-width (getf rendered :width))
                   "~A: width ~D != expected ~D"
                   id (getf rendered :width) expected-width)
               (is (equal expected-warnings (getf rendered :warnings))
                   "~A: warnings ~S != expected ~S"
                   id (getf rendered :warnings) expected-warnings)
               (is (equal expected-plain (getf rendered :plain))
                   "~A: plain rows differ" id)))))))))

(test mermaid-golden-independent-semantics
  ;; Independent assertions derived from the baseline golden
  ;; (reference.json, grok-mermaid@0.2.2), not from cadr's implementation:
  ;; kind classification, source-box geometry, and per-case width / row
  ;; count / marker characters.  A byte-exact golden only proves
  ;; "unchanged"; these prove the renderer keeps the baseline's observable
  ;; shape.
  (labels ((render (src) (gm-render-captured src))
           (rows (r) (getf r :plain))
           (width (r) (getf r :width))
           (warnings (r) (getf r :warnings))
           (rows-containing (r needle)
             (count-if (lambda (row) (search needle row)) (rows r))))
    ;; Diagram kind classification (baseline dist/index.js dispatch).
    (is (string= "flowchart"
                 (cadr-tui::gm-diagram-kind "flowchart LR
  A-->B")))
    (is (string= "flowchart"
                 (cadr-tui::gm-diagram-kind "graph TD
  A-->B")))
    (is (string= "state"
                 (cadr-tui::gm-diagram-kind "stateDiagram-v2
  A --> B")))
    (is (string= "class"
                 (cadr-tui::gm-diagram-kind "classDiagram
  class A")))
    (is (string= "er"
                 (cadr-tui::gm-diagram-kind "erDiagram
  A ||--|| B")))
    (is (string= "sequence"
                 (cadr-tui::gm-diagram-kind "sequenceDiagram
  A->>B: hi")))
    (is (null (cadr-tui::gm-diagram-kind "not a diagram")))
    (is (null (cadr-tui::gm-diagram-kind "%% just a comment")))
    (is (null (cadr-tui::gm-diagram-kind "")))
    ;; Source box: title is never truncated and sets the width floor.
    (let ((box (cadr-tui::gm-source-box "flowchart LR
  A-->B" nil)))
      (is (= 24 (width box)) "source box nil-width must be 24")
      (is (string= "╭ mermaid: flowchart ──╮" (first (rows box)))
          "source box first line must be the mermaid title rule"))
    (let ((box (cadr-tui::gm-source-box "flowchart LR
  A-->B" 20)))
      (is (= 24 (width box))
          "source box at max-width 20 must keep the 24-col title floor")
      (is (string= "╭ mermaid: flowchart ──╮" (first (rows box)))))
    ;; flowchart LR: 14 cols, 3 rows, directed edge marker.
    (let ((r (render "flowchart LR
  A-->B")))
      (is (= 14 (width r)) "graph-lr width")
      (is (= 3 (length (rows r))) "graph-lr row count")
      (is (string= "┌───┐    ┌───┐" (first (rows r))) "graph-lr first row")
      (is (= 1 (rows-containing r "▶")) "graph-lr single edge"))
    ;; graph TD chain: 13 rows, two downward arrows.
    (let ((r (render "graph TD
  A-->B
  B-->C")))
      (is (= 6 (width r)) "graph-td-chain width")
      (is (= 13 (length (rows r))) "graph-td-chain row count")
      (is (= 2 (rows-containing r "▼")) "graph-td-chain has two ▼"))
    ;; stateDiagram: start/end pseudo-states are dots.
    (let ((r (render "stateDiagram-v2
  [*] --> S1
  S1 --> S2
  S2 --> [*]")))
      (is (= 6 (width r)) "state-basic width")
      (is (= 18 (length (rows r))) "state-basic row count")
      (is (= 2 (rows-containing r "●")) "state-basic has two ●"))
    ;; sequenceDiagram: two actor columns, 13 rows.
    (let ((r (render "sequenceDiagram
  Alice->>John: Hello John
  John-->>Alice: Great")))
      (is (= 20 (width r)) "seq-basic width")
      (is (= 13 (length (rows r))) "seq-basic row count")
      (is (= 2 (rows-containing r "Alice")) "seq-basic Alice appears twice")
      (is (= 1 (rows-containing r "Hello John")) "seq-basic message once"))
    ;; CJK and emoji labels keep their display width.
    (let ((r (render "flowchart LR
  A[你好世界]-->B[测试]")))
      (is (= 24 (width r)) "graph-cjk width")
      (is (= 3 (length (rows r))) "graph-cjk row count")
      (is (= 1 (rows-containing r "你好世界")) "graph-cjk label rendered"))
    (let ((r (render "flowchart LR
  A[👨‍👩‍👧 family]-->B[🇨🇳]")))
      (is (= 23 (width r)) "graph-emoji width")
      (is (= 1 (rows-containing r "family")) "graph-emoji label rendered"))
    ;; classDiagram: inheritance head, member rows.
    (let ((r (render "classDiagram
  class Animal
  class Dog
  Animal <|-- Dog")))
      (is (= 10 (width r)) "class-basic width")
      (is (= 8 (length (rows r))) "class-basic row count")
      (is (= 1 (rows-containing r "△")) "class-basic inheritance head"))
    (let ((r (render "classDiagram
  class A {
    +int x
    +method()
  }
  class B
  A --> B")))
      (is (= 14 (width r)) "class-members width")
      (is (= 12 (length (rows r))) "class-members row count")
      (is (= 1 (rows-containing r "+method()")) "class-members method row"))
    ;; erDiagram: edge labels carry cardinality text.
    (let ((r (render "erDiagram
  CUSTOMER ||--o{ ORDER : places
  ORDER ||--|{ LINE-ITEM : contains")))
      (is (= 23 (width r)) "er-basic width")
      (is (= 13 (length (rows r))) "er-basic row count")
      (is (= 1 (rows-containing r "1 places 0..*")) "er-basic edge label"))
    ;; HTML-ish labels: width 7, 19 rows, three warnings (the (+N more)
    ;; suffix path is exercised by the full golden comparison).
    (let ((r (render "flowchart LR
  A[&lt;b&gt;x&lt;/b&gt;] --> B[`code`]")))
      (is (= 7 (width r)) "graph-html width")
      (is (= 19 (length (rows r))) "graph-html row count")
      (is (= 3 (length (warnings r))) "graph-html three warnings")
      (is (string= "node \"A\": label is missing its closing `]`"
                   (first (warnings r)))
          "graph-html first warning text"))
    ;; Lenient grammar rescues an unterminated label into an empty box.
    (let ((r (render "flowchart LR
  A[")))
      (is (= 5 (width r)) "err-graph width")
      (is (equal (rows r) '("┌───┐" "│   │" "└───┘"))
          "err-graph renders an empty A box")
      (is (= 1 (length (warnings r))) "err-graph one warning"))
    ;; Dropped final line paths: class and half-typed edges warn and salvage.
    (let ((r (render "classDiagram
  class A
  A -->")))
      (is (= 6 (width r)) "class-err width")
      (is (equal (rows r) '(" ┌───┐" " │ A │" " └───┘"))
          "class-err drops the unreadable final line")
      (is (equal (warnings r)
                 '("dropped, unreadable final line: \"A -->\""))
          "class-err warning text"))
    (let ((r (render "flowchart LR
  A-->")))
      (is (= 5 (width r)) "graph-half-link width")
      (is (equal (warnings r)
                 '("dropped, link has no target: \"A-->\""))
          "graph-half-link warning text"))
    (let ((r (render "flowchart LR
  A-->B
  B--")))
      (is (= 14 (width r)) "graph-half-edge2 width")
      (is (equal (warnings r)
                 '("dropped, link has no target: \"B--\""))
          "graph-half-edge2 warning text"))
    ;; sequence with no message text: unlabeled arrow, no warning.
    (let ((r (render "sequenceDiagram
  Alice->>John")))
      (is (= 18 (width r)) "seq-err width")
      (is (= 9 (length (rows r))) "seq-err row count")
      (is (equal (warnings r) nil) "seq-err has no warnings")
      (is (= 1 (rows-containing r "├────────▶│")) "seq-err unlabeled arrow"))
    ;; Wide diagrams: 4-line wrapped label; 8-node chain.
    (let ((r (render "flowchart LR
  A[very long label that should wrap at twenty four columns] --> B")))
      (is (= 34 (width r)) "graph-wide width")
      (is (= 5 (length (rows r))) "graph-wide row count")
      (is (= 1 (rows-containing r "should wrap at twenty"))
          "graph-wide wrapped label line"))
    (let ((r (render "flowchart LR
  A-->B-->C-->D-->E-->F-->G-->H")))
      (is (= 68 (width r)) "graph-long-chain width")
      (is (= 3 (length (rows r))) "graph-long-chain row count")
      (is (= 1 (rows-containing r "│ H │")) "graph-long-chain last node"))
    ;; Notes are consumed but not drawn for state/class diagrams.
    (let ((r (render "stateDiagram-v2
  A --> B
  note right of A: hi")))
      (is (= 6 (width r)) "state-note width")
      (is (= 8 (length (rows r))) "state-note row count")
      (is (zerop (rows-containing r "hi")) "state-note not drawn"))
    (let ((r (render "classDiagram
  class A
  note \"hello\" for A")))
      (is (= 6 (width r)) "class-note width")
      (is (= 3 (length (rows r))) "class-note row count")
      (is (zerop (rows-containing r "hello")) "class-note not drawn"))
    ;; sequenceDiagram note and loop boxes are drawn.
    (let ((r (render "sequenceDiagram
  Alice->>John: hi
  Note right of Alice: note text")))
      (is (= 24 (width r)) "seq-note width")
      (is (= 14 (length (rows r))) "seq-note row count")
      (is (= 1 (rows-containing r "note text")) "seq-note box drawn"))
    (let ((r (render "sequenceDiagram
  loop every day
    Alice->>John: hi
  end")))
      (is (= 19 (width r)) "seq-loop width")
      (is (= 14 (length (rows r))) "seq-loop row count")
      (is (= 1 (rows-containing r "── loop every day ─")) "seq-loop divider"))
    ;; subgraph frame and self-loop.
    (let ((r (render "flowchart LR
  subgraph one
    A-->B
  end
  C-->A")))
      (is (= 25 (width r)) "graph-subgraph width")
      (is (= 6 (length (rows r))) "graph-subgraph row count")
      (is (= 1 (rows-containing r "one")) "graph-subgraph title"))
    (let ((r (render "flowchart LR
  A-->A")))
      (is (= 7 (width r)) "graph-selfloop width")
      (is (= 5 (length (rows r))) "graph-selfloop row count")
      (is (= 1 (rows-containing r "▲")) "graph-selfloop loop marker"))
    ;; Null cases: not a diagram, empty body, truncated state/er, blank,
    ;; comment-only.
    (dolist (src '("not a diagram"
                   "flowchart LR"
                   "stateDiagram-v2
  A -->"
                   "erDiagram
  CUSTOMER ||--o{"
                   ""
                   "%% just a comment"))
      (is (null (render src)) "~S must render nil" src))))
