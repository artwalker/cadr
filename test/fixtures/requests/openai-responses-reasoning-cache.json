{
  "model": "gpt-5.5",
  "input": [
    {
      "role": "developer",
      "content": "Be precise."
    },
    {
      "role": "user",
      "content": [
        {
          "type": "input_text",
          "text": "Inspect README.md"
        }
      ]
    }
  ],
  "stream": true,
  "prompt_cache_key": "fixture-session",
  "prompt_cache_retention": "24h",
  "store": false,
  "max_output_tokens": 4096,
  "tools": [
    {
      "type": "function",
      "name": "read",
      "description": "Read a file.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "strict": true
    }
  ],
  "reasoning": {
    "effort": "high",
    "summary": "auto"
  },
  "include": [
    "reasoning.encrypted_content"
  ]
}
