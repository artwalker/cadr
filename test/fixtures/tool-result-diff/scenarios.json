{
  "baselineCommit": "ecac0a9c4edad3dac5d9f8b40e0c7db7a56471fc",
  "builtinTools": ["read", "bash", "edit", "write", "grep", "find", "ls"],
  "scenarios": [
    {
      "id": "read-success",
      "tool": "read",
      "outcome": "success",
      "arguments": {"path": "input.txt", "limit": 2},
      "setup": {"files": [{"path": "input.txt", "text": "alpha\nbeta\ngamma"}]}
    },
    {
      "id": "read-failure",
      "tool": "read",
      "outcome": "failure",
      "contract": "path-not-found",
      "arguments": {"path": "missing.txt"}
    },
    {
      "id": "read-permission-denied",
      "tool": "read",
      "outcome": "failure",
      "contract": "permission-denied",
      "arguments": {"path": "locked.txt"},
      "setup": {
        "files": [{"path": "locked.txt", "text": "secret", "mode": "0000"}]
      }
    },
    {
      "id": "bash-success",
      "tool": "bash",
      "outcome": "success",
      "arguments": {"command": "printf 'alpha\\nbeta\\n'"}
    },
    {
      "id": "bash-failure",
      "tool": "bash",
      "outcome": "failure",
      "contract": "nonzero-exit",
      "arguments": {"command": "printf 'oops\\n'; exit 7"}
    },
    {
      "id": "bash-timeout",
      "tool": "bash",
      "outcome": "failure",
      "contract": "timeout",
      "arguments": {"command": "/usr/bin/sleep 5", "timeout": 1}
    },
    {
      "id": "bash-invalid-arguments",
      "tool": "bash",
      "outcome": "failure",
      "contract": "invalid-arguments",
      "arguments": {"command": 42}
    },
    {
      "id": "bash-broken-pipe",
      "tool": "bash",
      "outcome": "success",
      "contract": "broken-pipe",
      "arguments": {
        "command": "/usr/bin/yes line | /usr/bin/head -n 5"
      }
    },
    {
      "id": "bash-full-output-path",
      "tool": "bash",
      "outcome": "success",
      "contract": "output-over-limit",
      "arguments": {"command": "/usr/bin/head -c 61440 /dev/zero | /usr/bin/tr '\\0' x"}
    },
    {
      "id": "edit-success",
      "tool": "edit",
      "outcome": "success",
      "arguments": {
        "path": "edit.txt",
        "edits": [{"oldText": "alpha", "newText": "ALPHA"}, {"oldText": "gamma", "newText": "GAMMA"}]
      },
      "setup": {"files": [{"path": "edit.txt", "text": "alpha beta gamma"}]}
    },
    {
      "id": "edit-failure",
      "tool": "edit",
      "outcome": "failure",
      "arguments": {
        "path": "edit.txt",
        "edits": [{"oldText": "same", "newText": "changed"}]
      },
      "setup": {"files": [{"path": "edit.txt", "text": "same same"}]}
    },
    {
      "id": "write-success",
      "tool": "write",
      "outcome": "success",
      "arguments": {"path": "unicode.txt", "content": "中🙂"}
    },
    {
      "id": "write-failure",
      "tool": "write",
      "outcome": "failure",
      "arguments": {"path": "parent-file/child.txt", "content": "blocked"},
      "setup": {"files": [{"path": "parent-file", "text": "not a directory"}]}
    },
    {
      "id": "grep-success",
      "tool": "grep",
      "outcome": "success",
      "arguments": {"pattern": "needle", "path": ".", "limit": 2},
      "setup": {
        "files": [
          {"path": "a.txt", "text": "before\nneedle one\nafter"},
          {"path": "b.txt", "text": "needle two"}
        ]
      }
    },
    {
      "id": "grep-failure",
      "tool": "grep",
      "outcome": "failure",
      "arguments": {"pattern": "needle", "path": "missing"}
    },
    {
      "id": "find-success",
      "tool": "find",
      "outcome": "success",
      "arguments": {"pattern": "*.txt"},
      "setup": {
        "files": [
          {"path": "a.txt", "text": "a"},
          {"path": "nested/b.txt", "text": "b"},
          {"path": "skip.md", "text": "skip"}
        ]
      }
    },
    {
      "id": "find-failure",
      "tool": "find",
      "outcome": "failure",
      "arguments": {"pattern": "*.txt", "path": "missing"}
    },
    {
      "id": "ls-success",
      "tool": "ls",
      "outcome": "success",
      "arguments": {"path": "."},
      "setup": {
        "directories": [{"path": "nested"}],
        "files": [{"path": "a.txt", "text": "a"}, {"path": ".hidden", "text": "h"}]
      }
    },
    {
      "id": "ls-failure",
      "tool": "ls",
      "outcome": "failure",
      "arguments": {"path": "missing"}
    }
  ]
}
