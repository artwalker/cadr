{
  "schemaVersion": 1,
  "baselineCommit": "74caa2649f10ed71b4378ce69f5d9fbfd2466ca5",
  "classes": {
    "I01": {
      "kind": "intentional-difference",
      "summary": "The SBCL terminal emitter uses different ANSI update segmentation and teardown sequences while preserving terminal-state semantics."
    },
    "I02": {
      "kind": "intentional-difference",
      "summary": "The approved Goal 13 fatal boundary redacts the backtrace and writes a private crash log instead of dumping pi's uncaught-exception stack to the terminal."
    },
    "D01": {
      "kind": "cadr-defect",
      "summary": "Startup chrome differs in output padding, product/version styling, terminal title, and compact-help spacing."
    },
    "D02": {
      "kind": "cadr-defect",
      "summary": "Transcript/editor composition inserts two extra rows and therefore changes clipping, viewport position, and cursor geometry."
    },
    "D03": {
      "kind": "cadr-defect",
      "summary": "Footer output differs in cwd formatting, initial context, usage accounting, and the single-provider thinking suffix."
    },
    "D04": {
      "kind": "cadr-defect",
      "summary": "The untrusted-project warning emitted by the baseline is absent."
    },
    "D05": {
      "kind": "cadr-defect",
      "summary": "grep result ordering differs from the baseline's deterministic order."
    },
    "D06": {
      "kind": "cadr-defect",
      "summary": "ls ignores the requested notes path in the captured user path and lists the workspace root."
    },
    "D07": {
      "kind": "cadr-defect",
      "summary": "A missing read uses Cadr's File not found text instead of the baseline ENOENT path-bearing result."
    },
    "D08": {
      "kind": "cadr-defect",
      "summary": "Selector composition differs in frame padding, input column, viewport height, clipping, and cursor position."
    },
    "D09": {
      "kind": "cadr-defect",
      "summary": "The baseline model-scope startup notice is absent when scoped models are configured."
    },
    "D10": {
      "kind": "cadr-defect",
      "summary": "The model selector omits the baseline 'tab scope (all/scoped)' help line."
    },
    "D11": {
      "kind": "cadr-defect",
      "summary": "Displayed directory values retain a trailing slash in footer, trust-parent, and resume-command surfaces."
    },
    "D12": {
      "kind": "cadr-defect",
      "summary": "The trust selector cancel help omits ctrl+c."
    },
    "D14": {
      "kind": "cadr-defect",
      "summary": "Busy-state queue and Working output differ in left padding and Alt+Up key spelling."
    },
    "D15": {
      "kind": "cadr-defect",
      "summary": "Status replacement semantics differ: /reload leaves the preceding /export status visible."
    },
    "D16": {
      "kind": "cadr-defect",
      "summary": "Fatal output is written before clean terminal teardown and overwrites the editor/footer region."
    }
  },
