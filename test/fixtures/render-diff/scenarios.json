      "id": "commands-and-exit",
      "group": "commands",
      "coverage": ["slash-export", "slash-reload", "post-exit-resume"],
      "description": "Local slash-command feedback and stdout after terminal teardown.",
      "setup": {
        "persistentSession": true,
        "seedMessages": [
          { "role": "user", "text": "command question" },
          { "role": "assistant", "text": "command answer" }
        ]
      },
      "responses": [],
      "actions": [
        { "waitFor": "command answer" },
        { "sendText": "/export" }, { "send": "enter" }, { "waitFor": "Session exported to:" }, { "checkpoint": "slash-export" },
        { "sendText": "/reload" }, { "send": "enter" }, { "waitFor": "Reloaded keybindings" }, { "checkpoint": "slash-reload" },
        { "send": "ctrl+d" }, { "waitFor": "To resume this session:" }, { "checkpoint": "post-exit-resume" }
      ]
