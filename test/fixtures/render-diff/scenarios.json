      "responses": [
        { "content": [], "stopReason": "error", "errorMessage": "render transport failed" }
      ],
      "actions": [
        { "waitForHex": "1b5b3f323032366c" },
        { "sendText": "cause provider error" }, { "send": "enter" },
        { "waitFor": "render transport failed" }, { "checkpoint": "provider-error" },
        { "send": "ctrl+d" }
      ]
