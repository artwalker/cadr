    {
      "id": "fatal-crash",
      "group": "errors",
      "coverage": ["fatal-crash"],
      "description": "Product fatal boundary after the terminal has entered interactive mode.",
      "setup": { "crashAfterMs": 900 },
      "expectedExit": 1,
      "responses": [],
      "actions": [
        { "waitForHex": "1b5b3f323032366c" },
        { "waitForSide": { "pi": "render-diff crash sentinel", "cadr": "cadr exiting due to uncaught SIMPLE-ERROR" } },
