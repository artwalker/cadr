(in-package #:cadr-env/tests)
(in-suite cadr-env-suite)

(defun temp-dir (prefix)
  (cadr-env::json-get
   (cadr-env::op-mkdtemp (cadr-env::json-object "prefix" (concatenate 'string "/tmp/" prefix)))
   "path"))

(defun write-text (path text)
  (ensure-directories-exist path)
  (with-open-file (stream path :direction :output :if-exists :supersede :if-does-not-exist :create)
    (write-string text stream)))

(defun decode-records (payload)
  (let ((items nil)
        (start 0))
    (loop while (< start (length payload))
          do (let ((end (position 0 payload :start (1+ start))))
               (push (concatenate 'string
                                  (string (code-char (aref payload start)))
                                  " "
                                  (cadr-env::utf8-string payload :start (1+ start) :end end))
                     items)
               (setf start (1+ end))))
    (nreverse items)))

(defun request (connection op &rest pairs)
  (cadr-env::connection-request connection op (apply #'cadr-env::json-object pairs)))

(test version-and-usage
  (is (equal 0 (cadr-env::daemon-command '("--version")
                                         :stdout (make-string-output-stream)
                                         :stderr (make-string-output-stream))))
  (let ((stdout (make-string-output-stream))
        (stderr (make-string-output-stream)))
    (is (equal 0 (cadr-env::daemon-command '("--version") :stdout stdout :stderr stderr)))
    (is (equal (concatenate 'string (cadr-env::wire-literal :version-name)
                            cadr-env::+package-version+ (string #\Newline))
               (get-output-stream-string stdout))))
  (let ((stderr (make-string-output-stream)))
    (is (equal 2 (cadr-env::daemon-command '("serve") :stderr stderr)))
    (is (equal (concatenate 'string (cadr-env::wire-literal :usage) (string #\Newline))
               (get-output-stream-string stderr)))))

(test node-platform-and-file-errors
  (let ((windows (node-platform "windows" "aarch64"))
        (mac (node-platform "macos" "x86_64")))
    (is (equal "win32" (cadr-env::json-get windows "os")))
    (is (equal "arm64" (cadr-env::json-get windows "arch")))
    (is (equal "darwin" (cadr-env::json-get mac "os")))
    (is (equal "x64" (cadr-env::json-get mac "arch"))))
  (is (equal "not_found" (file-error-code (to-file-error "ENOENT" "missing"))))
  (is (equal "permission_denied" (file-error-code (to-file-error "EPERM" "no"))))
  (is (equal "not_directory" (file-error-code (to-file-error "ENOTDIR" "no"))))
  (is (equal "is_directory" (file-error-code (to-file-error "EISDIR" "no"))))
  (is (equal "invalid" (file-error-code (to-file-error "SYMLINK" "no"))))
  (is (equal "invalid" (file-error-code (to-file-error "NOT_REGULAR" "no"))))
  (is (equal "aborted" (file-error-code (to-file-error "aborted" "aborted"))))
  (is (equal "unknown" (file-error-code (to-file-error "EIO" "io")))))

(test path-resolution
  (let ((info (cadr-env::json-object "home" "/home/user" "cwd" "/work")))
    (is (equal "/home/user" (resolve-remote-path "~" info)))
    (is (equal "/home/user/file" (resolve-remote-path "~/file" info)))
    (is (equal "/tmp/x" (resolve-remote-path "file:///tmp/x" info)))
    (is (equal "file://not a path" (resolve-remote-path "file://not a path" info)))
    (is (equal "/abs" (resolve-remote-path "/abs" info)))
    (is (equal "/work/rel" (resolve-remote-path "rel" info)))))

(test utf8-and-window-and-scan
  (let ((decoder (cadr-env::make-utf8-decoder)))
    (is (equal (format nil "~C~C~C" #\ufffd #\ufeff #\a)
               (cadr-env::utf8-decode decoder #(#xe2 #x82 #xef #xbb #xbf #x61) :last t))))
  (let ((decoder (cadr-env::make-utf8-decoder)))
    (is (equal "" (cadr-env::utf8-decode decoder #(#xef #xbb))))
    (is (equal "a" (cadr-env::utf8-decode decoder #(#xbf #x61) :last t))))
  (let ((decoder (cadr-env::make-utf8-decoder :bom nil)))
    (is (equal (format nil "~C~C~A~C" #\ufffd #\ufffd #\A #\Nul)
               (cadr-env::utf8-decode decoder #(#xff #xfe #x41 #x00) :last t))))
  (let ((decoder (cadr-env::make-utf8-decoder :bom nil)))
    (is (equal (format nil "~CA" #\ufffd)
               (cadr-env::utf8-decode decoder #(#xe2 #x82 #x41) :last t))))
  (let ((decoder (cadr-env::make-utf8-decoder :bom nil)))
    (is (equal (string #\ufffd)
               (cadr-env::utf8-decode decoder #(#xe2 #x82) :last t))))
  (let* ((window (cadr-env::make-output-window :max-bytes 1000 :max-lines 1000
                                               :min-interval-ms 0 :bytes-per-second 1d12))
         (pending (cadr-env::make-pending window)))
    (cadr-env::pending-push pending "stdout" "a")
    (cadr-env::pending-push pending "stderr" "b")
    (cadr-env::pending-push pending "stdout" "c")
    (is (equal '("stdout" "stderr" "stdout")
               (mapcar #'cadr-env::output-event-stream (cadr-env::pending-take pending)))))
  (let* ((bytes (coerce #(#xef #xbb #xbf #x61 #x0a #xe2 #x82 #x0a #x0a #xef #xbb #xbf #x62 #x0a #xc3 #xa9)
                        '(vector (unsigned-byte 8))))
         (scanner (cadr-env::make-line-scan 0 nil)))
    (cadr-env::line-scan-push scanner bytes)
    (let ((result (cadr-env::line-scan-finish scanner)))
      (is (equal 4 (cadr-env::json-get result "newlines")))
      (is (equal 14 (cadr-env::json-get result "selectedBytes")))
      (is (equal 1 (cadr-env::json-get result "firstLineBytes")))))
  (let* ((bytes (coerce #(#xef #xbb #xbf #x61 #x0a #xe2 #x82 #x0a #x0a #xef #xbb #xbf #x62 #x0a #xc3 #xa9)
                        '(vector (unsigned-byte 8))))
         (scanner (cadr-env::make-line-scan 1 3)))
    (cadr-env::line-scan-push scanner bytes)
    (let ((result (cadr-env::line-scan-finish scanner)))
      (is (equal 5 (cadr-env::json-get result "start")))
      (is (equal 8 (cadr-env::json-get result "end"))))))

(test output-window-keeps-the-tail-after-a-skip
  (let* ((window (cadr-env::make-output-window :max-bytes 10 :max-lines 2
                                               :min-interval-ms 0 :bytes-per-second 1d12))
         (pending (cadr-env::make-pending window))
         (full "")
         (events nil))
    (dotimes (index 500)
      (let ((text (format nil "line ~D é😀~%" index)))
        (setf full (concatenate 'string full text))
        (cadr-env::pending-push pending
                                (if (zerop (mod index 7)) "stderr" "stdout")
                                text)
        (when (= (mod index 50) 49)
          (setf events (append events (cadr-env::pending-take pending))))))
    (setf events (append events (cadr-env::pending-take pending)))
    (let ((bytes 0)
          (newlines 0)
          (after ""))
      (dolist (event events)
        (let ((skipped (cadr-env::output-event-skipped event)))
          (when skipped
            (incf bytes (cadr-env::json-get skipped "bytes"))
            (incf newlines (cadr-env::json-get skipped "newlines"))
            (setf after "")))
        (incf bytes (length (cadr-env::utf8-bytes (cadr-env::output-event-text event))))
        (incf newlines (count #\Newline (cadr-env::output-event-text event)))
        (setf after (concatenate 'string after (cadr-env::output-event-text event))))
      (is (equal (length (cadr-env::utf8-bytes full)) bytes))
      (is (equal (count #\Newline full) newlines))
      (is (and (>= (length full) (length after))
               (string= full after :start1 (- (length full) (length after)))))
      (is (or (> (length (cadr-env::utf8-bytes after)) 10)
              (> (count #\Newline after) 2)))
      (is (some #'cadr-env::output-event-skipped events)))))

(test silence-constants
  (is (equal 5 cadr-env::+ping-seconds+))
  (is (equal 30 cadr-env::+silence-seconds+))
  (is (cadr-env::silence-exceeded-p 0 (1+ (* 30 internal-time-units-per-second))))
  (is (not (cadr-env::silence-exceeded-p 0 (* 30 internal-time-units-per-second)))))

(test ssh-arguments-and-host-keys
  (let ((args (ssh-arguments (list :host "example" :host-key-alias "alias"
                                   :known-hosts-file "/tmp/known" :user "me" :port 2222
                                   :identity-file "/tmp/id" :config-file "/tmp/ssh-config"))))
    (is (equal "-F" (first args)))
    (is (equal "/tmp/ssh-config" (second args)))
    (is (equal '("-T" "-a" "-x") (subseq args 2 5)))
    (is (find "BatchMode=yes" args :test #'equal))
    (is (find "StrictHostKeyChecking=yes" args :test #'equal))
    (is (find "HostKeyAlias=alias" args :test #'equal))
    (is (equal "example" (car (last args))))
    (is (equal "--" (car (last args 2)))))
  (is (equal '("-T" "-a" "-x")
             (subseq (ssh-arguments (list :host "example" :host-key-alias "alias"
                                          :known-hosts-file "/tmp/known"))
                     0 3)))
  (signals error (ssh-arguments (list :host "example" :host-key-alias "alias"
                                      :known-hosts-file "/tmp/known" :port 0)))
  (let* ((dir (temp-dir "hosts-"))
         (file (concatenate 'string dir "/known_hosts"))
         (target (list :host "example" :host-key-alias "alias" :known-hosts-file file))
         (line "alias ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyForTests"))
    (accept-host-key target (list line))
    (accept-host-key target (list line))
    (is (equal (concatenate 'string line (string #\Newline))
               (cadr-env::read-text-file file)))
    (signals error (accept-host-key target (list "other ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyForTests")))
    (signals error (accept-host-key target (list "@cert-authority alias ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyForTests")))
    (signals error (accept-host-key target (list "alias ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDifferentKeyForTests")))
    (forget-host-key target)
    (accept-host-key target (list "alias ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDifferentKeyForTests"))
    (is (equal (concatenate 'string "alias ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDifferentKeyForTests"
                            (string #\Newline))
               (cadr-env::read-text-file file))))
  (is (equal "/home/user/.pi/mobile/tools/pi-env-0123456789abcdef0123456789abcdef"
             (deploy-daemon-path "/home/user" "0123456789abcdef0123456789abcdefDEAD")))
  (is (search (posix-hash-program) (posix-hash-program)))
  (is (equal (probe-banner) "PI-ENV-PROBE")))

(test daemon-filesystem-and-listing
  (let ((connection (make-pipe-connection))
        (root (temp-dir "list-")))
    (unwind-protect
         (progn
           (let ((hello (connection-info connection)))
             (is (equal 1 (cadr-env::json-get hello "protocol")))
             (is (equal "1.4.0" (cadr-env::json-get hello "version")))
             (is (equal "linux" (cadr-env::json-get hello "os")))
             (is (find "listFiles" (cadr-env::json-get hello "features") :test #'equal)))
           (write-text (concatenate 'string root "/b.txt") "b")
           (write-text (concatenate 'string root "/a/z.txt") "z")
           (write-text (concatenate 'string root "/a/b/c.txt") "c")
           (ensure-directories-exist (concatenate 'string root "/empty/"))
           (write-text (concatenate 'string root "/.hidden/x") "x")
           (write-text (concatenate 'string root "/A.txt") "A")
           (multiple-value-bind (json payload)
               (request connection "listFiles" "path" root)
             (is (equal '("d .hidden" "f .hidden/x" "f A.txt" "d a" "d a/b" "f a/b/c.txt"
                          "f a/z.txt" "f b.txt" "d empty")
                        (decode-records payload)))
             (is (not (cadr-env::json-get json "truncated"))))
           (multiple-value-bind (json payload)
               (request connection "listFiles" "path" root "hidden" nil)
             (declare (ignore json))
             (is (not (find ".hidden" (decode-records payload) :test #'search))))
           (let ((missing (handler-case (request connection "listFiles" "path"
                                                 (concatenate 'string root "/missing"))
                            (env-failure (condition) condition))))
             (is (equal "ENOENT" (env-failure-code missing))))
           (let ((file (handler-case (request connection "listFiles" "path"
                                              (concatenate 'string root "/b.txt"))
                         (env-failure (condition) condition))))
             (is (equal "ENOTDIR" (env-failure-code file)))
             (is (search "scandir" (env-failure-message file))))
           (request connection "mkdir" "path" (concatenate 'string root "/nested/dir"))
           (is (equal "directory"
                      (cadr-env::json-get (request connection "lstat" "path"
                                                   (concatenate 'string root "/nested/dir"))
                                          "kind")))
           (let ((exists (handler-case (request connection "mkdir" "path"
                                                (concatenate 'string root "/b.txt"))
                           (env-failure (condition) condition))))
             (is (equal "EEXIST" (env-failure-code exists))))
           (let ((directory (handler-case (request connection "rm" "path"
                                                   (concatenate 'string root "/nested"))
                              (env-failure (condition) condition))))
             (is (equal "ERR_FS_EISDIR" (env-failure-code directory)))
             (is (search "Path is a directory: rm returned EISDIR"
                         (env-failure-message directory))))
           (let ((fsync (handler-case (request connection "fsync" "path" root)
                          (env-failure (condition) condition))))
             (is (equal "EISDIR" (env-failure-code fsync)))
             (is (equal (format nil "EISDIR: illegal operation on a directory, open '~A'" root)
                        (env-failure-message fsync)))))
      (connection-close connection))))

(test gitignore-and-bounds-and-symlinks
  (let ((connection (make-pipe-connection))
        (root (temp-dir "git-"))
        (home (temp-dir "home-"))
        (saved (sb-ext:posix-getenv "HOME")))
    (unwind-protect
         (progn
           (sb-posix:setenv "HOME" home 1)
           (write-text (concatenate 'string root "/keep.txt") "k")
           (write-text (concatenate 'string root "/out/x.js") "x")
           (write-text (concatenate 'string root "/sub/keep.txt") "k")
           (write-text (concatenate 'string root "/sub/drop.log") "d")
           (write-text (concatenate 'string root "/node_modules/m/i.js") "i")
           (multiple-value-bind (json payload)
               (request connection "listFiles" "path" root "hidden" nil)
             (declare (ignore json))
             (is (find "f out/x.js" (decode-records payload) :test #'equal)))
           (write-text (concatenate 'string root "/.gitignore") (format nil "out/~%*.log~%"))
           (write-text (concatenate 'string root "/sub/.gitignore") (format nil "!keep.txt~%"))
           (ensure-directories-exist (concatenate 'string root "/.git/info/"))
           (write-text (concatenate 'string root "/.git/HEAD") "ref: refs/heads/main")
           (write-text (concatenate 'string root "/.git/info/exclude") (format nil "keep.txt~%"))
           (multiple-value-bind (json payload)
               (request connection "listFiles" "path" root
                        "exclude" (cadr-env::json-array "node_modules"))
             (declare (ignore json))
             (is (equal '("f .gitignore" "d sub" "f sub/.gitignore" "f sub/keep.txt")
                        (decode-records payload))))
           (multiple-value-bind (json payload)
               (request connection "listFiles" "path" root "gitignore" nil
                        "exclude" (cadr-env::json-array "node_modules"))
             (declare (ignore json))
             (is (find "f out/x.js" (decode-records payload) :test #'equal))
             (is (not (find ".git/" (decode-records payload) :test #'search))))
           (multiple-value-bind (json payload)
               (request connection "listFiles" "path" (concatenate 'string root "/sub"))
             (declare (ignore json))
             (is (equalp payload
                         (concatenate '(vector (unsigned-byte 8))
                                      #(102) (cadr-env::utf8-bytes ".gitignore") #(0)
                                      #(102) (cadr-env::utf8-bytes "keep.txt") #(0)))))
           (let ((linked (temp-dir "link-")))
             (write-text (concatenate 'string linked "/dir/inner.txt") "i")
             (sb-posix:symlink "dir" (concatenate 'string linked "/link"))
             (sb-posix:symlink "missing" (concatenate 'string linked "/dangling"))
             (sb-posix:symlink linked (concatenate 'string linked "/dir/loop"))
             (multiple-value-bind (json payload)
                 (request connection "listFiles" "path" linked "hidden" nil "gitignore" nil)
               (declare (ignore json))
               (is (equal '("l dangling" "d dir" "f dir/inner.txt" "l dir/loop" "l link")
                          (decode-records payload)))))
           (let ((bounded (temp-dir "bound-")))
             (write-text (concatenate 'string bounded "/a") "a")
             (write-text (concatenate 'string bounded "/b") "b")
             (write-text (concatenate 'string bounded "/c") "c")
             (multiple-value-bind (json payload)
                 (request connection "listFiles" "path" bounded "maxEntries" 2 "hidden" nil)
               (is (cadr-env::json-get json "truncated"))
               (is (equal 2 (length (decode-records payload)))))
             (multiple-value-bind (json payload)
                 (request connection "listFiles" "path" bounded "maxEntries" 3 "hidden" nil)
               (is (not (cadr-env::json-get json "truncated")))
               (is (equal '("f a" "f b" "f c") (decode-records payload))))
             (multiple-value-bind (json payload)
                 (request connection "listFiles" "path" bounded "maxEntries" 0 "hidden" nil)
               (is (cadr-env::json-get json "truncated"))
               (is (equal nil (decode-records payload))))
             (multiple-value-bind (json payload)
                 (request connection "listFiles" "path" bounded "maxBytes" 6 "hidden" nil)
               (is (cadr-env::json-get json "truncated"))
               (is (equal '("f a" "f b") (decode-records payload))))
             (multiple-value-bind (json payload)
                 (request connection "listFiles" "path" bounded "timeoutMs" 0 "hidden" nil)
               (is (cadr-env::json-get json "truncated"))
               (is (equal nil (decode-records payload))))))
      (when saved (sb-posix:setenv "HOME" saved 1))
      (connection-close connection))))

(test exec-and-pty-and-watch
  (let ((connection (make-pipe-connection))
        (root (temp-dir "exec-")))
    (unwind-protect
         (progn
           (let ((result (request connection "exec" "command" "exit 3" "cwd" root)))
             (is (equal 3 (cadr-env::json-get result "exitCode"))))
           (let ((empty (handler-case
                            (request connection "exec" "argv" (cadr-env::json-array) "cwd" root)
                          (env-failure (condition) condition))))
             (is (equal "spawn_error" (env-failure-code empty)))
             (is (equal "Empty argv: no program to run" (env-failure-message empty))))
           (let ((missing (handler-case
                              (request connection "exec" "command" "true" "cwd" (concatenate 'string root "/nope"))
                            (env-failure (condition) condition))))
             (is (search "Working directory does not exist" (env-failure-message missing))))
           (let ((shell (handler-case
                            (request connection "exec" "command" "true" "cwd" root
                                     "shellPath" (concatenate 'string root "/no-shell"))
                          (env-failure (condition) condition))))
             (is (equal "shell_unavailable" (env-failure-code shell)))
             (is (search "Custom shell path not found" (env-failure-message shell))))
           (let* ((box (list nil))
                  (worker (sb-thread:make-thread
                           (lambda ()
                             (loop until (car box) do (sleep 0.01))
                             (sleep 0.2)
                             (connection-cancel connection (car box) :kill t)))))
             (let ((result (cadr-env::connection-request
                            connection "exec"
                            (cadr-env::json-object "command" "sleep 30" "cwd" root)
                            #() box)))
               (is (equal 137 (cadr-env::json-get result "exitCode"))))
             (sb-thread:join-thread worker))
           (let ((saved cadr-env::*host-os*))
             (unwind-protect
                  (progn
                    (setf cadr-env::*host-os* "windows")
                    (let ((refused (handler-case (request connection "pty" "cwd" root "cols" 80 "rows" 24)
                                     (env-failure (condition) condition))))
                      (is (equal "ENOTSUP" (env-failure-code refused)))
                      (is (equal "Terminals are not supported on this system yet"
                                 (env-failure-message refused)))))
               (setf cadr-env::*host-os* saved)))
           (let ((missing (handler-case
                              (request connection "pty" "cwd" (concatenate 'string root "/no-pty")
                                       "cols" 80 "rows" 24
                                       "argv" (cadr-env::json-array "/bin/sh" "-c" "exit 0"))
                            (env-failure (condition) condition))))
             (is (search "Working directory does not exist" (env-failure-message missing))))
           (let ((missing-terminal (handler-case
                                       (request connection "ptyWrite" "target" 999)
                                     (env-failure (condition) condition))))
             (is (equal "EBADF" (env-failure-code missing-terminal))))
           (let ((result (request connection "pty" "cwd" root "cols" 80 "rows" 24
                                  "argv" (cadr-env::json-array "/bin/sh" "-c" "exit 3"))))
             (is (equal 3 (cadr-env::json-get result "exitCode"))))
           (let* ((box (list nil))
                  (worker (sb-thread:make-thread
                           (lambda ()
                             (loop until (car box) do (sleep 0.01))
                             (sleep 0.2)
                             (connection-cancel connection (car box))))))
             (let ((closed (handler-case
                               (cadr-env::connection-request
                                connection "pty"
                                (cadr-env::json-object "cwd" root "cols" 80 "rows" 24
                                                       "argv" (cadr-env::json-array "sleep" "100"))
                                #() box)
                             (env-failure (condition) condition))))
               (is (equal "aborted" (env-failure-code closed))))
             (sb-thread:join-thread worker))
           (multiple-value-bind (result payload events)
               (cadr-env::connection-request
                connection "pty"
                (cadr-env::json-object "cwd" root "cols" 80 "rows" 24
                                       "argv" (cadr-env::json-array "/bin/sh" "-c" "printf '\\141\\377\\142'")))
             (declare (ignore result payload))
             (let ((output (apply #'concatenate '(vector (unsigned-byte 8))
                                  (loop for event in events
                                        when (equal (cadr-env::json-get (car event) "kind") "output")
                                          collect (cdr event)))))
               (is (equalp #(#x61 #xff #x62) output))))
           (let* ((box (list nil))
                  (watched (concatenate 'string root "/watched")))
             (ensure-directories-exist (concatenate 'string watched "/"))
             (sb-thread:make-thread
              (lambda ()
                (loop until (car box) do (sleep 0.01))
                (sleep 0.3)
                (write-text (concatenate 'string watched "/new.txt") "n")
                (sleep 0.4)
                (connection-cancel connection (car box))))
             (multiple-value-bind (result payload events)
                 (cadr-env::connection-request
                  connection "watch"
                  (cadr-env::json-object
                   "targets" (cadr-env::json-array
                              (cadr-env::json-object "path" watched "recursive" t)))
                  #() box)
               (declare (ignore result payload))
               (is (equal "native"
                          (cadr-env::json-get (car (find "ready" events
                                                        :key (lambda (event)
                                                               (cadr-env::json-get (car event) "kind"))
                                                        :test #'equal))
                                             "mode")))
               (is (some (lambda (event)
                           (let ((paths (cadr-env::json-get (car event) "paths")))
                             (and (cadr-env::json-array-p paths)
                                  (find (concatenate 'string watched "/new.txt") paths :test #'equal))))
                         events)))))
      (connection-close connection))))

(test unsupported-listing
  (let ((connection (cadr-env::make-connection)))
    (setf (connection-info connection) (cadr-env::json-object "features" (cadr-env::json-array)))
    (let ((failure (handler-case (list-files-over connection (cadr-env::json-object "path" "/tmp"))
                     (env-failure (condition) condition))))
      (is (equal "not_supported" (env-failure-code failure)))
      (is (equal (cadr-env::wire-literal :list-unsupported) (env-failure-message failure))))))

(defun request-then-cancel (connection op json)
  (let ((box (cadr-env::make-mailbox))
        (id (incf (cadr-env::connection-next-id connection))))
    (cadr-env::json-put json "op" op)
    (setf (gethash id (cadr-env::connection-pending connection)) box)
    (sb-thread:with-mutex ((cadr-env::connection-lock connection))
      (cadr-env::write-frame (cadr-env::connection-output connection)
                             (cadr-env::make-frame cadr-env::+request+ id json))
      (cadr-env::write-frame (cadr-env::connection-output connection)
                             (cadr-env::make-frame cadr-env::+cancel+ id
                                                   (cadr-env::json-object))))
    (sb-thread:with-mutex ((cadr-env::mailbox-lock box))
      (loop until (cadr-env::mailbox-done box)
            do (sb-thread:condition-wait (cadr-env::mailbox-wait box)
                                         (cadr-env::mailbox-lock box))))
    (remhash id (cadr-env::connection-pending connection))
    (cadr-env::mailbox-failure box)))

(test list-files-cancel-star-and-symlink-root
  (is (cadr-env::glob-segment "sub/*.log" "sub/y.log"))
  (is (not (cadr-env::glob-segment "sub/*.log" "sub/a/x.log")))
  (is (not (cadr-env::glob-segment "sub/*.log" "other.log")))
  (is (cadr-env::glob-segment "sub/*" "sub/a"))
  (is (not (cadr-env::glob-segment "sub/*" "sub/a/x.log")))
  (is (cadr-env::glob-segment "sub/**/x.log" "sub/x.log"))
  (is (cadr-env::glob-segment "sub/**/x.log" "sub/a/x.log"))
  (is (cadr-env::glob-segment "sub/**/x.log" "sub/a/b/x.log"))
  (is (not (cadr-env::glob-segment "sub/**/x.log" "sub/y.log")))
  (is (cadr-env::glob-segment "/*.log" "other.log"))
  (is (not (cadr-env::glob-segment "/*.log" "sub/y.log")))
  (is (cadr-env::glob-segment "sub/?.log" "sub/y.log"))
  (is (not (cadr-env::glob-segment "sub/?.log" "sub/yy.log")))
  (let ((connection (make-pipe-connection))
        (root (temp-dir "star-")))
    (unwind-protect
         (progn
           (write-text (concatenate 'string root "/.git/HEAD") "ref: refs/heads/main")
           (write-text (concatenate 'string root "/.gitignore") "sub/*.log")
           (write-text (concatenate 'string root "/sub/y.log") "y")
           (write-text (concatenate 'string root "/sub/a/x.log") "x")
           (write-text (concatenate 'string root "/sub/a/keep.txt") "k")
           (multiple-value-bind (json payload)
               (request connection "listFiles" "path" root "gitignore" t)
             (declare (ignore json))
             (let ((records (decode-records payload)))
               (is (find "f sub/a/x.log" records :test #'equal))
               (is (find "f sub/a/keep.txt" records :test #'equal))
               (is (not (find "f sub/y.log" records :test #'equal)))))
           (let* ((linked (temp-dir "rootlink-"))
                  (link (concatenate 'string linked "/link"))
                  (file-link (concatenate 'string linked "/file")))
             (write-text (concatenate 'string linked "/dir/inner.txt") "i")
             (sb-posix:symlink ".." (concatenate 'string linked "/dir/loop"))
             (sb-posix:symlink "dir" link)
             (sb-posix:symlink "dir/inner.txt" file-link)
             (multiple-value-bind (json payload)
                 (request connection "listFiles" "path" link "hidden" nil "gitignore" nil)
               (declare (ignore json))
               (is (equal '("f inner.txt" "l loop") (decode-records payload))))
             (let ((file (handler-case (request connection "listFiles" "path" file-link)
                           (env-failure (condition) condition))))
               (is (equal "ENOTDIR" (env-failure-code file)))
               (is (search "scandir" (env-failure-message file)))))
           (let ((wide (temp-dir "cancel-")))
             (dotimes (dir 40)
               (dotimes (file 30)
                 (write-text (format nil "~A/d~D/f~D" wide dir file) "")))
             (let ((failure (request-then-cancel connection "listFiles"
                                                 (cadr-env::json-object "path" wide))))
               (is (equal "aborted" (cadr-env::json-get failure "code")))
               (is (equal "aborted" (cadr-env::json-get failure "message"))))
             (multiple-value-bind (json payload)
                 (request connection "listFiles" "path" wide "hidden" nil "gitignore" nil)
               (is (not (cadr-env::json-get json "truncated")))
               (is (equal 1240 (length (decode-records payload))))))
           (let* ((scanned (concatenate 'string root "/lines.txt"))
                  (opened nil))
             (with-open-file (stream scanned :direction :output :if-exists :supersede
                                              :if-does-not-exist :create
                                              :element-type '(unsigned-byte 8))
               (let ((line (make-array 64 :element-type '(unsigned-byte 8) :initial-element 120)))
                 (setf (aref line 63) 10)
                 (dotimes (i 20000)
                   (write-sequence line stream))))
             (setf opened (request connection "open" "path" scanned "mode" "read"))
             (let ((failure (request-then-cancel
                             connection "scanLines"
                             (cadr-env::json-object "handle" (cadr-env::json-get opened "handle")
                                                    "startLine" 0))))
               (is (equal "aborted" (cadr-env::json-get failure "code")))
               (is (equal "aborted" (cadr-env::json-get failure "message"))))))
      (connection-close connection)))
  (let ((connection (make-pipe-connection)))
    (unwind-protect
         (progn
           (dolist (pair '(("maxEntries" -1)
                           ("maxBytes" 3/2)
                           ("timeoutMs" 9007199254740992)))
             (let ((failure (handler-case
                                (list-files-over connection
                                                 (cadr-env::json-object "path" "/tmp"
                                                                        (first pair) (second pair)))
                              (env-failure (condition) condition))))
               (is (equal "invalid" (env-failure-code failure)))
               (is (equal (format nil "~A must be a non-negative safe integer" (first pair))
                          (env-failure-message failure)))
               (is (equal "/tmp" (env-failure-path failure)))))
           (setf (connection-info connection)
                 (cadr-env::json-object "features" (cadr-env::json-array)))
           (let ((failure (handler-case
                              (list-files-over connection
                                               (cadr-env::json-object "path" "/tmp" "maxEntries" -1))
                            (env-failure (condition) condition))))
             (is (equal "invalid" (env-failure-code failure)))))
      (connection-close connection))))

(test production-env-joins-go-through-cadr-core
  (let ((root (asdf:system-source-directory "cadr-env")))
    (dolist (relative '("src/cadr-env/client.lisp"
                        "src/cadr-env/daemon.lisp"
                        "src/cadr-env/process.lisp"))
      (let ((source (uiop:read-file-string (merge-pathnames relative root))))
        (is (not (search "sb-thread:join-thread" source))
            "~A calls sb-thread:join-thread directly" relative)
        (is (or (search "cadr-core:join-active-thread" source)
                (search "cadr-core:stop-thread-for-cleanup" source))
            "~A does not join through cadr-core" relative)))))
