           (let ((reader (remote-open-binary-reader env "lines.txt")))
             (is (env-ok-p reader))
             (let ((full (remote-reader-scan-lines (env-ok-value reader) :start-line 0))
                   (middle (remote-reader-scan-lines (env-ok-value reader) :start-line 1 :end-line 3))
                   (past (remote-reader-scan-lines (env-ok-value reader) :start-line 9)))
               (is (eql 4 (cadr-env::json-get (env-ok-value full) "newlines")))
               (is (eql 14 (cadr-env::json-get (env-ok-value full) "selectedBytes")))
               (is (eql 1 (cadr-env::json-get (env-ok-value full) "firstLineBytes")))
               (is (eql 5 (cadr-env::json-get (env-ok-value middle) "start")))
               (is (eql 8 (cadr-env::json-get (env-ok-value middle) "end")))
