           (let ((changes (list nil))
                 (lock (sb-thread:make-mutex)))
             (let ((watcher (remote-watch env '((:path "watched.txt"))
                                          (lambda (change)
                                            (sb-thread:with-mutex (lock)
                                              (push change (car changes))))
                                          :poll-interval-ms 100)))
               (is (env-ok-p watcher))
               (is (member (remote-watcher-mode (env-ok-value watcher)) '("native" "polling") :test #'equal))
               (is (env-ok-p (remote-write-file env "watched.txt" "x")))
               (is (wait-for-path changes (env-ok-value (remote-absolute-path env "watched.txt")) lock))
               (remote-watcher-close (env-ok-value watcher))
               (remote-watcher-close (env-ok-value watcher))
               (let ((after (length (car changes))))
                 (is (env-ok-p (remote-write-file env "watched.txt" "y")))
                 (sleep 0.3)
                 (is (eql after (length (car changes)))))))
           (is (env-ok-p (remote-create-dir env "skills")))
