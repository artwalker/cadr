           (is (env-ok-p (remote-write-file env "lines.txt"
                                            (coerce #(#xef #xbb #xbf #x61 #x0a #xe2 #x82 #x0a #x0a
                                                      #xef #xbb #xbf #x62 #x0a #xc3 #xa9)
                                                    '(vector (unsigned-byte 8))))))
           (is (equal (format nil "a~%~C~%~%~Cb~%é" #\ufffd #\ufeff)
