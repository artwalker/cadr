               (let ((hidden (list (env-ok-value (remote-absolute-path env "skills/node_modules"))
                                   (env-ok-value (remote-absolute-path env "skills/.SKILL.md.tmp"))))
                     (seen (sb-thread:with-mutex (lock) (copy-list (car changes)))))
                 (dolist (change seen)
                   (dolist (path (getf change :paths))
                     (is (not (some (lambda (excluded)
                                      (or (equal path excluded)
                                          (and (< (length excluded) (length path))
                                               (string= excluded path :end2 (length excluded)))))
                                    hidden))))))
               (remote-watcher-close (env-ok-value watcher))))
           (let* ((box (list nil))
                  (thread (sb-thread:make-thread
                           (lambda () (setf (car box) (remote-exec env '("sleep" "30"))))
                           :name "env-cleanup-exec")))
             (sleep 0.4)
             (remote-cleanup env)
             (is (sb-thread:join-thread thread :timeout 5))
             (is (env-ok-p (car box)))
             (is (eql 137 (env-ok-value (car box))))))
      (spawn-close connection))))
