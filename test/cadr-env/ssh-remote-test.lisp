           (is (equal (concatenate 'string root "/rel")
                      (env-ok-value (remote-absolute-path env "rel"))))
           (let ((over (remote-exec env (list "sh" "-c" (format nil "touch ~A/ran" root))
                                    :timeout 3000000)))
             (is (env-err-p over))
             (is (equal "timeout" (env-err-code over)))
             (is (equal "Invalid timeout: maximum is 2147483.647 seconds" (env-err-message over)))
             (is (not (probe-file (concatenate 'string root "/ran")))))
           (is (env-ok-p (remote-write-file env "data.txt" "hello world")))
