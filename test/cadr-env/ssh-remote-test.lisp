(in-package #:cadr-env/tests)
(in-suite cadr-env-suite)

(defun write-text-file (path text)
  (ensure-directories-exist path)
  (with-open-file (stream path :direction :output :if-exists :supersede :if-does-not-exist :create)
    (write-string text stream)))

(defun read-text-file (path)
  (with-open-file (stream path)
    (let ((data (make-string (file-length stream))))
      (read-sequence data stream)
      data)))

(defun shell-quote (text)
  (with-output-to-string (out)
    (write-char #\' out)
    (loop for character across text
          do (if (char= character #\')
                 (write-string "'\\''" out)
                 (write-char character out)))
    (write-char #\' out)))

(defun sbcl-executable ()
  (let ((argv0 (first (uiop:raw-command-line-arguments))))
    (if (find #\/ argv0)
        argv0
        (string-right-trim '(#\Newline #\Return)
                           (uiop:run-program (list "sh" "-c" (format nil "command -v ~A" argv0))
                                             :output :string)))))

(defun write-daemon-launcher (path)
  (let ((sbcl (sbcl-executable))
        (core (namestring (asdf:system-source-file "cadr-core")))
        (asd (namestring (asdf:system-source-file "cadr-env")))
        (translations (or (uiop:getenv "ASDF_OUTPUT_TRANSLATIONS") ""))
        (cache (or (uiop:getenv "XDG_CACHE_HOME") "")))
    (with-open-file (stream path :direction :output :if-exists :supersede :if-does-not-exist :create)
      (format stream "#!/bin/sh~%")
      (unless (equal translations "")
        (format stream "export ASDF_OUTPUT_TRANSLATIONS=~A~%" (shell-quote translations)))
      (unless (equal cache "")
        (format stream "export XDG_CACHE_HOME=~A~%" (shell-quote cache)))
      (format stream "exec ~A --noinform --disable-debugger --no-userinit --non-interactive \\~%"
              (shell-quote sbcl))
      (format stream "  --eval '(require :asdf)' \\~%")
      (format stream "  --eval '(asdf:load-asd ~S)' \\~%" core)
      (format stream "  --eval '(asdf:load-asd ~S)' \\~%" asd)
      (format stream "  --eval '(asdf:load-system \"cadr-env\")' \\~%")
      (write-string "  --eval \"(cadr-env:daemon-stdio (list \\\"$1\\\" \\\"$2\\\" \\\"$3\\\"))\"" stream)
      (terpri stream))
    (sb-posix:chmod path #o755)
    path))

(defun write-old-daemon (path launcher)
  (with-open-file (stream path :direction :output :if-exists :supersede :if-does-not-exist :create)
    (format stream "#!/bin/sh~%export CADR_ENV_OMIT_LIST_FILES=1~%exec ~A \"$@\"~%"
            (shell-quote launcher)))
  (sb-posix:chmod path #o755)
  path)

(defun free-tcp-port ()
  (require :sb-bsd-sockets)
  (let ((socket (make-instance 'sb-bsd-sockets:inet-socket :type :stream :protocol :tcp)))
    (unwind-protect
         (progn
           (sb-bsd-sockets:socket-bind socket #(127 0 0 1) 0)
           (sb-bsd-sockets:socket-listen socket 1)
           (nth-value 1 (sb-bsd-sockets:socket-name socket)))
      (sb-bsd-sockets:socket-close socket))))

(defun port-open-p (port)
  (require :sb-bsd-sockets)
  (let ((socket (make-instance 'sb-bsd-sockets:inet-socket :type :stream :protocol :tcp)))
    (handler-case
        (progn
          (sb-bsd-sockets:socket-connect socket #(127 0 0 1) port)
          (sb-bsd-sockets:socket-close socket)
          t)
      (error ()
        (ignore-errors (sb-bsd-sockets:socket-close socket))
        nil))))

(defun wait-for-port (port)
  (loop repeat 100
        do (when (port-open-p port) (return-from wait-for-port t))
           (sleep 0.05))
  (error "sshd did not start"))

(defun current-user ()
  (sb-posix:passwd-name (sb-posix:getpwuid (sb-posix:getuid))))

(defun run-keygen (path)
  (uiop:run-program (list "ssh-keygen" "-q" "-t" "ed25519" "-N" "" "-f" path)
                    :output nil :error-output nil))

(defun key-material (pub-path)
  (let ((parts (loop for start = 0 then (1+ end)
                     for line = (read-text-file pub-path)
                     for end = (position #\Space line :start start)
                     collect (subseq line start (or end (length line)))
                     while end)))
    (format nil "~A ~A" (first parts) (second parts))))

(defun fingerprint (pub-path)
  (let ((text (uiop:run-program (list "ssh-keygen" "-lf" pub-path) :output :string)))
    (second (loop for start = 0 then (1+ end)
                  for end = (position #\Space text :start start)
                  collect (subseq text start (or end (length text)))
                  while end))))

(defun entry-pair (entry)
  (list (getf entry :kind) (getf entry :path)))

(test ssh-percent-in-a-config-path-is-literal
  (let ((args (ssh-arguments (list :host "example" :host-key-alias "alias"
                                   :known-hosts-file "/tmp/a%b"))))
    (is (find "UserKnownHostsFile=\"/tmp/a%%b\"" args :test #'equal))))

(test remote-node-platform-names-match-v140
  (let ((windows (node-platform "windows" "aarch64"))
        (mac (node-platform "macos" "x86_64")))
    (is (equal "win32" (cadr-env::json-get windows "os")))
    (is (equal "arm64" (cadr-env::json-get windows "arch")))
    (is (equal "darwin" (cadr-env::json-get mac "os")))
    (is (equal "x64" (cadr-env::json-get mac "arch")))))

(test remote-env-matches-v140-over-the-lisp-daemon
  (let* ((root (cadr-env::temp-dir "pi-env-remote-"))
         (launcher (write-daemon-launcher (concatenate 'string root "/pi-env")))
         (connection (make-spawn-connection :command (list launcher)))
         (env (make-remote-env :connection connection :id "pi-env:test" :cwd root)))
    (unwind-protect
         (progn
           (let ((info (spawn-info connection)))
             (is (equal "linux" (cadr-env::json-get (node-platform (cadr-env::json-get info "os")
                                                                  (cadr-env::json-get info "arch"))
                                                   "os")))
             (is (find "listFiles" (cadr-env::json-get info "features") :test #'equal)))
           (let* ((old (write-old-daemon (concatenate 'string root "/old-pi-env") launcher))
                  (old-connection (make-spawn-connection :command (list old)))
                  (old-env (make-remote-env :connection old-connection :id "pi-env:old" :cwd root)))
             (unwind-protect
                  (let ((listed (remote-list-files old-env ".")))
                    (is (env-err-p listed))
                    (is (equal "not_supported" (env-err-code listed))))
               (spawn-close old-connection)))
           (let* ((starts 0)
                  (retry (make-spawn-connection
                          :command (lambda ()
                                     (incf starts)
                                     (if (= starts 1)
                                         (error "ssh gpu-box failed: Network is unreachable")
                                         (list launcher))))))
             (unwind-protect
                  (let* ((retry-env (make-remote-env :connection retry :id "pi-env:test" :cwd root))
                         (offline (remote-read-text-file retry-env "missing.txt"))
                         (command (remote-exec retry-env '("sh" "-c" "exit 0"))))
                    (is (env-err-p offline))
                    (is (equal "unknown" (env-err-code offline)))
                    (is (equal "ssh gpu-box failed: Network is unreachable" (env-err-message offline)))
                    (is (env-ok-p command))
                    (is (eql 0 (env-ok-value command)))
                    (is (eql 2 starts)))
               (spawn-close retry)))
           (let* ((content (make-array 3500017 :element-type '(unsigned-byte 8)))
                  (written (progn
                             (loop for index below (length content)
                                   do (setf (aref content index) (mod (* index 7919) 251)))
                             (remote-write-file env "big.bin" content)))
                  (appended (remote-append-file env "big.bin" content))
                  (read (remote-read-binary-file env "big.bin")))
             (is (env-ok-p written))
             (is (env-ok-p appended))
             (is (env-ok-p read))
             (is (eql (* 2 (length content)) (length (env-ok-value read))))
             (is (equalp content (subseq (env-ok-value read) 0 (length content))))
             (is (equalp content (subseq (env-ok-value read) (length content))))
             (let ((reader (remote-open-binary-reader env "big.bin")))
               (is (env-ok-p reader))
               (let ((range (remote-reader-read (env-ok-value reader) 1000003 2000000)))
                 (remote-reader-close (env-ok-value reader))
                 (is (env-ok-p range))
                 (is (equalp (subseq (env-ok-value read) 1000003 3000003) (env-ok-value range))))))
           (let ((delivered 0)
                 (skipped 0)
                 (tail "")
                 (total 5000000))
             (let ((result (remote-exec env '("sh" "-c" "yes 0123456789abcdef | head -c 5000000")
                                        :window '(:max-bytes 1000 :max-lines 20
                                                  :min-interval-ms 20 :bytes-per-second 1000000)
                                        :on-output (lambda (text info)
                                                     (incf delivered (length (cadr-env::utf8-bytes text)))
                                                     (let ((skipped-json (cadr-env::json-get info "skipped")))
                                                       (when (cadr-env::json-object-p skipped-json)
                                                         (incf skipped (cadr-env::json-get skipped-json "bytes"))
                                                         (setf tail "")))
                                                     (setf tail (concatenate 'string tail text))))))
               (is (env-ok-p result))
               (is (eql 0 (env-ok-value result)))
               (is (eql total (+ delivered skipped)))
               (is (> skipped 0))
               (is (< delivered (/ total 10)))
               (let ((full (subseq (with-output-to-string (out)
                                     (loop repeat (ceiling total 17)
                                           do (write-string "0123456789abcdef" out)
                                              (write-char #\Newline out)))
                                   0 total)))
                 (is (equal tail (subseq full (- total (length tail))))))
               (is (or (> (length tail) 1000)
                       (> (count #\Newline tail) 20)))))
           (let ((started (get-internal-real-time)))
             (dotimes (attempt 20)
               (let ((abort (cadr-env::make-env-abort)))
                 (if (evenp attempt)
                     (cadr-env::env-abort abort)
                     (let ((delay (mod attempt 5)))
                       (sb-thread:make-thread
                        (lambda ()
                          (sleep (/ delay 1000.0))
                          (cadr-env::env-abort abort))
                        :name "env-abort")))
                 (let ((result (remote-exec env '("sleep" "5") :abort abort)))
                   (is (env-err-p result))
                   (is (equal "aborted" (env-err-code result))))))
             (is (< (/ (- (get-internal-real-time) started) internal-time-units-per-second) 10)))
           (let ((started (get-internal-real-time))
                 (result (remote-exec env '("sleep" "5") :timeout 0.3)))
             (is (env-err-p result))
             (is (equal "timeout" (env-err-code result)))
             (is (equal "timeout:0.3" (env-err-message result)))
             (is (< (/ (- (get-internal-real-time) started) internal-time-units-per-second) 3)))
           (is (env-ok-p (remote-write-file env "a.txt" "AAA")))
           (is (env-ok-p (remote-write-file env "b.txt" "BBB")))
           (let* ((reader (remote-open-binary-reader env "a.txt"))
                  (pid (cadr-env::json-get (spawn-info connection) "pid")))
             (is (env-ok-p reader))
             (sb-posix:kill pid 9)
             (sleep 0.3)
             (let ((other (remote-open-binary-reader env "b.txt")))
               (is (env-ok-p other))
               (is (not (eql pid (cadr-env::json-get (spawn-info connection) "pid"))))
               (let ((stale (remote-reader-read (env-ok-value reader) 0 3))
                     (fresh (remote-reader-read (env-ok-value other) 0 3)))
                 (is (env-err-p stale))
                 (is (equal "unknown" (env-err-code stale)))
                 (is (env-ok-p fresh))
                 (is (equalp (cadr-env::utf8-bytes "BBB") (env-ok-value fresh))))
               (remote-reader-close (env-ok-value reader))
               (remote-reader-close (env-ok-value other))))
           (let ((cancel-root (concatenate 'string root "/cancel")))
             (dotimes (dir 100)
               (ensure-directories-exist (format nil "~A/d~D/." cancel-root dir))
               (dotimes (file 100)
                 (write-text-file (format nil "~A/d~D/f~D" cancel-root dir file) "")))
             (let ((abort (cadr-env::make-env-abort)))
               (cadr-env::env-abort abort)
               (handler-case
                   (progn
                     (spawn-request connection "listFiles"
                                    (cadr-env::json-object "path" cancel-root) :abort abort)
                     (fail "listFiles was not aborted"))
                 (cadr-env::remote-error (condition)
                   (is (equal "aborted" (remote-error-code condition)))
                   (is (equal "aborted" (remote-error-message condition))))))))
           (let ((listed (remote-list-files env "cancel"))
                 (bounded (remote-list-files env "cancel" :max-entries 5000)))
             (is (env-ok-p listed))
             (is (equal (list 10100 nil) (list (length (getf (env-ok-value listed) :entries))
                                               (getf (env-ok-value listed) :truncated))))
             (is (env-ok-p bounded))
             (is (equal (list 5000 t) (list (length (getf (env-ok-value bounded) :entries))
                                            (getf (env-ok-value bounded) :truncated))))))
      (spawn-close connection)))

(test ssh-deploy-and-remote-env-match-v140
  (let* ((root (cadr-env::temp-dir "pi-env-ssh-"))
         (home (concatenate 'string root "/home"))
         (launcher (write-daemon-launcher (concatenate 'string root "/pi-env")))
         (port (free-tcp-port))
         (server nil))
    (ensure-directories-exist (concatenate 'string home "/"))
    (run-keygen (concatenate 'string root "/host_key"))
    (run-keygen (concatenate 'string root "/client_key"))
    (write-text-file (concatenate 'string root "/authorized_keys")
                     (read-text-file (concatenate 'string root "/client_key.pub")))
    (write-text-file (concatenate 'string root "/sshd_config")
                     (format nil "Port ~D~%ListenAddress 127.0.0.1~%HostKey ~A~%AuthorizedKeysFile ~A~%PidFile ~A~%PasswordAuthentication no~%KbdInteractiveAuthentication no~%StrictModes no~%SetEnv HOME=~A~%~%"
                             port
                             (concatenate 'string root "/host_key")
                             (concatenate 'string root "/authorized_keys")
                             (concatenate 'string root "/sshd.pid")
                             home))
    (write-text-file (concatenate 'string root "/ssh_config") "")
    (ensure-directories-exist "/run/sshd/")
    (sb-posix:chmod "/run/sshd" #o755)
    (setf server (sb-ext:run-program "/usr/sbin/sshd" (list "-D" "-e" "-f" (concatenate 'string root "/sshd_config"))
                                     :wait nil :output nil :error nil))
    (unwind-protect
         (let ((target (list :host "127.0.0.1" :port port :user (current-user)
                             :identity-file (concatenate 'string root "/client_key")
                             :known-hosts-file (concatenate 'string root "/known_hosts")
                             :host-key-alias "pi-env-test"
                             :config-file (concatenate 'string root "/ssh_config"))))
           (wait-for-port port)
           (signals host-key-unknown-error
             (connect-ssh target :binary launcher))
           (let* ((scanned (scan-host-key target))
                  (expected (fingerprint (concatenate 'string root "/host_key.pub"))))
             (is (search expected (format nil "~{~A~%~}" (getf scanned :fingerprints))))
             (accept-host-key target (getf scanned :lines)))
           (ensure-directories-exist (concatenate 'string home "/.pi/mobile/tools/"))
           (write-text-file (concatenate 'string home "/.pi/mobile/tools/pi-env-0123456789abcdef0123456789abcdef")
                            "old")
           (multiple-value-bind (connection remote) (connect-ssh target :binary launcher)
             (unwind-protect
                  (progn
                    (is (equal home (getf remote :home)))
                    (let* ((deployed-name (concatenate 'string "pi-env-"
                                                       (subseq (cadr-env::sha256-hex-file launcher) 0 32)))
                           (deployed (read-text-file (concatenate 'string home "/.pi/mobile/tools/" deployed-name))))
                      (is (equal (read-text-file launcher) deployed))
                      (is (equal (list deployed-name)
                                 (remove-if-not (lambda (name) (and (>= (length name) 7)
                                                                    (string= name "pi-env-" :end1 7)))
                                                (cadr-env::directory-entries
                                                 (concatenate 'string home "/.pi/mobile/tools"))))))
                    (let ((env (make-remote-env :connection connection :id "pi-env:test" :cwd home)))
                      (is (env-ok-p (remote-write-file env "over-ssh.txt" "hello")))
                      (is (equal "hello" (env-ok-value (remote-read-text-file env "over-ssh.txt"))))
                      (let ((output nil))
                        (let ((result (remote-exec env '("sh" "-c" "printf %s \"$HOME\"")
                                                   :on-output (lambda (text skipped)
                                                                (declare (ignore skipped))
                                                                (push text output)))))
                          (is (eql 0 (env-ok-value result)))
                          (is (equal home (apply #'concatenate 'string (nreverse output))))))))
               (spawn-close connection)))
           (let* ((deployed-name (concatenate 'string "pi-env-"
                                              (subseq (cadr-env::sha256-hex-file launcher) 0 32)))
                  (file (concatenate 'string home "/.pi/mobile/tools/" deployed-name))
                  (before (sb-posix:stat-mtime (sb-posix:stat file))))
             (multiple-value-bind (again remote) (connect-ssh target :binary launcher)
               (declare (ignore remote))
               (spawn-close again))
             (is (eql before (sb-posix:stat-mtime (sb-posix:stat file))))
             (write-text-file file "tampered")
             (multiple-value-bind (replaced remote) (connect-ssh target :binary launcher)
               (declare (ignore remote))
               (unwind-protect
                    (progn
                      (is (equal (read-text-file launcher) (read-text-file file)))
                      (is (equal home (cadr-env::json-get (spawn-info replaced) "home"))))
                 (spawn-close replaced))))
           (multiple-value-bind (connection remote) (connect-ssh target :binary launcher)
             (declare (ignore remote))
             (unwind-protect
                  (let* ((file (concatenate 'string home "/.pi/mobile/tools/pi-env-"
                                            (subseq (cadr-env::sha256-hex-file launcher) 0 32)))
                         (pid (cadr-env::json-get (spawn-info connection) "pid")))
                    (sb-posix:kill pid 9)
                    (sleep 0.3)
                    (write-text-file file "tampered")
                    (is (not (eql pid (cadr-env::json-get (spawn-info connection) "pid"))))
                    (is (equal (read-text-file launcher) (read-text-file file))))
               (spawn-close connection)))
           (let ((tree (concatenate 'string home "/tree")))
             (dolist (file '("a/b.txt" "a/c/d.txt" ".hidden" "out/x.js" "skip/y.txt" ".git/HEAD"))
               (write-text-file (concatenate 'string tree "/" file) ""))
             (ensure-directories-exist (concatenate 'string tree "/empty/"))
             (write-text-file (concatenate 'string tree "/.gitignore")
                              (concatenate 'string "out/" (string #\Newline)))
             (multiple-value-bind (connection remote) (connect-ssh target :binary launcher)
               (declare (ignore remote))
               (unwind-protect
                    (let* ((env (make-remote-env :connection connection :id "pi-env:test" :cwd home))
                           (listed (remote-list-files env "tree" :exclude '("skip"))))
                      (is (env-ok-p listed))
                      (is (equal '(("file" ".gitignore") ("file" ".hidden") ("directory" "a")
                                   ("file" "a/b.txt") ("directory" "a/c") ("file" "a/c/d.txt")
                                   ("directory" "empty"))
                                 (mapcar #'entry-pair (getf (env-ok-value listed) :entries))))
                      (is (not (getf (env-ok-value listed) :truncated))))
                 (spawn-close connection))))
           (write-text-file (concatenate 'string home "/.profile")
                            (concatenate 'string "export PI_ENV_LOGIN=yes" (string #\Newline)))
           (write-text-file (concatenate 'string home "/.zprofile")
                            (concatenate 'string "export PI_ENV_LOGIN=yes" (string #\Newline)))
           (flet ((login (login-shell)
                    (multiple-value-bind (connection remote) (connect-ssh target :binary launcher
                                                                          :login-shell login-shell)
                      (declare (ignore remote))
                      (unwind-protect
                           (let ((output nil)
                                 (env (make-remote-env :connection connection :id "pi-env:test" :cwd home)))
                             (remote-exec env '("sh" "-c" "printf %s \"$PI_ENV_LOGIN\"")
                                          :on-output (lambda (text skipped)
                                                       (declare (ignore skipped))
                                                       (push text output)))
                             (apply #'concatenate 'string (nreverse output)))
                        (spawn-close connection)))))
             (is (equal "" (login nil)))
             (is (equal "yes" (login t))))
           (let* ((lazy-target (list :host "127.0.0.1" :port port :user (current-user)
                                     :identity-file (concatenate 'string root "/client_key")
                                     :known-hosts-file (concatenate 'string root "/lazy_known_hosts")
                                     :host-key-alias "pi-env-test"
                                     :config-file (concatenate 'string root "/ssh_config"))))
             (multiple-value-bind (connection remote) (ssh-connection lazy-target :binary launcher)
               (unwind-protect
                    (let ((env (make-remote-env :connection connection :id "pi-env:test" :cwd home)))
                      (is (null (funcall remote)))
                      (let ((read (remote-read-text-file env "missing.txt")))
                        (is (env-err-p read))
                        (is (search "not trusted" (env-err-message read))))
                      (let ((command (remote-exec env '("sh" "-c" "exit 0"))))
                        (is (env-err-p command))
                        (is (equal "spawn_error" (env-err-code command))))
                      (accept-host-key lazy-target (getf (scan-host-key lazy-target) :lines))
                      (let ((accepted (remote-exec env '("sh" "-c" "exit 0"))))
                        (is (env-ok-p accepted))
                        (is (eql 0 (env-ok-value accepted))))
                      (is (equal home (getf (funcall remote) :home))))
                 (spawn-close connection))))
           (let* ((known (concatenate 'string root "/accept_known_hosts"))
                  (scoped (list :host "127.0.0.1" :port port :user (current-user)
                                :identity-file (concatenate 'string root "/client_key")
                                :known-hosts-file known
                                :host-key-alias "pi-env-test"
                                :config-file (concatenate 'string root "/ssh_config")))
                  (first-key (progn (run-keygen (concatenate 'string root "/accept_first"))
                                    (key-material (concatenate 'string root "/accept_first.pub"))))
                  (second-key (progn (run-keygen (concatenate 'string root "/accept_second"))
                                     (key-material (concatenate 'string root "/accept_second.pub")))))
             (signals error (accept-host-key scoped (list (format nil "other-alias ~A" first-key))))
             (signals error (accept-host-key scoped (list (format nil "@cert-authority pi-env-test ~A" first-key))))
             (let ((threads (list (sb-thread:make-thread
                                   (lambda () (accept-host-key scoped (list (format nil "pi-env-test ~A" first-key)))))
                                  (sb-thread:make-thread
                                   (lambda () (accept-host-key scoped (list (format nil "pi-env-test ~A" first-key))))))))
               (dolist (thread threads)
                 (sb-thread:join-thread thread)))
             (is (equal (format nil "pi-env-test ~A~%" first-key) (read-text-file known)))
             (signals host-key-changed-error
               (accept-host-key scoped (list (format nil "pi-env-test ~A" second-key))))
             (forget-host-key scoped)
             (accept-host-key scoped (list (format nil "pi-env-test ~A" second-key)))
             (is (equal (format nil "pi-env-test ~A~%" second-key) (read-text-file known))))
           (let ((other (concatenate 'string root "/other_key")))
             (run-keygen other)
             (write-text-file (concatenate 'string root "/changed_known_hosts")
                              (format nil "pi-env-test ~A~%" (key-material (concatenate 'string other ".pub"))))
             (signals host-key-changed-error
               (connect-ssh (list :host "127.0.0.1" :port port :user (current-user)
                                  :identity-file (concatenate 'string root "/client_key")
                                  :known-hosts-file (concatenate 'string root "/changed_known_hosts")
                                  :host-key-alias "pi-env-test"
                                  :config-file (concatenate 'string root "/ssh_config")
                                  :binary launcher)
                            :binary launcher))))
      (when server
        (ignore-errors (sb-ext:process-kill server 9))
        (ignore-errors (sb-ext:process-wait server))))))

(defun exec-streams (env command &key cwd)
  (let ((stdout "")
        (stderr ""))
    (let ((result (remote-exec env command :cwd cwd
                               :on-output (lambda (text info)
                                            (if (equal (cadr-env::json-get info "stream") "stderr")
                                                (setf stderr (concatenate 'string stderr text))
                                                (setf stdout (concatenate 'string stdout text)))))))
      (values result stdout stderr))))

(defun path-covered-p (change path)
  (or (getf change :overflow)
      (some (lambda (reported)
              (and (stringp reported)
                   (or (equal path reported)
                       (and (< (length reported) (length path))
                            (string= reported path :end2 (length reported))
                            (member (char path (length reported)) '(#\/ #\\))))))
            (getf change :paths))))

(defun wait-for-path (box path lock)
  (loop repeat 150
        for snapshot = (sb-thread:with-mutex (lock) (copy-list (car box)))
        when (some (lambda (change) (path-covered-p change path)) snapshot)
          do (return t)
        do (sleep 0.02)))

(test remote-execution-env-matches-v140-conformance
