           (is (null (env-ok-value (remote-read-text-lines env "/dev/null"))))
           (is (equal "is_directory" (env-err-code (remote-read-text-file env "dir"))))
           (is (equal "is_directory" (env-err-code (remote-read-binary-file env "dir"))))
           (let ((lines (remote-open-text-line-reader env "dir")))
             (is (env-ok-p lines))
