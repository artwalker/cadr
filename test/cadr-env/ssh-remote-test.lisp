               (is (eql 0 (cadr-env::json-get (env-ok-value past) "selectedBytes")))
               (is (equal "invalid" (env-err-code (remote-reader-scan-lines (env-ok-value reader)
                                                                           :start-line 2 :end-line 2)))))
             (remote-reader-close (env-ok-value reader)))
           (is (env-ok-p (remote-write-file env "a.txt" "one")))
