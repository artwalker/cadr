    (unwind-protect
         (progn
           (is (equal "a/b" (env-ok-value (remote-join-path env '("a" "b")))))
           (is (equal "/a/b" (env-ok-value (remote-join-path env '("/a" "b")))))
           (is (equal "a/b" (env-ok-value (remote-join-path env '("a" "/b")))))
           (is (equal "a/b" (env-ok-value (remote-join-path env '("a/" "b")))))
