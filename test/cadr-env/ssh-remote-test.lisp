             (remote-dir-close (env-ok-value reader))
             (is (equal "invalid" (env-err-code (remote-dir-next (env-ok-value reader) 1)))))
           (is (equal "not_found" (env-err-code (remote-open-dir-reader env "missing"))))
           (is (equal "not_directory" (env-err-code (remote-open-dir-reader env "data.txt"))))
           (is (null (env-ok-value (remote-exists env "missing.txt"))))
           (is (eq t (env-ok-value (remote-exists env "data.txt"))))
           (let ((info (remote-file-info env "data.txt")))
             (is (equal "data.txt" (getf (env-ok-value info) :name)))
             (is (equal "file" (getf (env-ok-value info) :kind)))
             (is (eql 11 (getf (env-ok-value info) :size))))
           (is (env-ok-p (remote-truncate-file env "data.txt" 5)))
           (is (equal "hello" (env-ok-value (remote-read-text-file env "data.txt"))))
           (is (env-ok-p (remote-flush-file env "data.txt")))
           (is (equal (env-ok-value (remote-absolute-path env "data.txt"))
                      (env-ok-value (remote-canonical-path env "data.txt"))))
           (is (null (env-ok-value (remote-read-text-lines env "lines.txt" :max-lines 0))))
           (is (null (env-ok-value (remote-read-text-lines env "nowhere" :max-lines 0))))
           (is (env-ok-p (remote-write-file env "three.txt" (format nil "a~%b~%c"))))
           (is (equal '("a" "b") (env-ok-value (remote-read-text-lines env "three.txt" :max-lines 2))))
           (is (equal '("a" "b" "c") (env-ok-value (remote-read-text-lines env "three.txt"))))
           (multiple-value-bind (result stdout stderr)
               (exec-streams env "printf out; printf err >&2; printf more")
             (is (eql 0 (env-ok-value result)))
             (is (equal "outmore" stdout))
             (is (equal "err" stderr)))
           (multiple-value-bind (result stdout stderr)
               (exec-streams env '("sh" "-c" "printf out; printf err >&2; printf more"))
             (is (eql 0 (env-ok-value result)))
             (is (equal "outmore" stdout))
             (is (equal "err" stderr)))
           (let ((hostile "it's $(touch pwned) `touch pwned` *; touch pwned"))
             (multiple-value-bind (result stdout)
                 (exec-streams env (list "sh" "-c" "printf \"%s|%s\" \"$1\" \"$2\"" "argv0" hostile "a b"))
               (is (eql 0 (env-ok-value result)))
               (is (equal (format nil "~A|a b" hostile) stdout))
