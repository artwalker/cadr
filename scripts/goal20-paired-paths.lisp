(defun auth-command-error-p (arguments)
  (handler-case
      (progn
        (cadr-cli::parse-auth-command arguments)
        0)
    (error () 1)))

(defun run-cli-models-rest-auth-command ()
  (let ((skip (cadr-cli::parse-auth-command '("models")))
        (api
          (cadr-cli::parse-auth-command
           '("auth" "print-api-key" "--provider" "openai")))
        (bearer
          (cadr-cli::parse-auth-command
           '("auth" "print-bearer-token" "--min-expiry" "30m")))
        (check
          (cadr-cli::parse-auth-command
           '("auth" "check" "--json" "--credentials" "--no-refresh"
             "--provider" "openai"))))
    (list
     (if skip 1 0)
     (if (eq (getf api :kind) :api-key) 1 0)
     (if (equal (getf api :arguments) '("--provider" "openai")) 1 0)
     (if (eq (getf bearer :kind) :bearer-token) 1 0)
     (or (getf bearer :minimum-expiry-ms) 0)
     (if (eq (getf check :kind) :check) 1 0)
     (if (getf check :json-p) 1 0)
     (if (getf check :credentials-p) 1 0)
     (if (getf check :no-refresh-p) 1 0)
     (if (equal (getf check :arguments) '("--provider" "openai")) 1 0)
     (auth-command-error-p
      '("auth" "print-api-key" "--min-expiry" "30m"))
     (auth-command-error-p '("auth" "unknown"))
     (if (cadr-cli::auth-command-help-request-p '("auth" "--help"))
         1
         0)
     (if (cadr-cli::auth-command-help-request-p
          '("auth" "print-api-key" "--help"))
         1
         0))))


(defun login-selection-kind-code (kind)
  (ecase kind
    (:no-default-model 1)
    (:no-models-available 2)
    (:default-model-unavailable 3)
    (:select-failed 4)
    (otherwise 0)))

(defun make-login-selection-openai-model (id)
  (cadr-ai:make-model
   :id id
   :name id
   :api :openai-completions
   :provider :openai
   :base-url "http://127.0.0.1:1/v1"
   :context-window 128000
   :max-tokens 8192))

(defun run-cli-models-rest-login-selection ()
  (let* ((xai-empty
           (multiple-value-list
             (cadr-cli:classify-post-login-model :xai '())))
         (nodef
           (multiple-value-list
             (cadr-cli:classify-post-login-model :not-a-provider '())))
         (wrong-model (make-login-selection-openai-model "wrong-id"))
         (defunavail
           (multiple-value-list
             (cadr-cli:classify-post-login-model
              :openai (list wrong-model))))
         (good-model (make-login-selection-openai-model "gpt-5.5"))
         (ok-result
           (cadr-cli:post-login-selection-result
            :openai (list good-model)
            (lambda (model) (declare (ignore model)))))
         (fail-result
           (cadr-cli:post-login-selection-result
            :openai (list good-model)
            (lambda (model)
              (declare (ignore model))
              (error "goal20 login selection bench fail"))))
         (nomodels-text
           (cadr-cli:post-login-selection-error
            "Logged in to" "xAI" :xai :no-models-available nil))
         (nodef-text
           (cadr-cli:post-login-selection-error
            "Logged in to" "Unknown" :not-a-provider :no-default-model nil)))
    (list
     (login-selection-kind-code (second xai-empty))
     (login-selection-kind-code (second nodef))
     (login-selection-kind-code (second defunavail))
     (if (string= ok-result "gpt-5.5") 1 0)
     (if (and (listp fail-result) (eq (first fail-result) :select-failed))
         1
         0)
     (if (search "no models are available for that provider" nomodels-text)
         1
         0)
     (if (search "no default model is configured for provider" nodef-text)
         1
         0))))

