  ;; FiveAM tool-call-result-and-next-model-turn-complete.
  ;; Production agent-prompt + faux stream. No socket.
  (let* ((executed (list nil))
         (agent
           (cadr-agent:make-agent
            :provider :mock
            :model
            (cadr-ai:make-model
             :id "mock"
             :provider :openai
