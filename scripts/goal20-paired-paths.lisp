   (lambda ()) #'identity #'identity
   :message "Loading..."
   :indicator-frames '("a" "b")
   :start-p nil))

(defun loader-text-has (loader needle)
  (if (search needle (cadr-tui:text-component-text loader))
      1
      0))

(defun run-tui-loader-step ()
