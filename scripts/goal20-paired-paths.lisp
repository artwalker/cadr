(defun leftover-display-session ()
  ;; Message-only parent chain: session-display-messages walks
  ;; session-context-entries (leaf + by-id). No compaction entry
  ;; (invalid first-kept-id errors).
  (let* ((u1
           (cadr-agent::make-session-entry
