(defun fmq-truth (value)
  (if value 1 0))

(defun stage-file-mutation-queue-layout ()
  (let ((root (merge-pathnames "file-mutation-queue/" *scratch-directory*)))
    (ensure-directories-exist root)
    (values root
            (merge-pathnames "target.txt" root)
            (merge-pathnames "alias.txt" root)
            (merge-pathnames "other.txt" root)
            (merge-pathnames "missing.txt" root))))

(defun fmq-setup-alias (target alias)
  (when (probe-file alias) (delete-file alias))
  (sb-posix:symlink (namestring target) (namestring alias)))

(defun run-file-mutation-queue-with-queue ()
  ;; Baseline withFileMutationQueue only; not write/edit tools.
  (multiple-value-bind (dir target alias other missing)
      (stage-file-mutation-queue-layout)
    (declare (ignore dir))
    (ensure-directories-exist target)
    (with-open-file (stream target :direction :output
                            :if-exists :supersede :if-does-not-exist :create)
      (write-string "seed" stream))
    (fmq-setup-alias target alias)
    (let* ((alias-key-ok
             (fmq-truth
              (string=
               (cadr-agent::file-mutation-queue-key target)
               (cadr-agent::file-mutation-queue-key alias))))
           (missing-key-ok
             (fmq-truth
              (string=
               (cadr-agent::file-mutation-queue-key missing)
               (namestring (uiop:ensure-absolute-pathname missing)))))
           (other-key-ok
             (fmq-truth
              (not (string=
                    (cadr-agent::file-mutation-queue-key target)
                    (cadr-agent::file-mutation-queue-key other)))))
           (fifo-sum 0)
           (other-run 0)
           (clean 0))
      (cadr-agent:with-file-mutation-queue (target)
        (incf fifo-sum 1))
      (cadr-agent:with-file-mutation-queue (target)
        (incf fifo-sum 2))
      (cadr-agent:with-file-mutation-queue (target)
        (incf fifo-sum 3))
      (cadr-agent:with-file-mutation-queue (target)
        (setf other-run
              (cadr-agent:with-file-mutation-queue (other)
                7)))
      (cadr-agent:with-file-mutation-queue (other)
        (setf clean 1))
      (list alias-key-ok missing-key-ok other-key-ok fifo-sum other-run clean))))

(defun run-file-mutation-queue-queue-key ()
  ;; Baseline queue-map key only (realpath / ENOENT resolved path);
  ;; not withFileMutationQueue and not write/edit tools.
  (multiple-value-bind (dir target alias other missing)
      (stage-file-mutation-queue-layout)
    (declare (ignore dir))
    (ensure-directories-exist target)
    (with-open-file (stream target :direction :output
                            :if-exists :supersede :if-does-not-exist :create)
      (write-string "seed" stream))
    (fmq-setup-alias target alias)
    (let* ((target-key (cadr-agent::file-mutation-queue-key target))
           (alias-key (cadr-agent::file-mutation-queue-key alias))
           (missing-key (cadr-agent::file-mutation-queue-key missing))
           (other-key (cadr-agent::file-mutation-queue-key other)))
      (list
       (fmq-truth (string= target-key alias-key))
       (fmq-truth
        (string=
         missing-key
         (namestring (uiop:ensure-absolute-pathname missing))))
       (fmq-truth (not (string= target-key other-key)))
       4))))

(defun fmq-drop-empty-queues ()
  (sb-thread:with-mutex (cadr-agent::*file-mutation-queues-guard*)
    (let ((keys '()))
      (maphash
       (lambda (key state)
         (when (zerop
                (cadr-agent::file-mutation-queue-state-pending-count state))
           (push key keys)))
       cadr-agent::*file-mutation-queues*)
      (dolist (key keys)
        (remhash key cadr-agent::*file-mutation-queues*)))))

(defun fmq-clear-queues ()
  (sb-thread:with-mutex (cadr-agent::*file-mutation-queues-guard*)
    (clrhash cadr-agent::*file-mutation-queues*)))

(defun fmq-queue-present-p (key)
  (sb-thread:with-mutex (cadr-agent::*file-mutation-queues-guard*)
    (nth-value 1 (gethash key cadr-agent::*file-mutation-queues*))))

(defun run-file-mutation-queue-lock ()
  ;; Baseline fileMutationQueues.get(key) ?? Promise.resolve() / set after
  ;; the same key encoding; not withFileMutationQueue and not write/edit.
  (multiple-value-bind (dir target alias other missing)
      (stage-file-mutation-queue-layout)
    (declare (ignore dir))
    (ensure-directories-exist target)
    (with-open-file (stream target :direction :output
                            :if-exists :supersede :if-does-not-exist :create)
      (write-string "seed" stream))
    (fmq-setup-alias target alias)
    (let* ((target-state (cadr-agent::file-mutation-queue-lock target))
           (alias-state (cadr-agent::file-mutation-queue-lock alias))
           (other-state (cadr-agent::file-mutation-queue-lock other))
           (missing-state (cadr-agent::file-mutation-queue-lock missing))
           (repeat-state (cadr-agent::file-mutation-queue-lock target)))
      (prog1
          (list
           (fmq-truth (eq target-state alias-state))
           (fmq-truth (not (eq target-state other-state)))
           (fmq-truth
            (zerop
             (cadr-agent::file-mutation-queue-state-pending-count
              missing-state)))
           (fmq-truth (eq target-state repeat-state))
           5)
        (fmq-drop-empty-queues)))))

(defun run-file-mutation-queue-register ()
  ;; Baseline withFileMutationQueue ticket enqueue (pending++ / next-promise
  ;; chain) after the same key encoding; not wait/fn/release and not write/edit.
  (multiple-value-bind (dir target alias other missing)
      (stage-file-mutation-queue-layout)
    (declare (ignore dir))
    (ensure-directories-exist target)
    (with-open-file (stream target :direction :output
                            :if-exists :supersede :if-does-not-exist :create)
      (write-string "seed" stream))
    (fmq-setup-alias target alias)
    (multiple-value-bind (target-key target-state target-ticket)
        (cadr-agent::register-file-mutation target)
      (declare (ignore target-ticket))
      (multiple-value-bind (alias-key alias-state alias-ticket)
          (cadr-agent::register-file-mutation alias)
        (multiple-value-bind (other-key other-state other-ticket)
            (cadr-agent::register-file-mutation other)
          (declare (ignore other-state other-ticket))
          (multiple-value-bind (missing-key missing-state missing-ticket)
              (cadr-agent::register-file-mutation missing)
            (declare (ignore missing-key missing-state missing-ticket))
            (prog1
                (list
                 (fmq-truth (string= target-key alias-key))
                 (fmq-truth (not (string= target-key other-key)))
                 (fmq-truth
                  (and (eq target-state alias-state)
                       (= 2
                          (cadr-agent::file-mutation-queue-state-pending-count
                           target-state))))
                 (fmq-truth (= alias-ticket 1))
                 4)
              (fmq-clear-queues))))))))

(defun run-file-mutation-queue-wait-turn ()
  ;; Baseline withFileMutationQueue await-current (ticket wait) after
  ;; enqueue; not fn/release and not write/edit tools. Ticket 0 is the
  ;; serving ticket, so wait returns without blocking.
  (multiple-value-bind (dir target alias other missing)
      (stage-file-mutation-queue-layout)
    (declare (ignore dir))
    (ensure-directories-exist target)
    (with-open-file (stream target :direction :output
                            :if-exists :supersede :if-does-not-exist :create)
      (write-string "seed" stream))
    (fmq-setup-alias target alias)
    (multiple-value-bind (target-key target-state target-ticket)
        (cadr-agent::register-file-mutation target)
      (declare (ignore target-key))
      (multiple-value-bind (alias-key alias-state alias-ticket)
          (cadr-agent::register-file-mutation alias)
        (declare (ignore alias-key alias-ticket))
        (multiple-value-bind (other-key other-state other-ticket)
            (cadr-agent::register-file-mutation other)
          (declare (ignore other-key))
          (multiple-value-bind (missing-key missing-state missing-ticket)
              (cadr-agent::register-file-mutation missing)
            (declare (ignore missing-key))
            (cadr-agent::wait-for-file-mutation-turn
             target-state target-ticket)
            (cadr-agent::wait-for-file-mutation-turn
             other-state other-ticket)
            (cadr-agent::wait-for-file-mutation-turn
             missing-state missing-ticket)
            (prog1
                (list
