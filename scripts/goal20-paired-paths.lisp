         :key #'cadr-cli::extension-source-record-scope))

(defun run-cli-extensions-extension-discovery ()
  ;; discover-extension-sources only: flat/subdir scan, project/global
  ;; dirs, explicit -e paths. Unique ids so id-dedupe stays quiet.
  (multiple-value-bind (cwd global explicit probe-dir root)
      (stage-extension-discovery-layout)
    (let* ((manager
             (cadr-cli::make-cli-extension-manager
              :cwd cwd
              :global-directory global
              :explicit-paths (list explicit)
              :output (make-string-output-stream)))
           (probe
             (cadr-cli::discover-extensions-in-directory
              probe-dir :project 1)))
      (multiple-value-bind (sources errors collisions)
          (cadr-cli::discover-extension-sources manager)
        (list
         (length sources)
         (length errors)
         (length collisions)
         (extension-discovery-scope-count sources :cli)
         (extension-discovery-scope-count sources :project)
         (extension-discovery-scope-count sources :global)
         (length probe)
         (if (zerop (length (cadr-cli::discover-extensions-in-directory
                              (merge-pathnames "missing/" root)
                              :global 0)))
             1
             0))))))

(defun run-cli-extensions-llama-catalog ()
  ;; Loaded only. Sleeping/unloaded stay out. Do not exact
  ;; n_ctx_train-only fallback vs cadr training-context-window
  ;; when both are set differently.
  (let* ((controller (cadr-cli::make-llama-provider-controller))
         (models
           (progn
             (cadr-cli::llama-provider-set-catalog
              controller
              (list
               (llama-catalog-info "loaded-text" :loaded :ctx 4096)
               (llama-catalog-info
                "loaded-img" :loaded
                :modalities '("image") :ctx 8192)
               (llama-catalog-info "fb" :loaded)
               (llama-catalog-info "sleeping" :sleeping :ctx 4096)
               (llama-catalog-info "unloaded" :unloaded))
              "http://127.0.0.1:8080/")
             (cadr-ai:runtime-provider-models
              (cadr-cli::llama-provider-controller-provider
               controller))))
         (text
           (find "loaded-text" models
                 :key #'cadr-ai:model-id :test #'string=))
         (img
           (find "loaded-img" models
                 :key #'cadr-ai:model-id :test #'string=))
         (fb
           (find "fb" models
                 :key #'cadr-ai:model-id :test #'string=)))
    (list
     (length models)
     (if (and img (cadr-ai:model-supports-images-p img)) 1 0)
     (if (and text (= (cadr-ai:model-context-window text) 4096)) 1 0)
     (if (and img
              (string=
               (cadr-ai:model-base-url img)
               "http://127.0.0.1:8080/v1"))
         1
         0)
     (if (find "sleeping" models
               :key #'cadr-ai:model-id :test #'string=)
         1
         0)
     (if (and fb (= (cadr-ai:model-context-window fb) 128000))
         1
         0))))

