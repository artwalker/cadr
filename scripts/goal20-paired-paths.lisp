      (lambda (prompt)
        (concatenate 'string prompt " extra"))
      "You are cadr.")
     "You are cadr. extra"))
   (eval-system-prompt-error-p
    (constantly "") "You are cadr.")
   (eval-system-prompt-error-p
    (constantly "   ") "You are cadr.")
