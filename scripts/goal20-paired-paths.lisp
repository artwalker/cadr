(defun tool-path-flag (cwd path expected)
  (if (string= (namestring (cadr-cli::resolve-tool-path cwd path))
               expected)
      1
      0))

(defun run-agent-tool-loop-tool-path ()
  ;; POSIX only. Do not exact empty (cadr errors) or "~"
  ;; (cadr directory namestring keeps a trailing slash).
  (let ((cwd "/tmp/goal20-tp/cwd")
        (nbsp (format nil "a~Cb.txt" (code-char #xa0))))
    (list
     (tool-path-flag cwd "foo.txt" "/tmp/goal20-tp/cwd/foo.txt")
     (tool-path-flag cwd "/tmp/abs/bar" "/tmp/abs/bar")
     (tool-path-flag cwd "@rel.txt" "/tmp/goal20-tp/cwd/rel.txt")
     (tool-path-flag cwd nbsp "/tmp/goal20-tp/cwd/a b.txt")
     (tool-path-flag cwd "../x" "/tmp/goal20-tp/x"))))

(defun line-ending-flag (text expected)
  (if (eq (cadr-cli::detect-line-ending text) expected)
      1
      0))

(defun run-agent-tool-loop-line-ending ()
  ;; Do not exact mixed first-LF-then-CRLF (cadr searches any CRLF;
  ;; pi compares the first \\n against the first \\r\\n).
  (list
   (line-ending-flag (format nil "a~Cb" #\Newline) :lf)
   (line-ending-flag
    (format nil "a~C~Cb" #\Return #\Newline) :crlf)
   (line-ending-flag "ab" :lf)
   (line-ending-flag "" :lf)))

(defun tool-result-digest-truncated-p (text)
  (if (search "[... " text) 1 0))

(defun run-agent-tool-loop-tool-result-digest ()
  ;; Time truncate-summary-tool-result only, not serializeConversation
  ;; or a live compact. UTF-16 code units match pi String.length/slice.
  (let* ((short "hello")
         (exact (make-string 2000 :initial-element #\a))
         (over (make-string 2001 :initial-element #\x))
         (emoji (string (code-char #x1f642)))
         (utf16
           (concatenate
            'string
            (apply #'concatenate 'string
                   (make-list 1000 :initial-element emoji))
            "x"))
         (short-out (cadr-agent::truncate-summary-tool-result short))
         (exact-out (cadr-agent::truncate-summary-tool-result exact))
         (over-out (cadr-agent::truncate-summary-tool-result over))
         (utf16-out (cadr-agent::truncate-summary-tool-result utf16))
         (empty-out (cadr-agent::truncate-summary-tool-result "")))
    (list
     (if (string= short-out short) 1 0)
     (if (string= exact-out exact) 1 0)
     (tool-result-digest-truncated-p over-out)
     (if (search "1 more characters truncated" over-out) 1 0)
     (tool-result-digest-truncated-p utf16-out)
     (if (string= empty-out "") 1 0))))


