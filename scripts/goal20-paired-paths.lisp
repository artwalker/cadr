(defun run-cli-support-watch-start-close (present)
  (let ((hits 0)
        watcher)
    (unwind-protect
         (progn
           (setf watcher
                 (cadr-cli::watch-with-error-handler
                  (namestring present)
                  (lambda (&rest args)
                    (declare (ignore args)))
                  (lambda ()
                    (incf hits))))
           (let ((got (if watcher 1 0)))
             (when watcher
               (cadr-cli::close-watcher watcher))
             (list
              got
              (if (and watcher
                       (cadr-cli::file-watcher-closed-p watcher))
                  1
                  0)
              (if (zerop hits) 1 0)
              1)))
      (when watcher
        (cadr-cli::close-watcher watcher)))))


(defun run-cli-support-poll-once (present)
  (let* ((n 0)
         (watcher
           (cadr-cli::%make-file-watcher
            :path present
            :listener
            (lambda (&rest args)
              (declare (ignore args))
              (incf n))
            :on-error (lambda ())
            :signature
            (cadr-cli::watched-path-signature present)))
         (same (cadr-cli::poll-file-watcher-once watcher)))
    (with-open-file
        (out present
             :direction :output
             :if-exists :append
             :if-does-not-exist :create)
      (write-string "x" out))
    (let ((changed (cadr-cli::poll-file-watcher-once watcher)))
      (list
       (if same 0 1)
       (if changed 1 0)
       (if (= n 1) 1 0)
       1))))


