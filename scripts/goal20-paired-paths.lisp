    (let ((t0 (loader-text-has loader "a Loading...")))
      (cadr-tui:loader-component-step loader)
      (let ((t1 (loader-text-has loader "b Loading...")))
        (cadr-tui:loader-component-step loader)
        (list
         t0
         t1
         (loader-text-has loader "a Loading...")
         3)))))

