      "match"
      (if (equal hexes *cbor-roundtrip-hex*) 1 0))
     "roundtrip"
     (collect "protocol_cbor.roundtrip"
              (lambda ()
                (lambda ()
                  (protocol-cbor-roundtrip)))))))

