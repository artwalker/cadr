(defun bootstrap-auth-pairs-digest (options)
  (cadr-ai::octets-hex
   (cadr-ai::sha256-bytes
    (cadr-ai::utf8-octets
     (format nil "~{~A~^~%~}"
             (sort
              (mapcar
               (lambda (option)
                 (format nil "~A|~A"
                         (cadr-cli::provider-key
                          (cadr-cli::oauth-selector-option-id option))
                         (if (eq (cadr-cli::oauth-selector-option-auth-type
                                  option)
                                 :oauth)
                             "oauth"
                             "api_key")))
               options)
              #'string<))))))

