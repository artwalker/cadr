(defun run-core-rest-cancellation ()
  (let ((state (cadr-core:make-cancellation-state)))
    (let ((live (if (cadr-core:cancellation-aborted-p state) 0 1)))
      (cadr-core:abort-cancellation state)
      (let ((aborted (if (cadr-core:cancellation-aborted-p state) 1 0)))
        (cadr-core:set-cancellation-aborted-p state nil)
        (list
         live
         aborted
         (if (cadr-core:cancellation-aborted-p state) 0 1)
         (if (cadr-core:cancellation-predicate-aborted-p (lambda () t))
             1
             0))))))

(defun run-core-rest-redacted ()
  (let* ((text "keep-visible token=sk-live-abc extra=hunter2 done")
         (out (cadr-core:redact-secrets text '("sk-live-abc" "hunter2"))))
    (list
     (if (search "keep-visible" out) 1 0)
     (if (search "sk-live-abc" out) 0 1)
     (if (search "hunter2" out) 0 1)
     (if (search "[REDACTED]" out) 1 0))))

(defun run-core-rest-threads ()
  (let ((absent (cadr-core:stop-thread-for-cleanup nil))
        (current
          (cadr-core:stop-thread-for-cleanup sb-thread:*current-thread*)))
    (let* ((done
             (sb-thread:make-thread
              (lambda () :done)
              :name "cadr-core-rest-join"))
           (joined
             (progn
               (sb-thread:join-thread done)
               (cadr-core:stop-thread-for-cleanup done))))
      (list
       (if (eq absent :absent) 1 0)
       (if (eq current :current) 1 0)
       (if (eq joined :joined) 1 0)))))

(defun run-core-rest-cancellation-wait ()
  ;; Leftover sibling of Pair 322 abort-cancellation: wait-for-cancellation
  ;; timeout / predicate-aborted / already-aborted. Not abort as the timed
  ;; owner.
  (let* ((timeout-state (cadr-core:make-cancellation-state))
         (timeout
           (cadr-core:wait-for-cancellation timeout-state :timeout 0.0d0))
         (pred-state
           (cadr-core:make-cancellation-state
            :aborted-function (lambda () t)))
         (pred
           (cadr-core:wait-for-cancellation pred-state :timeout 0.1d0))
         (abort-state (cadr-core:make-cancellation-state)))
    (cadr-core:abort-cancellation abort-state)
    (let ((aborted
            (cadr-core:wait-for-cancellation abort-state :timeout 0.1d0)))
      (list
       (if (eq timeout :timeout) 1 0)
       (if (eq pred :aborted) 1 0)
       (if (eq aborted :aborted) 1 0)))))


(defun run-core-rest-redacted-types ()
  ;; Leftover sibling of Pair 323 redact-secrets: redacted-object-types
  ;; copy+sort. Not replace-all / redact-secrets.
  (let ((types (cadr-core:redacted-object-types)))
    (list
     (if (listp types) 1 0)
     (if (every #'symbolp types) 1 0)
     (if (equal types
                (sort (copy-list types) #'string< :key #'symbol-name))
         1
         0))))


(defun run-core-rest-threads-join ()
  ;; Leftover sibling of Pair 324 stop-thread-for-cleanup: required
  ;; result join with a non-empty reason. Not cleanup/terminate.
  (let* ((reason "goal20-core-rest-join")
         (worker
           (sb-thread:make-thread
            (lambda () 42)
            :name "cadr-core-rest-join-active"))
         (value
           (cadr-core:join-active-thread worker :reason reason)))
    (list
     (if (eql value 42) 1 0)
     (if (sb-thread:thread-alive-p worker) 0 1)
     (length reason))))


(defun run-core-rest-cancellation-make ()
  ;; Leftover sibling of Pair 322 abort / Pair 337 wait: constructor only.
  ;; Not abort-cancellation or wait-for-cancellation as the timed owner.
  (let ((state (cadr-core:make-cancellation-state))
        (with-pred
          (cadr-core:make-cancellation-state
           :aborted-function (lambda () nil))))
    (list
     (if (typep state 'cadr-core:cancellation-state) 1 0)
     (if (cadr-core:cancellation-aborted-p state) 0 1)
     (if (typep with-pred 'cadr-core:cancellation-state) 1 0))))


(defun run-core-rest-cancellation-aborted ()
  ;; Leftover sibling: cancellation-aborted-p as timed owner, not abort/wait.
  (let ((live (cadr-core:make-cancellation-state))
        (pred
          (cadr-core:make-cancellation-state
           :aborted-function (lambda () t)))
        (aborted (cadr-core:make-cancellation-state)))
    (cadr-core:set-cancellation-aborted-p aborted t)
    (list
     (if (cadr-core:cancellation-aborted-p live) 0 1)
     (if (cadr-core:cancellation-aborted-p pred) 1 0)
     (if (cadr-core:cancellation-aborted-p aborted) 1 0))))


(defun run-core-rest-cancellation-set ()
  ;; Leftover sibling: set-cancellation-aborted-p including clear.
  ;; Not abort-cancellation as the timed owner.
  (let ((state (cadr-core:make-cancellation-state)))
    (cadr-core:set-cancellation-aborted-p state t)
    (let ((set-ok (if (cadr-core:cancellation-aborted-p state) 1 0)))
      (cadr-core:set-cancellation-aborted-p state nil)
      (list
       set-ok
       (if (cadr-core:cancellation-aborted-p state) 0 1)
       1))))


(defun run-core-rest-cancellation-predicate ()
  ;; Leftover sibling of Pair 322 abort / Pair 361 make: the predicate
  ;; helper as timed owner. Not abort-cancellation, wait, or aborted-p
  ;; on a cancellation-state.
  (list
   (if (cadr-core:cancellation-predicate-aborted-p nil) 0 1)
   (if (cadr-core:cancellation-predicate-aborted-p (lambda () t)) 1 0)
   (if (cadr-core:cancellation-predicate-aborted-p (lambda () nil)) 0 1)
   (if (cadr-core:cancellation-predicate-aborted-p
        (lambda () (error "cadr-core-rest-predicate")))
       0
       1)))


(defun run-core-rest-redacted-register ()
  ;; Leftover sibling of Pair 323 secrets / Pair 338 types: unexported
  ;; register-redacted-object-type as timed owner. Bind the registry
  ;; so production types stay untouched.
  (let ((cadr-core::*redacted-object-types* nil))
    (let ((first
            (cadr-core::register-redacted-object-type
             'cadr-core::goal20-redacted-a)))
      (cadr-core::register-redacted-object-type
       'cadr-core::goal20-redacted-a)
      (cadr-core::register-redacted-object-type
       'cadr-core::goal20-redacted-b)
      (let ((names
              (mapcar #'symbol-name cadr-core::*redacted-object-types*)))
        (list
         (if (eq first 'cadr-core::goal20-redacted-a) 1 0)
         (if (= (length names) 2) 1 0)
         (if (equal
              (sort (copy-list names) #'string<)
              '("GOAL20-REDACTED-A" "GOAL20-REDACTED-B"))
             1
             0))))))


(defun run-core-rest-redacted-replace ()
  ;; Leftover sibling of Pair 323 redact-secrets: unexported replace-all
  ;; as timed owner. One needle, empty needle, miss.
  (let* ((source "keep-visible token=sk-live-abc extra")
         (hit (cadr-core::replace-all source "sk-live-abc" "[REDACTED]"))
         (miss (cadr-core::replace-all "keep-visible" "zzz" "[REDACTED]"))
         (empty (cadr-core::replace-all source "" "[REDACTED]")))
    (list
     (if (search "sk-live-abc" hit) 0 1)
     (if (search "[REDACTED]" hit) 1 0)
     (if (string= miss "keep-visible") 1 0)
     (if (eq empty source) 1 0))))


