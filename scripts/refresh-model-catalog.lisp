#!/usr/bin/env -S sbcl --script

(require :asdf)

(let ((setup
        (or (uiop:getenv "QUICKLISP_SETUP")
            (namestring
             (merge-pathnames "quicklisp/setup.lisp"
                              (user-homedir-pathname))))))
  (unless (probe-file setup)
    (error "Quicklisp setup not found: ~A" setup))
  (load setup))

(asdf:load-asd
 (truename
  (merge-pathnames
   "../pi-ai.asd"
   (uiop:pathname-directory-pathname
    *load-truename*))))
(asdf:load-system "pi-ai")

(defparameter *source-url* "https://models.dev/api.json")
(defparameter *selections*
  '((:anthropic "anthropic" "claude-opus-4-8")
    (:openai "openai" "gpt-5.5")
    (:google "google" "gemini-3.6-flash")
    (:deepseek "deepseek" "deepseek-v4-flash")
    (:deepseek "deepseek" "deepseek-v4-pro")))

(defun json-get (object key &optional default)
  (if (hash-table-p object)
      (gethash key object default)
      default))

(defun number-or-zero (value)
  (if (numberp value)
      (coerce value 'double-float)
      0d0))

(defun image-input-p (model)
  (let* ((modalities (json-get model "modalities"))
         (input (json-get modalities "input")))
    (and (vectorp input)
         (find "image" input :test #'string=)
         t)))

(defun model-row (catalog selection)
  (destructuring-bind (provider provider-key model-id)
      selection
    (let* ((provider-data (json-get catalog provider-key))
           (models (json-get provider-data "models"))
           (model (json-get models model-id))
           (limit (json-get model "limit"))
           (cost (json-get model "cost")))
      (unless (hash-table-p model)
        (error "Missing ~A/~A in ~A"
               provider-key model-id *source-url*))
      (list
       :provider provider
       :id model-id
       :context-window (or (json-get limit "context") 0)
       :max-output-tokens (or (json-get limit "output") 4096)
       :supports-images-p (image-input-p model)
       :supports-tools-p (eq t (json-get model "tool_call"))
       :reasoning-p (eq t (json-get model "reasoning"))
       :input-price (number-or-zero (json-get cost "input"))
       :output-price (number-or-zero (json-get cost "output"))
       :cache-read-price
       (number-or-zero (json-get cost "cache_read"))
       :cache-write-price
       (number-or-zero (json-get cost "cache_write"))))))

(defun generated-path ()
  (let* ((script (truename *load-truename*))
         (root (uiop:pathname-parent-directory-pathname
                (uiop:pathname-directory-pathname script))))
    (merge-pathnames "src/pi-ai/models.generated.lisp" root)))

(multiple-value-bind (body status)
    (pi-ai::native-http-request
     *source-url*
     :connect-timeout 10
     :read-timeout 60
     :force-string t)
  (unless (<= 200 status 299)
    (error "Model catalog source returned HTTP ~D" status))
  (let* ((catalog
           (pi-ai::parse-json body))
         (rows
           (append
            (mapcar (lambda (selection)
                      (model-row catalog selection))
                    *selections*)
            (list
             '(:provider :ollama
               :id "gpt-oss:20b"
               :context-window 131072
               :max-output-tokens 32768
               :supports-images-p nil
               :supports-tools-p t
               :reasoning-p t
               :input-price 0d0
               :output-price 0d0
               :cache-read-price 0d0
               :cache-write-price 0d0))))
         (target (generated-path))
         (*print-pretty* t)
         (*print-right-margin* 88))
    (with-open-file
        (stream target
                :direction :output
                :if-exists :supersede
                :if-does-not-exist :create
                :external-format :utf-8)
      (format stream
              ";; Generated by scripts/refresh-model-catalog.lisp from ~A.~%;; Runtime use is offline and deterministic.~%(in-package #:pi-ai)~%~%"
              *source-url*)
      (write-string
       "(defparameter *generated-model-metadata* '" stream)
      (pprint rows stream)
      (write-string ")"
                    stream)
      (terpri stream)
      (terpri stream)
      (write-line
       "(register-generated-models *generated-model-metadata*)"
       stream))
    (format t "Updated ~A with ~D models.~%"
            (namestring target) (length rows))))
