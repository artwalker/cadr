  },
  {
   "id": "lisp_extension_host",
   "path": "Lisp extension host (load, compile, dispatch)",
   "reason": "Baseline extensions are JavaScript modules; the input artifact differs, so same-fixture-bytes pairing is impossible. Observable wire events stay on event-diff."
  },
  {
   "id": "tool_failure_restarts",
   "path": "Tool-failure restarts and :tool-call-error",
   "reason": "Approved Lisp-native addition (Goal 10 D1) with no baseline path. The default tool-execution path is still pairable and is not covered yet."
  },
  {
   "id": "fatal_condition_summary",
   "path": "Redacted fatal-condition summary and 0600 crash log",
   "reason": "Approved Goal 13 divergence: the baseline prints a terminal stack dump. The two do different work by design."
  },
  {
   "id": "native_image_cold_start",
   "path": "SBCL native-image build and process cold start",
   "reason": "An image start against a Node bundle start measures the two runtimes, not cadr vs baseline code. Cold start keeps its own absolute ceiling."
  },
  {
   "id": "oauth_success_page_mark",
   "path": "OAuth success/failure page mark",
   "reason": "Branding-only difference (cons-cell grid instead of the baseline logo)."
  },
  {
   "id": "live_provider_socket",
   "path": "Live-credential provider calls",
   "reason": "A network call is not a fixture. stream_roundtrip covers deterministic assembly and parse; the live path stays credential-gated."
  },
  {
   "id": "asdf_quicklisp_build",
