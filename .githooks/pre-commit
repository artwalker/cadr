#!/usr/bin/env bash
# Optional local hook: compile-check staged src/ changes before commit.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! git diff --cached --name-only --diff-filter=ACMR | grep -q '^src/'; then
	exit 0
fi

echo "pre-commit: staged src/ changes; running scripts/cadr-compile-check.sh"
"$ROOT/scripts/cadr-compile-check.sh" --project-directory "$ROOT"
