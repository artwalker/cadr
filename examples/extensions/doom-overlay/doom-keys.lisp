(defconstant +doom-key-right-arrow+ #xae)
(defconstant +doom-key-left-arrow+ #xac)
(defconstant +doom-key-up-arrow+ #xad)
(defconstant +doom-key-down-arrow+ #xaf)
(defconstant +doom-key-strafe-left+ #xa0)
(defconstant +doom-key-strafe-right+ #xa1)
(defconstant +doom-key-use+ #xa2)
(defconstant +doom-key-fire+ #xa3)
(defconstant +doom-key-escape+ 27)
(defconstant +doom-key-enter+ 13)
(defconstant +doom-key-tab+ 9)
(defconstant +doom-key-f1+ (+ #x80 #x3b))
(defconstant +doom-key-f2+ (+ #x80 #x3c))
(defconstant +doom-key-f3+ (+ #x80 #x3d))
(defconstant +doom-key-f4+ (+ #x80 #x3e))
(defconstant +doom-key-f5+ (+ #x80 #x3f))
(defconstant +doom-key-f6+ (+ #x80 #x40))
(defconstant +doom-key-f7+ (+ #x80 #x41))
(defconstant +doom-key-f8+ (+ #x80 #x42))
(defconstant +doom-key-f9+ (+ #x80 #x43))
(defconstant +doom-key-f10+ (+ #x80 #x44))
(defconstant +doom-key-f11+ (+ #x80 #x57))
(defconstant +doom-key-f12+ (+ #x80 #x58))
(defconstant +doom-key-backspace+ 127)
(defconstant +doom-key-pause+ #xff)
(defconstant +doom-key-equals+ #x3d)
(defconstant +doom-key-minus+ #x2d)
(defconstant +doom-key-right-shift+ (+ #x80 #x36))
(defconstant +doom-key-right-control+ (+ #x80 #x1d))
(defconstant +doom-key-right-alt+ (+ #x80 #x38))

(defun map-key-to-doom (data)
  (let ((key (cadr-tui:parse-key data)))
    (cond
      ((equal key "up") (list +doom-key-up-arrow+))
      ((equal key "down") (list +doom-key-down-arrow+))
      ((equal key "right") (list +doom-key-right-arrow+))
      ((equal key "left") (list +doom-key-left-arrow+))
      ((equal key "w") (list +doom-key-up-arrow+))
      ((or (string= data "W") (equal key "shift+w"))
       (list +doom-key-up-arrow+ +doom-key-right-shift+))
      ((equal key "s") (list +doom-key-down-arrow+))
      ((or (string= data "S") (equal key "shift+s"))
       (list +doom-key-down-arrow+ +doom-key-right-shift+))
      ((equal key "a") (list +doom-key-strafe-left+))
      ((or (string= data "A") (equal key "shift+a"))
       (list +doom-key-strafe-left+ +doom-key-right-shift+))
      ((equal key "d") (list +doom-key-strafe-right+))
      ((or (string= data "D") (equal key "shift+d"))
       (list +doom-key-strafe-right+ +doom-key-right-shift+))
      ((or (member data '("f" "F") :test #'string=)
           (member key '("f" "shift+f") :test #'string=))
       (list +doom-key-fire+))
      ((equal key "space") (list +doom-key-use+))
      ((equal key "enter") (list +doom-key-enter+))
      ((equal key "escape") (list +doom-key-escape+))
      ((equal key "tab") (list +doom-key-tab+))
      ((equal key "backspace") (list +doom-key-backspace+))
      ((and key
            (uiop:string-prefix-p "ctrl+" key)
            (not (string= key "ctrl+c")))
       (list +doom-key-fire+))
      ((and (= (length data) 1)
            (< (char-code (char data 0)) 32)
            (not (char= (char data 0) (code-char 3))))
       (list +doom-key-fire+))
      ((and key (= (length key) 1) (digit-char-p (char key 0)))
       (list (char-code (char key 0))))
      ((member key '("+" "=") :test #'string=)
       (list +doom-key-equals+))
      ((equal key "-") (list +doom-key-minus+))
      ((or (member data '("y" "Y") :test #'string=)
           (member key '("y" "shift+y") :test #'string=))
       (list (char-code #\y)))
      ((or (member data '("n" "N") :test #'string=)
           (member key '("n" "shift+n") :test #'string=))
       (list (char-code #\n)))
      ((and key (= (length key) 1)
            (>= (char-code (char key 0)) 32))
       (list (char-code (char-downcase (char key 0)))))
      ((and (= (length data) 1)
            (>= (char-code (char data 0)) 32))
       (list (char-code (char-downcase (char data 0)))))
      (t nil))))
