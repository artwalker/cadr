;;; v1.4.0 easter-egg-3d.ts frame, dissolve, and the fullscreen play entry.
(in-package #:cadr-cli)

(defun egg-render-halo (raster strength)
  (let ((cells (egg-raster-dirty raster)))
    (unless cells
      (return-from egg-render-halo nil))
    (destructuring-bind (cell-min-x cell-min-y cell-max-x cell-max-y) cells
      (let* ((width (egg-raster-width raster))
             (height (egg-raster-height raster))
             (counts (egg-raster-counts raster))
             (rgb (egg-raster-rgb raster))
             (min-x (max 0 (- cell-min-x +egg-halo-radius-x+)))
             (max-x (min (1- width) (+ cell-max-x +egg-halo-radius-x+)))
             (min-y (max 0 (- cell-min-y +egg-halo-radius-y+)))
             (max-y (min (1- height) (+ cell-max-y +egg-halo-radius-y+)))
             (region-width (1+ (- max-x min-x)))
             (weights-x
               (let* ((radius +egg-halo-radius-x+)
                      (raw (loop for index to (* radius 2)
                                 collect (- (1+ radius) (abs (- index radius)))))
                      (total (reduce #'+ raw)))
                 (mapcar (lambda (weight) (/ (float weight 1d0) total)) raw)))
             (weights-y
               (let* ((radius +egg-halo-radius-y+)
                      (raw (loop for index to (* radius 2)
                                 collect (- (1+ radius) (abs (- index radius)))))
                      (total (reduce #'+ raw)))
                 (mapcar (lambda (weight) (/ (float weight 1d0) total)) raw)))
             (rows (1+ (- cell-max-y cell-min-y)))
             (horizontal
               (make-array (* rows region-width 4)
                           :element-type 'single-float
                           :initial-element 0f0)))
        (loop for y from cell-min-y to cell-max-y
              do (loop for x from min-x to max-x
                       do (let ((coverage 0d0) (red 0d0) (green 0d0) (blue 0d0))
                            (loop for dx from (- +egg-halo-radius-x+) to +egg-halo-radius-x+
                                  for source-x = (+ x dx)
                                  when (<= cell-min-x source-x cell-max-x)
                                    do (let* ((source (+ (* y width) source-x))
                                              (count (aref counts source)))
                                         (when (plusp count)
                                           (let ((weight
                                                   (/ (nth (+ dx +egg-halo-radius-x+) weights-x)
                                                      8d0)))
                                             (incf coverage (* count weight))
                                             (incf red (* (float (aref rgb (* source 3)) 1d0) weight))
                                             (incf green (* (float (aref rgb (+ (* source 3) 1)) 1d0) weight))
                                             (incf blue (* (float (aref rgb (+ (* source 3) 2)) 1d0) weight))))))
                            (let ((target (* (+ (* (- y cell-min-y) region-width)
                                                (- x min-x))
                                             4)))
                              (setf (aref horizontal target) (egg-f32 coverage)
                                    (aref horizontal (+ target 1)) (egg-f32 red)
                                    (aref horizontal (+ target 2)) (egg-f32 green)
                                    (aref horizontal (+ target 3)) (egg-f32 blue))))))
        (loop for y from min-y to max-y
              do (loop for x from min-x to max-x
                       do (let ((coverage 0d0) (red 0d0) (green 0d0) (blue 0d0))
                            (loop for dy from (- +egg-halo-radius-y+) to +egg-halo-radius-y+
                                  for source-y = (+ y dy)
                                  when (<= cell-min-y source-y cell-max-y)
                                    do (let* ((weight (nth (+ dy +egg-halo-radius-y+) weights-y))
                                              (source (* (+ (* (- source-y cell-min-y) region-width)
                                                            (- x min-x))
                                                         4)))
                                         (incf coverage (* (float (aref horizontal source) 1d0) weight))
                                         (incf red (* (float (aref horizontal (+ source 1)) 1d0) weight))
                                         (incf green (* (float (aref horizontal (+ source 2)) 1d0) weight))
                                         (incf blue (* (float (aref horizontal (+ source 3)) 1d0) weight))))
                            (let* ((target (+ (* y width) x))
                                   (count (aref counts target)))
                              (when (and (plusp count) (> (/ count 8d0) coverage))
                                (setf coverage (/ count 8d0)
                                      red (* (/ (float (aref rgb (* target 3)) 1d0) count) coverage)
                                      green (* (/ (float (aref rgb (+ (* target 3) 1)) 1d0) count) coverage)
                                      blue (* (/ (float (aref rgb (+ (* target 3) 2)) 1d0) count) coverage)))
                              (when (plusp coverage)
                                (let ((amount
                                        (/ (egg-js-round
                                            (* strength
                                               (expt (min 1d0 coverage) 0.7d0)
                                               +egg-halo-levels+))
                                           +egg-halo-levels+)))
                                  (when (plusp amount)
                                    (setf (aref (egg-raster-halo-amount raster) target)
                                          (egg-f32 amount)
                                          (aref (egg-raster-halo-rgb raster) (* target 3))
                                          (egg-f32 (* (egg-js-round (/ red coverage +egg-logo-color-step+))
                                                      +egg-logo-color-step+))
                                          (aref (egg-raster-halo-rgb raster) (+ (* target 3) 1))
                                          (egg-f32 (* (egg-js-round (/ green coverage +egg-logo-color-step+))
                                                      +egg-logo-color-step+))
                                          (aref (egg-raster-halo-rgb raster) (+ (* target 3) 2))
                                          (egg-f32 (* (egg-js-round (/ blue coverage +egg-logo-color-step+))
                                                      +egg-logo-color-step+))))))))))
        (setf (egg-raster-halo-dirty raster) (list min-x min-y max-x max-y))))))

(defun egg-render-raster (raster width height pose boxes background halo-strength)
  (egg-ensure-raster raster width height)
  (let* ((dot-width (* width 2))
         (dot-height (* height 4))
         (matrix (egg-rotation (getf pose :yaw) (getf pose :pitch) (getf pose :roll)))
         (scale (getf pose :scale))
         (center-x (getf pose :center-x))
         (center-y (getf pose :center-y))
         (camera (egg-raster-camera-distance raster))
         (origin (list (* (aref matrix 6) camera)
                       (* (aref matrix 7) camera)
                       (* (aref matrix 8) camera)))
         (light (egg-light-p background))
         (faces (egg-visible-faces raster matrix origin pose boxes
                                   dot-width dot-height light)))
    (when faces
      (let ((min-x dot-width) (min-y dot-height) (max-x -1) (max-y -1))
        (dolist (face faces)
          (setf min-x (min min-x (egg-face-min-x face))
                min-y (min min-y (egg-face-min-y face))
                max-x (max max-x (egg-face-max-x face))
                max-y (max max-y (egg-face-max-y face))))
        (when (and (>= max-x min-x) (>= max-y min-y))
          (let ((depth (egg-raster-depth raster))
                (face-ids (egg-raster-face-ids raster)))
            (loop for face-index from 0
                  for face in faces
                  do (let* ((axis (egg-face-axis face))
                            (u (mod (1+ axis) 3))
                            (v (mod (+ axis 2) 3))
                            (origin-a (nth axis origin))
                            (origin-u (nth u origin))
                            (origin-v (nth v origin))
                            (step-a (/ (aref matrix axis) scale))
                            (step-u (/ (aref matrix u) scale))
                            (step-v (/ (aref matrix v) scale))
                            (sx (/ (- (+ (egg-face-min-x face) 0.5d0) center-x) scale)))
                       (loop for dot-y from (egg-face-min-y face) to (egg-face-max-y face)
                             for sy = (/ (- (+ dot-y 0.5d0) center-y) scale)
                             for direction-a = (+ (* (aref matrix axis) sx)
                                                  (* (aref matrix (+ 3 axis)) sy)
                                                  (* (aref matrix (+ 6 axis)) (- camera)))
                             for direction-u = (+ (* (aref matrix u) sx)
                                                  (* (aref matrix (+ 3 u)) sy)
                                                  (* (aref matrix (+ 6 u)) (- camera)))
                             for direction-v = (+ (* (aref matrix v) sx)
                                                  (* (aref matrix (+ 3 v)) sy)
                                                  (* (aref matrix (+ 6 v)) (- camera)))
                             do (loop for dot-x from (egg-face-min-x face) to (egg-face-max-x face)
                                      for index = (+ (* dot-y dot-width) dot-x)
                                      for stored = (float (aref depth index) 1d0)
                                      for tee = (if (zerop direction-a)
                                                    nil
                                                    (/ (- (egg-face-plane face) origin-a)
                                                       direction-a))
                                      do (when (and tee (plusp tee) (< tee stored))
                                           (let ((hit-u (+ origin-u (* tee direction-u)))
                                                 (hit-v (+ origin-v (* tee direction-v))))
                                             (when (and (<= (egg-face-u-min face) hit-u (egg-face-u-max face))
                                                        (<= (egg-face-v-min face) hit-v (egg-face-v-max face)))
                                               (setf (aref depth index) (egg-f32 tee)
                                                     (aref face-ids index) (1+ face-index)))))
                                         (incf direction-a step-a)
                                         (incf direction-u step-u)
                                         (incf direction-v step-v)))))
            (let ((bits (egg-raster-bits raster))
                  (counts (egg-raster-counts raster))
                  (rgb (egg-raster-rgb raster))
                  (cell-min-x width) (cell-min-y height)
                  (cell-max-x -1) (cell-max-y -1))
              (loop for dot-y from min-y to max-y
                    do (loop for dot-x from min-x to max-x
                             for index = (+ (* dot-y dot-width) dot-x)
                             for id = (aref face-ids index)
                             when (plusp id)
                               do (let* ((face (nth (1- id) faces))
                                         (fog (* (egg-clamp01
                                                  (- 0.15d0
                                                     (* camera
                                                        (- 1d0 (float (aref depth index) 1d0))
                                                        0.12d0)))
                                                 (if light 0.5d0 1d0)))
                                         (cell-x (ash dot-x -1))
                                         (cell-y (ash dot-y -2))
                                         (cell (+ (* cell-y width) cell-x)))
                                    (setf (aref face-ids index) 0
                                          (aref depth index) most-positive-single-float)
                                    (setf (aref bits cell)
                                          (logior (aref bits cell)
                                                  (aref +egg-dot-bits+
                                                        (+ (* (logand dot-y 3) 2)
                                                           (logand dot-x 1))))
                                          (aref counts cell) (1+ (aref counts cell)))
                                    (setf (aref rgb (* cell 3))
                                          (egg-f32 (+ (float (aref rgb (* cell 3)) 1d0)
                                                      (+ (egg-face-red face)
                                                         (* (- (first background) (egg-face-red face)) fog))))
                                          (aref rgb (+ (* cell 3) 1))
                                          (egg-f32 (+ (float (aref rgb (+ (* cell 3) 1)) 1d0)
                                                      (+ (egg-face-green face)
                                                         (* (- (second background) (egg-face-green face)) fog))))
                                          (aref rgb (+ (* cell 3) 2))
                                          (egg-f32 (+ (float (aref rgb (+ (* cell 3) 2)) 1d0)
                                                      (+ (egg-face-blue face)
                                                         (* (- (third background) (egg-face-blue face)) fog)))))
                                    (setf cell-min-x (min cell-min-x cell-x)
                                          cell-max-x (max cell-max-x cell-x)
                                          cell-min-y (min cell-min-y cell-y)
                                          cell-max-y (max cell-max-y cell-y)))))
              (when (>= cell-max-x 0)
                (setf (egg-raster-dirty raster)
                      (list cell-min-x cell-min-y cell-max-x cell-max-y)))
              (when (plusp halo-strength)
                (egg-render-halo raster halo-strength)))))))))

(defun egg-apply-sgr (params fg bg dim inverse)
  (let ((codes (if (string= params "") '("0")
                   (uiop:split-string params :separator '(#\;)))))
    (loop for index from 0 below (length codes)
          do (let* ((parts (uiop:split-string (nth index codes) :separator '(#\:)))
                    (code (or (parse-integer (first parts) :junk-allowed t) 0)))
               (cond ((or (= code 38) (= code 48))
                      (let ((args
                              (if (> (length parts) 1)
                                  (loop for part in (rest parts)
                                        for value = (parse-integer part :junk-allowed t)
                                        when value collect value)
                                  (let* ((kind (parse-integer (or (nth (1+ index) codes) "")
                                                              :junk-allowed t))
                                         (count (cond ((eql kind 5) 2)
                                                      ((eql kind 2) 4)
                                                      (t 1))))
                                    (prog1
                                        (loop for part in (subseq codes (1+ index)
                                                                  (min (length codes)
                                                                       (+ index 1 count)))
                                              collect (parse-integer part :junk-allowed t))
                                      (incf index count))))))
                        (let ((color
                                (cond ((and args (eql (first args) 5) (second args))
                                       (egg-indexed-rgb (second args)))
                                      ((and args (eql (first args) 2) (>= (length args) 4))
                                       (list (float (second args) 1d0)
                                             (float (third args) 1d0)
                                             (float (fourth args) 1d0))))))
                          (when color
                            (if (= code 38) (setf fg color) (setf bg color))))))
                     ((= code 0) (setf fg nil bg nil dim nil inverse nil))
                     ((= code 2) (setf dim t))
                     ((= code 22) (setf dim nil))
                     ((= code 7) (setf inverse t))
                     ((= code 27) (setf inverse nil))
                     ((<= 30 code 37) (setf fg (egg-indexed-rgb (- code 30))))
                     ((<= 90 code 97) (setf fg (egg-indexed-rgb (+ (- code 90) 8))))
                     ((= code 39) (setf fg nil))
                     ((<= 40 code 47) (setf bg (egg-indexed-rgb (- code 40))))
                     ((<= 100 code 107) (setf bg (egg-indexed-rgb (+ (- code 100) 8))))
                     ((= code 49) (setf bg nil)))))
    (values fg bg dim inverse)))

(defun egg-parse-line (line width foreground background)
  (let ((cells nil)
        (fg nil)
        (bg nil)
        (dim nil)
        (inverse nil)
        (index 0))
    (labels ((push-text (text)
               (dolist (segment (cadr-tui:grapheme-clusters text))
                 (let ((glyph-width (cadr-tui:visible-width segment)))
                   (when (and (plusp glyph-width)
                              (<= (+ (length cells) glyph-width) width))
                     (let* ((cell-fg (or fg foreground))
                            (cell-bg bg))
                       (when inverse
                         (setf cell-fg (or bg background)
                               cell-bg (or fg foreground)))
                       (when dim
                         (setf cell-fg (egg-mix cell-fg (or cell-bg background) 0.4d0)))
                       (push (make-egg-cell :text segment :width glyph-width
                                            :fg cell-fg :bg cell-bg)
                             cells)
                       (when (= glyph-width 2)
                         (push (make-egg-cell :text "" :width 0
                                              :fg cell-fg :bg cell-bg)
                               cells))))))))
      (loop while (< index (length line))
            for sequence = (position #\Escape line :start index)
            do (cond ((null sequence)
                      (push-text (subseq line index))
                      (setf index (length line)))
                     (t
                      (when (> sequence index)
                        (push-text (subseq line index sequence)))
                      (let ((kind (when (< (1+ sequence) (length line))
                                    (char line (1+ sequence)))))
                        (cond ((eql kind #\[)
                               (let ((end (+ sequence 2)))
                                 (loop while (and (< end (length line))
                                                  (or (< (char-code (char line end)) #x40)
                                                      (> (char-code (char line end)) #x7e)))
                                       do (incf end))
                                 (when (and (< end (length line)) (eql (char line end) #\m))
                                   (multiple-value-setq (fg bg dim inverse)
                                     (egg-apply-sgr (subseq line (+ sequence 2) end)
                                                    fg bg dim inverse)))
                                 (setf index (1+ end))))
                              ((member kind '(#\] #\_ #\P #\^))
                               (let ((bell (position (code-char 7) line :start (+ sequence 2)))
                                     (st (search (format nil "~C\\" #\Escape) line
                                                 :start2 (+ sequence 2))))
                                 (if (and (null bell) (null st))
                                     (setf index (length line))
                                     (setf index
                                           (if (and bell (or (null st) (< bell st)))
                                               (1+ bell)
                                               (+ st 2))))))
                              (t (setf index (+ sequence 2)))))))))
    (nreverse cells)))

(defun egg-parse-screen (lines width foreground background)
  (mapcar (lambda (line)
            (egg-parse-line line width foreground background))
          lines))
