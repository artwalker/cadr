(in-package #:cadr-wasm)

(defun wasi-sig (params results)
  (cons (coerce params 'vector) (coerce results 'vector)))

(defun wasi-memory ()
  (aref (wasm-instance-memories *wasm-instance*) 0))

(defun wasi-store-u32 (address value)
  (store-le (wasi-memory) address 0 4 value))

(defun wasi-store-u64 (address value)
  (store-le (wasi-memory) address 0 8 value))

(defun wasi-load-u32 (address)
  (load-le (wasi-memory) address 0 4))

(defun make-wasi-imports (&key (clock nil) (random-bytes nil) discard-output)
  "WASI preview1 subset used by quickjs-wasi 3.6.2.

clock and random replace the host clock and byte source. discard-output
keeps the fd_write byte count and drops the text, which the codemode host
does on top of this shim."
  (let ((table (make-hash-table :test #'equal))
        (clock (or clock (lambda ()
                           (* (floor (get-internal-real-time)
                                     (/ internal-time-units-per-second 1000))
                              1000000)))))
    (flet ((bind (name sig function)
             (setf (gethash (cons "wasi_snapshot_preview1" name) table)
                   (make-wasm-extern :kind :func :value function :type sig))))
      (bind "clock_time_get" (wasi-sig '(:i32 :i64 :i32) '(:i32))
            (lambda (clock-id precision result)
              (declare (ignore precision))
              (if (or (= (i32 clock-id) 0) (= (i32 clock-id) 1))
                  (progn (wasi-store-u64 result (funcall clock)) 0)
                  52)))
      (bind "fd_write" (wasi-sig '(:i32 :i32 :i32 :i32) '(:i32))
            (lambda (fd iovs count result)
              (if (or (= (i32 fd) 1) (= (i32 fd) 2))
                  (let ((written 0)
                        (stream (if (= (i32 fd) 1) *standard-output* *error-output*)))
                    (dotimes (index (i32 count))
                      (let* ((base (+ (i32 iovs) (* index 8)))
                             (buffer (wasi-load-u32 base))
                             (length (wasi-load-u32 (+ base 4))))
                        (unless discard-output
                          (write-string (map 'string #'code-char
                                             (subseq (wasm-memory-bytes (wasi-memory))
                                                     buffer (+ buffer length)))
                                        stream))
                        (incf written length)))
                    (wasi-store-u32 result written)
                    0)
                  8)))
      (bind "fd_close" (wasi-sig '(:i32) '(:i32))
            (lambda (fd) (declare (ignore fd)) 52))
      (bind "fd_fdstat_get" (wasi-sig '(:i32 :i32) '(:i32))
            (lambda (fd stat)
              (if (or (= (i32 fd) 1) (= (i32 fd) 2))
                  (let ((bytes (wasm-memory-bytes (wasi-memory))))
                    (setf (aref bytes (i32 stat)) 2)
                    (setf (aref bytes (+ (i32 stat) 2)) 0
                          (aref bytes (+ (i32 stat) 3)) 0)
                    (store-le (wasi-memory) (+ (i32 stat) 8) 0 8 0)
                    (store-le (wasi-memory) (+ (i32 stat) 16) 0 8 0)
                    0)
                  8)))
      (bind "fd_seek" (wasi-sig '(:i32 :i64 :i32 :i32) '(:i32))
            (lambda (fd offset whence result)
              (declare (ignore fd offset whence result))
              52))
      (bind "random_get" (wasi-sig '(:i32 :i32) '(:i32))
            (lambda (buffer length)
              (let ((bytes (wasm-memory-bytes (wasi-memory)))
                    (source (or random-bytes
                                (lambda (count)
                                  (let ((out (make-array count :element-type '(unsigned-byte 8))))
                                    (dotimes (i count out)
                                      (setf (aref out i) (cl:random 256))))))))
                (let ((fill (funcall source (i32 length))))
                  (replace bytes fill :start1 (i32 buffer)))
                0))))
    table))
