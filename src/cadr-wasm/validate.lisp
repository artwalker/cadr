(in-package #:cadr-wasm)

(defun invalid (message)
  (wasm-fail 'wasm-invalid message))

(defstruct vframe
  height
  unreachable
  label-types
  result-types
  param-types
  kind
  saw-else)

(defun sig-params (sig) (car sig))
(defun sig-results (sig) (cdr sig))

(defun type-at (module index)
  (let ((types (wasm-module-types module)))
    (unless (< index (length types))
      (invalid (format nil "unknown type ~A" index)))
    (aref types index)))

(defun check-limits (min max kind)
  (when (and max (> min max))
    (invalid "size minimum must not be greater than maximum"))
  (when (eq kind :memory)
    (when (or (> min 65536) (and max (> max 65536)))
      (invalid "memory size must be at most 65536 pages (4GiB)")))
  (when (eq kind :table)
    (when (or (> min #xffffffff) (and max (> max #xffffffff)))
      (invalid "table size must be at most 2^32-1"))))

(defun numeric-p (type)
  (member type '(:i32 :i64 :f32 :f64 :v128)))

(defun ref-p (type)
  (member type '(:funcref :externref)))

(defun natural-align (op)
  (case op
    ((:i32.load :f32.load :i64.load32-s :i64.load32-u :i32.store :f32.store
      :i64.store32)
     2)
    ((:i64.load :f64.load :i64.store :f64.store) 3)
    ((:i32.load16-s :i32.load16-u :i64.load16-s :i64.load16-u :i32.store16
      :i64.store16)
     1)
    (t 0)))

(defun memory-op-p (op)
  (member op '(:i32.load :i64.load :f32.load :f64.load :i32.load8-s :i32.load8-u
               :i32.load16-s :i32.load16-u :i64.load8-s :i64.load8-u
               :i64.load16-s :i64.load16-u :i64.load32-s :i64.load32-u
               :i32.store :i64.store :f32.store :f64.store :i32.store8
               :i32.store16 :i64.store8 :i64.store16 :i64.store32
               :memory.size :memory.grow :memory.copy :memory.fill :memory.init)))

(defun load-result (op)
  (case op
    ((:i32.load :i32.load8-s :i32.load8-u :i32.load16-s :i32.load16-u) :i32)
    ((:i64.load :i64.load8-s :i64.load8-u :i64.load16-s :i64.load16-u
      :i64.load32-s :i64.load32-u)
     :i64)
    (:f32.load :f32)
    (:f64.load :f64)))

(defun stored-type (op)
  (case op
    ((:i32.store :i32.store8 :i32.store16) :i32)
    ((:i64.store :i64.store8 :i64.store16 :i64.store32) :i64)
    (:f32.store :f32)
    (:f64.store :f64)))

(defun unary-type (op)
  (cond ((member op '(:i32.eqz :i32.clz :i32.ctz :i32.popcnt :i32.extend8-s
                      :i32.extend16-s))
         (cons :i32 :i32))
        ((member op '(:i64.eqz :i64.clz :i64.ctz :i64.popcnt :i64.extend8-s
                      :i64.extend16-s :i64.extend32-s))
         (cons :i64 (if (eq op :i64.eqz) :i32 :i64)))
        ((member op '(:f32.abs :f32.neg :f32.ceil :f32.floor :f32.trunc
                      :f32.nearest :f32.sqrt))
         (cons :f32 :f32))
        ((member op '(:f64.abs :f64.neg :f64.ceil :f64.floor :f64.trunc
                      :f64.nearest :f64.sqrt))
         (cons :f64 :f64))
        ((member op '(:i32.wrap-i64)) (cons :i64 :i32))
        ((member op '(:i32.trunc-f32-s :i32.trunc-f32-u :i32.trunc-sat-f32-s
                      :i32.trunc-sat-f32-u :i32.reinterpret-f32))
         (cons :f32 :i32))
        ((member op '(:i32.trunc-f64-s :i32.trunc-f64-u :i32.trunc-sat-f64-s
                      :i32.trunc-sat-f64-u))
         (cons :f64 :i32))
        ((member op '(:i64.extend-i32-s :i64.extend-i32-u)) (cons :i32 :i64))
        ((member op '(:i64.trunc-f32-s :i64.trunc-f32-u :i64.trunc-sat-f32-s
                      :i64.trunc-sat-f32-u))
         (cons :f32 :i64))
        ((member op '(:i64.trunc-f64-s :i64.trunc-f64-u :i64.trunc-sat-f64-s
                      :i64.trunc-sat-f64-u :i64.reinterpret-f64))
         (cons :f64 :i64))
        ((member op '(:f32.convert-i32-s :f32.convert-i32-u :f32.reinterpret-i32))
         (cons :i32 :f32))
        ((member op '(:f32.convert-i64-s :f32.convert-i64-u)) (cons :i64 :f32))
        ((eq op :f32.demote-f64) (cons :f64 :f32))
        ((member op '(:f64.convert-i32-s :f64.convert-i32-u)) (cons :i32 :f64))
        ((member op '(:f64.convert-i64-s :f64.convert-i64-u :f64.reinterpret-i64))
         (cons :i64 :f64))
        ((eq op :f64.promote-f32) (cons :f32 :f64))))

(defun binary-type (op)
  (cond ((member op '(:i32.eq :i32.ne :i32.lt-s :i32.lt-u :i32.gt-s :i32.gt-u
                      :i32.le-s :i32.le-u :i32.ge-s :i32.ge-u))
         (list :i32 :i32 :i32))
        ((member op '(:i32.add :i32.sub :i32.mul :i32.div-s :i32.div-u
                      :i32.rem-s :i32.rem-u :i32.and :i32.or :i32.xor :i32.shl
                      :i32.shr-s :i32.shr-u :i32.rotl :i32.rotr))
         (list :i32 :i32 :i32))
        ((member op '(:i64.eq :i64.ne :i64.lt-s :i64.lt-u :i64.gt-s :i64.gt-u
                      :i64.le-s :i64.le-u :i64.ge-s :i64.ge-u))
         (list :i64 :i64 :i32))
        ((member op '(:i64.add :i64.sub :i64.mul :i64.div-s :i64.div-u
                      :i64.rem-s :i64.rem-u :i64.and :i64.or :i64.xor :i64.shl
                      :i64.shr-s :i64.shr-u :i64.rotl :i64.rotr))
         (list :i64 :i64 :i64))
        ((member op '(:f32.eq :f32.ne :f32.lt :f32.gt :f32.le :f32.ge))
         (list :f32 :f32 :i32))
        ((member op '(:f32.add :f32.sub :f32.mul :f32.div :f32.min :f32.max
                      :f32.copysign))
         (list :f32 :f32 :f32))
        ((member op '(:f64.eq :f64.ne :f64.lt :f64.gt :f64.le :f64.ge))
         (list :f64 :f64 :i32))
        ((member op '(:f64.add :f64.sub :f64.mul :f64.div :f64.min :f64.max
                      :f64.copysign))
         (list :f64 :f64 :f64))))

(defun note-ref-funcs (set expr)
  (loop for item across expr
        when (eq (instr-op item) :ref.func)
          do (setf (gethash (instr-a item) set) t)))

(defun declared-func-set (module)
  (let ((set (make-hash-table)))
    (loop for elem across (wasm-module-elems module) do
      (loop for init across (wasm-elem-inits elem) do (note-ref-funcs set init)))
    (loop for global across (wasm-module-globals module) do
      (note-ref-funcs set (wasm-global-def-init global)))
    (loop for export across (wasm-module-exports module)
          when (eq (wasm-export-kind export) :func)
            do (setf (gethash (wasm-export-index export) set) t))
    set))

(defun validate-expr (module body func-sigs global-types table-types
                      local-types result-types declared have-memory)
  (let ((stack nil)
        (frames nil))
    (labels ((frame () (car frames))
             (height () (vframe-height (frame)))
             (unreachable-p () (vframe-unreachable (frame)))
             (push-val (type) (push type stack))
             (pop-val (expected)
               (cond ((and (= (length stack) (height)) (unreachable-p))
                      expected)
                     ((<= (length stack) (height))
                      (invalid "type mismatch"))
                     (t (let ((actual (pop stack)))
                          (cond ((eq actual :unknown) expected)
                                ((or (eq expected :unknown) (eq actual expected))
                                 actual)
                                (t (invalid "type mismatch")))))))
             (pop-vals (types)
               (loop for type across (reverse types) do (pop-val type)))
             (push-vals (types)
               (loop for type across types do (push-val type)))
             (mark ()
               (setf stack (last stack (height)))
               (setf (vframe-unreachable (frame)) t))
             (open-frame (kind params results labels)
               (push (make-vframe :height (length stack)
                                  :label-types labels
                                  :result-types results
                                  :param-types params
                                  :kind kind)
                     frames)
               (push-vals params))
             (close-frame ()
               (let ((current (frame)))
                 (pop-vals (vframe-result-types current))
                 (unless (= (length stack) (vframe-height current))
                   (invalid "type mismatch"))
                 (pop frames)
                 current))
             (label-frame (index)
               (unless (< index (length frames))
                 (invalid (format nil "unknown label ~A" index)))
               (nth index frames))
             (local (index)
               (unless (< index (length local-types))
                 (invalid (format nil "unknown local ~A" index)))
               (aref local-types index))
             (global (index)
               (unless (< index (length global-types))
                 (invalid (format nil "unknown global ~A" index)))
               (aref global-types index))
             (func (index)
               (unless (< index (length func-sigs))
                 (invalid (format nil "unknown function ~A" index)))
               (aref func-sigs index))
             (table (index)
               (unless (< index (length table-types))
                 (invalid (format nil "unknown table ~A" index)))
               (aref table-types index))
             (need-memory ()
               (unless have-memory (invalid "unknown memory 0")))
             (block-parts (bt)
               (cond ((eq bt :empty) (cons #() #()))
                     ((and (consp bt) (eq (car bt) :val))
                      (cons #() (vector (cdr bt))))
                     ((and (consp bt) (eq (car bt) :index))
                      (type-at module (cdr bt)))
                     (t (invalid "type mismatch"))))
             (check-align (op align)
               (when (> align (natural-align op))
                 (invalid "alignment must not be larger than natural"))))
      (open-frame :func #() result-types result-types)
      (loop for item across body do
        (let ((op (instr-op item)))
          (cond
            ((eq op :unreachable) (mark))
            ((eq op :nop))
            ((eq op :drop) (pop-val :unknown))
            ((eq op :select)
             (pop-val :i32)
             (let ((second (pop-val :unknown)))
               (let ((first (pop-val second)))
                 (when (and first (not (eq first :unknown)) (not (numeric-p first)))
                   (invalid "type mismatch"))
                 (when (and second (not (eq second :unknown)) (not (numeric-p second)))
                   (invalid "type mismatch"))
                 (push-val (if (eq first :unknown) second first)))))
            ((eq op :select-t)
             (let ((types (instr-a item)))
               (unless (= (length types) 1)
                 (invalid "invalid result arity"))
               (pop-val :i32)
               (pop-val (aref types 0))
               (pop-val (aref types 0))
               (push-val (aref types 0))))
            ((member op '(:block :loop :if))
             (let* ((parts (block-parts (instr-a item)))
                    (params (sig-params parts))
                    (results (sig-results parts)))
               (when (eq op :if) (pop-val :i32))
               (pop-vals params)
               (open-frame op params results (if (eq op :loop) params results))))
            ((eq op :else)
             (let ((current (frame)))
               (unless (eq (vframe-kind current) :if)
                 (invalid "type mismatch"))
               (pop-vals (vframe-result-types current))
               (unless (= (length stack) (vframe-height current))
                 (invalid "type mismatch"))
               (setf stack (last stack (vframe-height current))
                     (vframe-unreachable current) nil
                     (vframe-saw-else current) t)
               (push-vals (vframe-param-types current))))
            ((eq op :end)
             (let* ((current (close-frame))
                    (params (vframe-param-types current))
                    (results (vframe-result-types current)))
               (when (and (eq (vframe-kind current) :if)
                          (not (vframe-saw-else current))
                          (not (equalp params results)))
                 (invalid "type mismatch"))
               (when frames (push-vals results))))
            ((member op '(:br :br-if))
             (let ((target (label-frame (instr-a item))))
               (when (eq op :br-if) (pop-val :i32))
               (pop-vals (vframe-label-types target))
               (if (eq op :br)
                   (mark)
                   (push-vals (vframe-label-types target)))))
            ((eq op :br-table)
             (pop-val :i32)
             (let ((default (label-frame (instr-b item)))
                   (polymorphic (unreachable-p)))
               (pop-vals (vframe-label-types default))
               (loop for label across (instr-a item)
                     for types = (vframe-label-types (label-frame label))
                     do (unless (= (length types) (length (vframe-label-types default)))
                          (invalid "type mismatch"))
                        (unless (or polymorphic
                                    (equalp types (vframe-label-types default)))
                          (invalid "type mismatch")))
               (mark)))
            ((eq op :return)
             (pop-vals result-types)
             (mark))
            ((eq op :call)
             (let ((sig (func (instr-a item))))
               (pop-vals (sig-params sig))
               (push-vals (sig-results sig))))
            ((eq op :call-indirect)
             (let ((sig (type-at module (instr-a item)))
                   (tab (table (instr-b item))))
               (unless (eq (car tab) :funcref)
                 (invalid "type mismatch"))
               (pop-val :i32)
               (pop-vals (sig-params sig))
               (push-vals (sig-results sig))))
            ((eq op :local.get) (push-val (local (instr-a item))))
            ((eq op :local.set) (pop-val (local (instr-a item))))
            ((eq op :local.tee)
             (let ((type (local (instr-a item))))
               (pop-val type)
               (push-val type)))
            ((eq op :global.get) (push-val (car (global (instr-a item)))))
            ((eq op :global.set)
             (let ((cell (global (instr-a item))))
               (unless (cdr cell) (invalid "global is immutable"))
               (pop-val (car cell))))
            ((eq op :table.get)
             (pop-val :i32)
             (push-val (car (table (instr-a item)))))
            ((eq op :table.set)
             (let ((type (car (table (instr-a item)))))
               (pop-val type)
               (pop-val :i32)))
            ((eq op :table.size) (table (instr-a item)) (push-val :i32))
            ((eq op :table.grow)
             (table (instr-a item))
             (pop-val :i32)
             (pop-val (car (table (instr-a item))))
             (push-val :i32))
            ((eq op :table.fill)
             (let ((type (car (table (instr-a item)))))
               (pop-val :i32)
               (pop-val type)
               (pop-val :i32)))
            ((eq op :table.copy)
             (let ((dest (table (instr-a item)))
                   (src (table (instr-b item))))
               (unless (eq (car dest) (car src))
                 (invalid "type mismatch")))
             (pop-val :i32) (pop-val :i32) (pop-val :i32))
            ((eq op :table.init)
             (let* ((tab (table (instr-a item)))
                    (index (instr-b item))
                    (elems (wasm-module-elems module)))
               (unless (< index (length elems))
                 (invalid (format nil "unknown elem segment ~A" index)))
               (unless (eq (car tab) (wasm-elem-type (aref elems index)))
                 (invalid "type mismatch")))
             (pop-val :i32) (pop-val :i32) (pop-val :i32))
            ((eq op :elem.drop)
             (unless (< (instr-a item) (length (wasm-module-elems module)))
               (invalid (format nil "unknown elem segment ~A" (instr-a item)))))
            ((load-result op)
             (need-memory)
             (check-align op (instr-a item))
             (pop-val :i32)
             (push-val (load-result op)))
            ((stored-type op)
             (need-memory)
             (check-align op (instr-a item))
             (pop-val (stored-type op))
             (pop-val :i32))
            ((eq op :memory.size) (need-memory) (push-val :i32))
            ((eq op :memory.grow)
             (need-memory) (pop-val :i32) (push-val :i32))
            ((member op '(:memory.copy :memory.fill))
             (need-memory)
             (pop-val :i32) (pop-val :i32) (pop-val :i32))
            ((eq op :memory.init)
             (need-memory)
             (unless (< (instr-a item) (length (wasm-module-datas module)))
               (invalid (format nil "unknown data segment ~A" (instr-a item))))
             (pop-val :i32) (pop-val :i32) (pop-val :i32))
            ((eq op :data.drop)
             (unless (< (instr-a item) (length (wasm-module-datas module)))
               (invalid (format nil "unknown data segment ~A" (instr-a item)))))
            ((eq op :i32.const) (push-val :i32))
            ((eq op :i64.const) (push-val :i64))
            ((eq op :f32.const) (push-val :f32))
            ((eq op :f64.const) (push-val :f64))
            ((eq op :ref.null) (push-val (instr-a item)))
            ((eq op :ref.is-null)
             (let ((type (pop-val :unknown)))
               (unless (or (eq type :unknown) (ref-p type))
                 (invalid "type mismatch")))
             (push-val :i32))
            ((eq op :ref.func)
             (func (instr-a item))
             (unless (gethash (instr-a item) declared)
               (invalid (format nil "undeclared function reference ~A" (instr-a item))))
             (push-val :funcref))
            ((unary-type op)
             (let ((pair (unary-type op)))
               (pop-val (car pair))
               (push-val (cdr pair))))
            ((binary-type op)
             (let ((spec (binary-type op)))
               (pop-val (second spec))
               (pop-val (first spec))
               (push-val (third spec))))
            (t (invalid "type mismatch")))))
      (unless (null frames)
        (invalid "type mismatch")))))

(defun const-expr-p (module expr global-limit)
  (loop for item across expr
        for op = (instr-op item)
        do (cond ((member op '(:i32.const :i64.const :f32.const :f64.const
                               :ref.null :ref.func :end)))
                 ((eq op :global.get)
                  (let ((index (instr-a item)))
                    (unless (< index global-limit)
                      (invalid (format nil "unknown global ~A" index)))
                    (when (cdr (aref (imported-global-types module) index))
                      (invalid "constant expression required"))))
                 (t (invalid "constant expression required"))))
  t)

(defun imported-global-types (module)
  (let ((out (make-array 0 :adjustable t :fill-pointer 0)))
    (loop for item across (wasm-module-imports module)
          when (eq (wasm-import-kind item) :global)
            do (vector-push-extend (wasm-import-type item) out))
    out))

(defun collect-sigs (module)
  (let ((out (make-array 0 :adjustable t :fill-pointer 0)))
    (loop for item across (wasm-module-imports module)
          when (eq (wasm-import-kind item) :func)
            do (vector-push-extend (type-at module (wasm-import-type item)) out))
    (loop for index across (wasm-module-func-types module)
          do (vector-push-extend (type-at module index) out))
    out))

(defun collect-tables (module)
  (let ((out (make-array 0 :adjustable t :fill-pointer 0)))
    (loop for item across (wasm-module-imports module)
          when (eq (wasm-import-kind item) :table)
            do (let ((type (wasm-import-type item)))
                 (check-limits (wasm-table-type-min type)
                               (wasm-table-type-max type) :table)
                 (vector-push-extend (cons (wasm-table-type-element type) type) out)))
    (loop for type across (wasm-module-tables module) do
      (check-limits (wasm-table-type-min type) (wasm-table-type-max type) :table)
      (vector-push-extend (cons (wasm-table-type-element type) type) out))
    out))

(defun collect-globals (module)
  (let ((out (make-array 0 :adjustable t :fill-pointer 0)))
    (loop for item across (imported-global-types module)
          do (vector-push-extend item out))
    (loop for item across (wasm-module-globals module)
          do (vector-push-extend (cons (wasm-global-def-type item)
                                       (wasm-global-def-mutable item))
                                 out))
    out))

(defun empty-locals () (make-array 0))

(defun validate-const (module expr expected globals tables funcs declared memory-p limit)
  (unless (const-expr-p module expr limit)
    (invalid "constant expression required"))
  (validate-expr module expr funcs (subseq globals 0 limit) tables
                 (empty-locals) (vector expected) declared memory-p))

(defun validate-module (module)
  (let* ((funcs (collect-sigs module))
         (tables (collect-tables module))
         (globals (collect-globals module))
         (import-globals (imported-global-types module))
         (memory-count 0)
         (declared (declared-func-set module)))
    (loop for item across (wasm-module-imports module)
          when (eq (wasm-import-kind item) :memory)
            do (progn (check-limits (wasm-memory-type-min (wasm-import-type item))
                                    (wasm-memory-type-max (wasm-import-type item))
                                    :memory)
                      (incf memory-count)))
    (loop for type across (wasm-module-memories module) do
      (check-limits (wasm-memory-type-min type) (wasm-memory-type-max type) :memory)
      (incf memory-count))
    (when (> memory-count 1) (invalid "multiple memories"))
    (loop for item across (wasm-module-globals module) do
      (validate-const module (wasm-global-def-init item)
                      (wasm-global-def-type item)
                      globals tables funcs declared (plusp memory-count)
                      (length import-globals)))
    (loop for elem across (wasm-module-elems module) do
      (loop for init across (wasm-elem-inits elem) do
        (validate-const module init (wasm-elem-type elem)
                        globals tables funcs declared (plusp memory-count)
                        (length import-globals)))
      (when (eq (wasm-elem-mode elem) :active)
        (let ((table (if (< (wasm-elem-table elem) (length tables))
                         (aref tables (wasm-elem-table elem))
                         (invalid (format nil "unknown table ~A" (wasm-elem-table elem))))))
          (unless (eq (car table) (wasm-elem-type elem))
            (invalid "type mismatch"))
          (validate-const module (wasm-elem-offset elem) :i32
                          globals tables funcs declared (plusp memory-count)
                          (length import-globals)))))
    (loop for data across (wasm-module-datas module) do
      (when (eq (wasm-data-mode data) :active)
        (let ((index (or (wasm-data-memory data) 0)))
          (unless (and (plusp memory-count) (zerop index))
            (invalid (format nil "unknown memory ~A" index))))
        (validate-const module (wasm-data-offset data) :i32
                        globals tables funcs declared (plusp memory-count)
                        (length import-globals))))
    (let ((import-funcs (count :func (wasm-module-imports module) :key #'wasm-import-kind)))
      (loop for type-index across (wasm-module-func-types module)
            for code across (wasm-module-codes module)
            for sig = (type-at module type-index)
            for params = (sig-params sig)
            for locals = (concatenate 'vector params (wasm-code-locals code))
            do (validate-expr module (wasm-code-body code) funcs globals tables
                              locals (sig-results sig) declared (plusp memory-count)
                              )
            do (incf import-funcs)))
    (when (wasm-module-start module)
      (let ((index (wasm-module-start module)))
        (unless (< index (length funcs))
          (invalid (format nil "unknown function ~A" index)))
        (let ((sig (aref funcs index)))
          (unless (and (zerop (length (sig-params sig)))
                       (zerop (length (sig-results sig))))
            (invalid "start function")))))
    (let ((names (make-hash-table :test #'equal)))
      (loop for item across (wasm-module-exports module) do
        (when (gethash (wasm-export-name item) names)
          (invalid "duplicate export name"))
        (setf (gethash (wasm-export-name item) names) t)
        (let ((index (wasm-export-index item)))
          (case (wasm-export-kind item)
            (:func (unless (< index (length funcs))
                     (invalid (format nil "unknown function ~A" index))))
            (:table (unless (< index (length tables))
                      (invalid (format nil "unknown table ~A" index))))
            (:memory (unless (and (plusp memory-count) (zerop index))
                       (invalid "unknown memory 0")))
            (:global (unless (< index (length globals))
                       (invalid (format nil "unknown global ~A" index))))))))
    module))
