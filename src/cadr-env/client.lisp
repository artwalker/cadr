(in-package #:cadr-env)

(defstruct mailbox
  (events nil)
  result
  failure
  (done nil)
  (lock (sb-thread:make-mutex :name "env-mailbox"))
  (wait (sb-thread:make-waitqueue :name "env-mailbox")))

(defstruct connection
  input
  output
  (next-id 0)
  (pending (make-hash-table :test #'eql))
  (lock (sb-thread:make-mutex :name "env-connection"))
  info
  reader
  (closed nil))

(defstruct remote-file-error code message path)

(defun file-error-code (error)
  (remote-file-error-code error))

(defun node-platform (os arch)
  (json-object "os" (cond ((equal os "windows") "win32")
                          ((equal os "macos") "darwin")
                          (t os))
               "arch" (cond ((equal arch "x86_64") "x64")
                            ((equal arch "aarch64") "arm64")
                            ((equal arch "x86") "ia32")
                            (t arch))))

(defun to-file-error (code message &optional path)
  (make-remote-file-error
   :code (cond ((equal code "aborted") "aborted")
               ((equal code "ENOENT") "not_found")
               ((member code '("EACCES" "EPERM") :test #'equal) "permission_denied")
               ((equal code "ENOTDIR") "not_directory")
               ((equal code "EISDIR") "is_directory")
               ((member code '("EINVAL" "SYMLINK" "NOT_REGULAR") :test #'equal) "invalid")
               (t "unknown"))
   :message message
   :path path))

(defun file-url-path (text)
  (let ((rest (subseq text 7)))
    (when (and (>= (length rest) 1) (char= (char rest 0) #\/))
      rest)))

(defun resolve-remote-path (path info)
  (cond
    ((equal path "~") (json-get info "home"))
    ((and (>= (length path) 2) (char= (char path 0) #\~)
          (member (char path 1) '(#\/ #\\)))
     (concatenate 'string (strip-slash (json-get info "home")) (subseq path 1)))
    ((and (>= (length path) 7) (string= path "file://" :end1 7))
     (or (file-url-path path) path))
    ((and (plusp (length path)) (char= (char path 0) #\/)) path)
    (t (concatenate 'string (strip-slash (json-get info "cwd")) "/" path))))

(defun read-banner (stream token)
  (let ((line (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)))
    (loop for byte = (read-byte stream)
          do (cond
               ((= byte 10)
                (let ((text (utf8-string line)))
                  (when (string= text (concatenate 'string (wire-literal :banner) token))
                    (return t)))
                (setf (fill-pointer line) 0))
               (t (vector-push-extend byte line))))))

(defun deliver-frame (connection frame)
  (let ((box (gethash (frame-id frame) (connection-pending connection))))
    (when box
      (sb-thread:with-mutex ((mailbox-lock box))
        (case (frame-kind frame)
          (#.+event+ (push (cons (frame-json frame) (frame-payload frame)) (mailbox-events box)))
          (#.+result+
           (setf (mailbox-result box) (cons (frame-json frame) (frame-payload frame))
                 (mailbox-done box) t)
           (sb-thread:condition-broadcast (mailbox-wait box)))
          (#.+error+
           (setf (mailbox-failure box) (frame-json frame)
                 (mailbox-done box) t)
           (sb-thread:condition-broadcast (mailbox-wait box))))))))

(defun connection-close (connection)
  (setf (connection-closed connection) t)
  (ignore-errors (close (connection-output connection)))
  (ignore-errors (close (connection-input connection)))
  (when (connection-reader connection)
    (cadr-core:stop-thread-for-cleanup
     (connection-reader connection) :timeout 2d0)))

(defun make-pipe-connection (&key (token "test-token"))
  (let ((up (multiple-value-list (sb-posix:pipe)))
        (down (multiple-value-list (sb-posix:pipe))))
    (let ((client-write (second up))
          (daemon-read (first up))
          (daemon-write (second down))
          (client-read (first down)))
      (sb-thread:make-thread
       (lambda ()
         (let ((input (sb-sys:make-fd-stream daemon-read :input t :element-type '(unsigned-byte 8)
                                             :buffering :none :auto-close t))
               (output (sb-sys:make-fd-stream daemon-write :output t :element-type '(unsigned-byte 8)
                                              :buffering :none :auto-close t)))
           (write-text-line output (concatenate 'string (wire-literal :banner) token))
           (serve-frames input output)))
       :name "env-daemon")
      (let* ((input (sb-sys:make-fd-stream client-read :input t :element-type '(unsigned-byte 8)
                                           :buffering :none :auto-close t))
             (output (sb-sys:make-fd-stream client-write :output t :element-type '(unsigned-byte 8)
                                            :buffering :none :auto-close t))
             (connection (make-connection :input input :output output)))
        (read-banner input token)
        (setf (connection-reader connection)
              (sb-thread:make-thread
               (lambda ()
                 (loop until (connection-closed connection)
                       for frame = (handler-case (read-frame input)
                                     (error () nil))
                       while frame
                       do (deliver-frame connection frame)))
               :name "env-reader"))
        (setf (connection-info connection)
              (connection-request connection "hello" (json-object)))
        connection))))

(defun connection-request (connection op json &optional (payload #()) id-box)
  (let ((box (make-mailbox))
        (id (incf (connection-next-id connection))))
    (when id-box
      (setf (car id-box) id))
    (json-put json "op" op)
    (setf (gethash id (connection-pending connection)) box)
    (sb-thread:with-mutex ((connection-lock connection))
      (write-frame (connection-output connection) (make-frame +request+ id json payload)))
    (sb-thread:with-mutex ((mailbox-lock box))
      (loop until (mailbox-done box)
            do (sb-thread:condition-wait (mailbox-wait box) (mailbox-lock box))))
    (remhash id (connection-pending connection))
    (when (mailbox-failure box)
      (let ((failure (mailbox-failure box)))
        (env-failure (json-get failure "code") (json-get failure "message")
                     :syscall (unless (eq (json-get failure "syscall") +absent+)
                                (json-get failure "syscall"))
                     :path (unless (eq (json-get failure "path") +absent+)
                             (json-get failure "path"))
                     :extra failure)))
    (values (car (mailbox-result box))
            (cdr (mailbox-result box))
            (nreverse (mailbox-events box)))))

(defun connection-cancel (connection id &key kill)
  (let ((json (if kill (json-object "mode" "kill") (json-object))))
    (sb-thread:with-mutex ((connection-lock connection))
      (write-frame (connection-output connection) (make-frame +cancel+ id json)))))

(defconstant +js-max-safe-integer+ #.(1- (expt 2 53)))

(defun list-files-bound-p (value)
  (and (integerp value) (<= 0 value +js-max-safe-integer+)))

(defun list-files-over (connection request)
  (dolist (key '("maxEntries" "maxBytes" "timeoutMs"))
    (let ((value (json-get request key)))
      (unless (or (eq value +absent+) (list-files-bound-p value))
        (env-failure "invalid"
                     (format nil "~A must be a non-negative safe integer" key)
                     :path (let ((path (json-get request "path")))
                             (when (stringp path) path))))))
  (let ((features (json-get (connection-info connection) "features")))
    (unless (and (json-array-p features) (find "listFiles" features :test #'equal))
      (env-failure "not_supported" (wire-literal :list-unsupported))))
  (connection-request connection "listFiles" request))

(defun check-field (name value)
  (when (or (equal value "")
            (char= (char value 0) #\-)
            (find-if (lambda (character)
                       (or (char= character #\Space) (char= character #\Tab) (char= character #\Newline)
                           (< (char-code character) 32)))
                     value))
    (error "Invalid ~A: ~A" name (write-json value))))

(defun config-path (name path)
  (when (or (equal path "") (find #\" path))
    (error "Invalid ~A: ~A" name (write-json path)))
  (format nil "\"~A\"" (substitute #\% #\% path)))

(defun ssh-option (setting)
  (list "-o" setting))

(defun ssh-arguments (target &key (strict t) known-hosts)
  (let ((host (getf target :host))
        (alias (getf target :host-key-alias))
        (user (getf target :user))
        (port (getf target :port))
        (identity (getf target :identity-file))
        (config (getf target :config-file))
        (hosts (or known-hosts (getf target :known-hosts-file))))
    (check-field "host" host)
    (check-field "host key alias" alias)
    (when user (check-field "user" user))
    (when (and port (not (and (integerp port) (<= 1 port 65535))))
      (error "Invalid port: ~A" port))
    (append (when config (list "-F" config))
            (list "-T" "-a" "-x")
            (ssh-option "BatchMode=yes")
            (ssh-option "ClearAllForwardings=yes")
            (ssh-option "ForwardAgent=no")
            (ssh-option "ForwardX11=no")
            (ssh-option "ControlMaster=no")
            (ssh-option "ControlPath=none")
            (ssh-option "RemoteCommand=none")
            (ssh-option "PermitLocalCommand=no")
            (ssh-option "SendEnv=-*")
            (ssh-option "ServerAliveInterval=15")
            (ssh-option (format nil "StrictHostKeyChecking=~A" (if strict "yes" "accept-new")))
            (ssh-option (format nil "UserKnownHostsFile=~A" (config-path "known hosts file" hosts)))
            (ssh-option "GlobalKnownHostsFile=none")
            (ssh-option "HashKnownHosts=no")
            (ssh-option (format nil "HostKeyAlias=~A" alias))
            (when user (list "-l" user))
            (when port (list "-p" (princ-to-string port)))
            (when identity
              (append (ssh-option (format nil "IdentityFile=~A" (config-path "identity file" identity)))
                      (ssh-option "IdentitiesOnly=yes")))
            (list "--" host))))

(defun host-key-type-p (type)
  (and (stringp type)
       (or (and (>= (length type) 4) (string= type "ssh-" :end1 4))
           (and (>= (length type) 11) (string= type "ecdsa-sha2-" :end1 11))
           (and (>= (length type) 3) (string= type "sk-" :end1 3)))))

(defun host-key-body-p (key)
  (and (stringp key)
       (plusp (length key))
       (every (lambda (character)
                (or (alphanumericp character) (find character "+/=")))
              key)))

(defun parse-host-key-line (alias line)
  (let* ((parts (loop for start = 0 then (1+ end)
                      for end = (position #\Space line :start start)
                      collect (subseq line start (or end (length line)))
                      while end))
         (host (first parts))
         (type (second parts))
         (key (third parts)))
    (unless (and (equal host alias) (host-key-type-p type) (host-key-body-p key))
      (error "Not a host key line for ~A: ~A" alias (write-json line)))
    (list type key line)))

(defun known-host-lines (path)
  (if (probe-file path)
      (with-open-file (stream path)
        (loop for line = (read-line stream nil nil)
              while line
              unless (equal (string-trim '(#\Space) line) "")
                collect line))
      nil))

(defvar *known-hosts-lock* (sb-thread:make-mutex :name "env-known-hosts"))

(defun rewrite-known-hosts (path lines)
  (let ((parent (parent-directory path)))
    (when parent (mkdir-recursive parent)))
  (let ((temporary (concatenate 'string path "." (format nil "~6,'0X" (random #xFFFFFF)) ".tmp")))
    (with-open-file (stream temporary :direction :output :if-exists :supersede :if-does-not-exist :create)
      (if lines
          (format stream "~{~A~%~}" lines)
          (write-string "" stream)))
    (ignore-errors (sb-posix:chmod temporary #o600))
    (sb-posix:rename temporary path)))

(defun accept-host-key (target lines)
  (sb-thread:with-mutex (*known-hosts-lock*)
    (accept-host-key-unlocked target lines)))

(defun accept-host-key-unlocked (target lines)
  (let* ((alias (getf target :host-key-alias))
         (host (getf target :host))
         (path (getf target :known-hosts-file))
         (accepted (mapcar (lambda (line) (parse-host-key-line alias (string-trim '(#\Space) line))) lines))
         (existing (known-host-lines path))
         (trusted (make-hash-table :test #'equal))
         (added nil))
    (dolist (line existing)
      (let ((parts (loop for start = 0 then (1+ end)
                         for end = (position #\Space line :start start)
                         collect (subseq line start (or end (length line)))
                         while end)))
        (when (and (equal (first parts) alias) (second parts) (third parts))
          (setf (gethash (second parts) trusted) (third parts)))))
    (dolist (item accepted)
      (let ((known (gethash (first item) trusted)))
        (cond
          ((equal known (second item)))
          (known
           (error "The ~A host key of ~A changed; forget the old key first" (first item) host))
          (t
           (setf (gethash (first item) trusted) (second item))
           (push (third item) added)))))
    (rewrite-known-hosts path (append existing (nreverse added)))))

(defun forget-host-key (target)
  (sb-thread:with-mutex (*known-hosts-lock*)
    (forget-host-key-unlocked target)))

(defun forget-host-key-unlocked (target)
  (let* ((alias (getf target :host-key-alias))
         (path (getf target :known-hosts-file)))
    (rewrite-known-hosts
     path
     (remove-if (lambda (line)
                  (let ((end (position #\Space line)))
                    (equal (subseq line 0 end) alias)))
                (known-host-lines path)))))

(defun host-key-changed-p (message)
  (search "changed" message))

(defun host-key-unknown-p (message)
  (search "not trusted yet" message))

(defun probe-banner ()
  (wire-literal :probe))

(defun posix-hash-program ()
  "hash() { if command -v sha256sum >/dev/null 2>&1; then sha256sum \"$1\" | cut -d' ' -f1; elif command -v shasum >/dev/null 2>&1; then shasum -a 256 \"$1\" | cut -d' ' -f1; elif command -v openssl >/dev/null 2>&1; then openssl dgst -sha256 \"$1\" | sed 's/.*= //'; else echo none; fi; }")

(defun deploy-daemon-path (home sha256 &key (platform "linux"))
  (let ((name (concatenate 'string (wire-literal :daemon-prefix) (subseq sha256 0 32))))
    (if (equal platform "windows")
        (concatenate 'string home (wire-literal :windows-tools) name ".exe")
        (concatenate 'string home (wire-literal :posix-tools) name))))

(defun sha256-hex-file (path)
  (let ((output (make-string-output-stream)))
    (sb-ext:run-program "sha256sum" (list path) :output output :search t :wait t)
    (subseq (get-output-stream-string output) 0 64)))

(define-condition host-key-error (error)
  ((message :initarg :message :reader host-key-error-message))
  (:report (lambda (condition stream) (write-string (host-key-error-message condition) stream))))
