(in-package #:cadr-env)

(defconstant +kind-file+ 102)
(defconstant +kind-directory+ 100)
(defconstant +kind-symlink+ 108)

(defstruct ignore-rule directory pattern negate directory-only anchored)

(defun list-options (request)
  (json-object "hidden" (json-flag request "hidden" t)
               "gitignore" (json-flag request "gitignore" t)
               "exclude" (let ((exclude (json-get request "exclude")))
                          (if (eq exclude +absent+) (json-array) exclude))
               "maxEntries" (or (json-u64 request "maxEntries") 50000)
               "maxBytes" (min (or (json-u64 request "maxBytes") (* 4 1024 1024))
                               +max-payload+)
               "timeoutMs" (or (json-u64 request "timeoutMs") 10000)))

(defun git-root (path)
  (let ((current (strip-slash path)))
    (loop
      (let ((git (concatenate 'string current "/.git")))
        (handler-case
            (let ((stat (sb-posix:lstat git)))
              (when (= (logand (sb-posix:stat-mode stat) #o170000) #o040000)
                (return current)))
          (sb-posix:syscall-error ())))
      (let ((parent (parent-directory current)))
        (when (or (null parent) (equal parent current))
          (return nil))
        (setf current parent)))))

(defun read-text-file (path)
  (with-output-to-string (stream)
    (with-open-file (input path :direction :input :if-does-not-exist nil)
      (when input
        (loop for line = (read-line input nil nil)
              while line
              do (write-line line stream))))))

(defun ignore-lines (text)
  (loop for line in (uiop:split-string text :separator '(#\Newline))
        for trimmed = (string-trim '(#\Space #\Tab #\Return) line)
        unless (or (equal trimmed "") (char= (char trimmed 0) #\#))
          collect trimmed))

(defun parse-ignore-line (directory line)
  (let* ((negate (char= (char line 0) #\!))
         (body (if negate (subseq line 1) line))
         (directory-only (and (> (length body) 0)
                              (char= (char body (1- (length body))) #\/)))
         (pattern (if directory-only (subseq body 0 (1- (length body))) body)))
    (when (plusp (length pattern))
      (make-ignore-rule :directory directory
                        :pattern pattern
                        :negate negate
                        :directory-only directory-only
                        :anchored (find #\/ pattern)))))

(defun rules-from-file (directory path)
  (handler-case
      (loop for line in (ignore-lines (read-text-file path))
            for rule = (parse-ignore-line directory line)
            when rule collect rule)
    (error () nil)))

(defun global-ignore-path ()
  (let ((home (or (sb-ext:posix-getenv "HOME") "")))
    (concatenate 'string (strip-slash home) "/.config/git/ignore")))

(defun collect-ignore-rules (root)
  (append (rules-from-file root (global-ignore-path))
          (rules-from-file root (concatenate 'string root "/.git/info/exclude"))
          (loop for path in (gitignore-files root)
                append (rules-from-file (parent-directory path) path))))

(defun gitignore-files (root)
  (let ((found nil))
    (labels ((walk (directory)
               (dolist (name (handler-case (directory-entries directory)
                               (error () nil)))
                 (let ((full (concatenate 'string (strip-slash directory) "/" name)))
                   (cond
                     ((equal name ".gitignore") (push full found))
                     ((and (not (equal name ".git")) (directory-path-p full))
                      (walk full)))))))
      (walk root))
    (nreverse found)))

(defun directory-path-p (path)
  (handler-case
      (= (logand (sb-posix:stat-mode (sb-posix:lstat path)) #o170000) #o040000)
    (sb-posix:syscall-error () nil)))

(defun glob-segment (pattern text)
  (let ((pattern-index 0) (text-index 0) (star nil) (mark 0))
    (loop
      (cond
        ((and (= pattern-index (length pattern)) (= text-index (length text)))
         (return t))
        ((and (< pattern-index (length pattern)) (char= (char pattern pattern-index) #\*))
         (setf star pattern-index mark text-index)
         (incf pattern-index))
        ((and (< pattern-index (length pattern)) (< text-index (length text))
              (or (char= (char pattern pattern-index) #\?)
                  (char= (char pattern pattern-index) (char text text-index))))
         (incf pattern-index) (incf text-index))
        ((and star (< mark (length text)))
         (setf pattern-index (1+ star) mark (1+ mark) text-index mark))
        (t (return nil))))))

(defun relative-under (directory path)
  (let ((base (strip-slash directory)))
    (cond ((equal path base) "")
          ((and (> (length path) (length base))
                (string= path base :end1 (length base))
                (char= (char path (length base)) #\/))
           (subseq path (1+ (length base))))
          (t nil))))

(defun rule-matches (rule path directory-p)
  (when (and (ignore-rule-directory-only rule) (not directory-p))
    (return-from rule-matches nil))
  (let ((relative (relative-under (ignore-rule-directory rule) path)))
    (unless relative
      (return-from rule-matches nil))
    (if (ignore-rule-anchored rule)
        (glob-segment (ignore-rule-pattern rule) relative)
        (glob-segment (ignore-rule-pattern rule) (path-name path)))))

(defun ignored-p (rules path directory-p)
  (let ((ignored nil))
    (dolist (rule rules)
      (when (rule-matches rule path directory-p)
        (setf ignored (not (ignore-rule-negate rule)))))
    ignored))

(defun excluded-name-p (options name)
  (find name (json-get options "exclude") :test #'equal))

(defun hidden-name-p (name)
  (and (plusp (length name)) (char= (char name 0) #\.)))

(defun octet-less (left right)
  (let ((a (utf8-bytes left))
        (b (utf8-bytes right)))
    (loop for index from 0
          do (cond ((and (>= index (length a)) (>= index (length b))) (return nil))
                   ((>= index (length a)) (return t))
                   ((>= index (length b)) (return nil))
                   ((< (aref a index) (aref b index)) (return t))
                   ((> (aref a index) (aref b index)) (return nil))))))

(defun raw-sort (names)
  (sort names #'octet-less))

(defun kind-byte (kind)
  (cond ((equal kind "file") +kind-file+)
        ((equal kind "directory") +kind-directory+)
        ((equal kind "symlink") +kind-symlink+)
        (t nil)))

(defun list-record (kind relative)
  (concatenate '(vector (unsigned-byte 8))
               (vector kind)
               (utf8-bytes relative)
               (vector 0)))

(defun op-list-files (request aborted)
  (let* ((root (require-string request "path"))
         (options (list-options request))
         (stat (call-posix "lstat" root (lambda () (sb-posix:lstat root))))
         (kind (logand (sb-posix:stat-mode stat) #o170000)))
    (unless (= kind #o040000)
      (env-failure "ENOTDIR"
                   (format nil "ENOTDIR: not a directory, scandir '~A'" root)
                   :syscall "scandir" :path root))
    (let* ((rules (when (json-get options "gitignore")
                    (let ((git (git-root root)))
                      (when git (collect-ignore-rules git)))))
           (deadline (+ (get-internal-real-time)
                        (* (json-get options "timeoutMs")
                           (/ internal-time-units-per-second 1000))))
           (payload (make-array 0 :element-type '(unsigned-byte 8)
                                :adjustable t :fill-pointer 0))
           (count 0)
           (truncated nil))
      (labels ((full-p (record)
                 (or (>= count (json-get options "maxEntries"))
                     (> (+ (length payload) (length record))
                        (json-get options "maxBytes"))
                     (>= (get-internal-real-time) deadline)))
               (emit (kind relative)
                 (let ((record (list-record kind relative)))
                   (when (full-p record)
                     (setf truncated t)
                     (return-from emit nil))
                   (loop for byte across record do (vector-push-extend byte payload))
                   (incf count)
                   t))
               (skip-p (name full directory-p)
                 (or (equal name ".git")
                     (excluded-name-p options name)
                     (and (not (json-get options "hidden")) (hidden-name-p name))
                     (and rules (ignored-p rules full directory-p))))
               (walk (directory relative)
                 (when (and aborted (funcall aborted))
                   (env-failure "aborted" "aborted"))
                 (dolist (name (raw-sort (directory-entries directory)))
                   (when truncated (return))
                   (let* ((full (concatenate 'string (strip-slash directory) "/" name))
                          (rel (if (equal relative "") name
                                   (concatenate 'string relative "/" name))))
                     (handler-case
                         (let* ((info (lstat-info full))
                                (kind (json-get info "kind"))
                                (byte (kind-byte kind))
                                (directory-p (equal kind "directory")))
                           (unless (skip-p name full directory-p)
                             (when (and byte (emit byte rel) directory-p)
                               (walk full rel))))
                       (env-failure ()))))))
        (walk root "")
        (values (json-object "count" count "truncated" (and truncated t)) payload)))))
