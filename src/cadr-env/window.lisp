(in-package #:cadr-env)

(defstruct output-window max-bytes max-lines min-interval-ms bytes-per-second)

(defstruct pending-output
  window
  (segments nil)
  (bytes 0)
  (newlines 0)
  (skipped nil)
  (next-send 0))

(defstruct output-event stream text skipped)

(defun newline-count (text)
  (count #\Newline text))

(defun window-from-json (object)
  (let ((bytes (json-u64 object "maxBytes"))
        (lines (json-u64 object "maxLines"))
        (interval (json-get object "minIntervalMs"))
        (rate (json-get object "bytesPerSecond")))
    (when (and bytes lines (realp interval) (realp rate))
      (make-output-window :max-bytes bytes :max-lines lines
                          :min-interval-ms (max 0 interval)
                          :bytes-per-second (max 1 rate)))))

(defun make-pending (window)
  (make-pending-output :window window :next-send (get-internal-real-time)))

(defun pending-empty-p (pending)
  (null (pending-output-segments pending)))

(defun pending-push (pending stream text)
  (when (plusp (length text))
    (incf (pending-output-bytes pending) (length (utf8-bytes text)))
    (incf (pending-output-newlines pending) (newline-count text))
    (let ((last (car (last (pending-output-segments pending)))))
      (if (and last (equal (car last) stream))
          (setf (cdr last) (concatenate 'string (cdr last) text))
          (setf (pending-output-segments pending)
                (append (pending-output-segments pending)
                        (list (cons stream text))))))
    (let ((window (pending-output-window pending)))
      (when (or (> (pending-output-bytes pending)
                   (* 4 (1+ (output-window-max-bytes window))))
                (> (pending-output-newlines pending)
                   (* 4 (1+ (output-window-max-lines window)))))
        (pending-trim pending)))))

(defun proves-outside (pending bytes newlines)
  (let ((window (pending-output-window pending)))
    (or (> bytes (output-window-max-bytes window))
        (> newlines (output-window-max-lines window)))))

(defun prefix-char-count (text byte-index)
  (let ((bytes 0)
        (chars 0))
    (loop for character across text
          for size = (length (utf8-bytes (string character)))
          while (<= (+ bytes size) byte-index)
          do (incf bytes size)
             (incf chars))
    chars))

(defun pending-trim (pending)
  (let ((removed ""))
    (loop while (> (length (pending-output-segments pending)) 1)
          do (let* ((first (cdr (first (pending-output-segments pending))))
                    (bytes (length (utf8-bytes first)))
                    (newlines (newline-count first)))
               (unless (proves-outside pending
                                       (- (pending-output-bytes pending) bytes)
                                       (- (pending-output-newlines pending) newlines))
                 (return))
               (setf removed (concatenate 'string removed first))
               (decf (pending-output-bytes pending) bytes)
               (decf (pending-output-newlines pending) newlines)
               (pop (pending-output-segments pending))))
    (when (pending-output-segments pending)
      (let* ((window (pending-output-window pending))
             (first (cdr (first (pending-output-segments pending))))
             (first-bytes (length (utf8-bytes first)))
             (rest-bytes (- (pending-output-bytes pending) first-bytes))
             (rest-newlines (- (pending-output-newlines pending) (newline-count first)))
             (keep-bytes (max 0 (- (1+ (output-window-max-bytes window)) rest-bytes)))
             (keep-newlines (max 0 (- (1+ (output-window-max-lines window)) rest-newlines)))
             (cut 0))
        (when (> first-bytes keep-bytes)
          (setf cut (max cut (prefix-char-count first (- first-bytes keep-bytes)))))
        (if (plusp keep-newlines)
            (let ((positions (loop for index from 0 below (length first)
                                   when (char= (char first index) #\Newline)
                                     collect index)))
              (when (>= (length positions) keep-newlines)
                (setf cut (max cut (nth (- (length positions) keep-newlines) positions)))))
            (setf cut (length first)))
        (when (plusp cut)
          (let ((prefix (subseq first 0 cut)))
            (setf removed (concatenate 'string removed prefix))
            (decf (pending-output-bytes pending) (length (utf8-bytes prefix)))
            (decf (pending-output-newlines pending) (newline-count prefix))
            (if (= cut (length first))
                (pop (pending-output-segments pending))
                (setf (cdr (first (pending-output-segments pending)))
                      (subseq first cut)))))))
    (when (plusp (length removed))
      (let ((skipped (or (pending-output-skipped pending)
                         (json-object "bytes" 0 "newlines" 0 "endsWithNewline" nil))))
        (json-put skipped "bytes" (+ (json-get skipped "bytes") (length (utf8-bytes removed))))
        (json-put skipped "newlines" (+ (json-get skipped "newlines") (newline-count removed)))
        (json-put skipped "endsWithNewline" (char= (char removed (1- (length removed))) #\Newline))
        (setf (pending-output-skipped pending) skipped)))))

(defun pending-take (pending)
  (let* ((segments (pending-output-segments pending))
         (delivered (pending-output-bytes pending))
         (window (pending-output-window pending))
         (pace-ms (* 1000 (/ (min delivered (output-window-max-bytes window))
                             (output-window-bytes-per-second window))))
         (wait (max (output-window-min-interval-ms window) pace-ms)))
    (setf (pending-output-segments pending) nil
          (pending-output-bytes pending) 0
          (pending-output-newlines pending) 0
          (pending-output-next-send pending)
          (+ (get-internal-real-time)
             (round (* wait (/ internal-time-units-per-second 1000)))))
    (let ((skipped (pending-output-skipped pending)))
      (setf (pending-output-skipped pending) nil)
      (if skipped
          (list (make-output-event
                 :stream (or (car (car (last segments))) "stdout")
                 :text (apply #'concatenate 'string (mapcar #'cdr segments))
                 :skipped skipped))
          (mapcar (lambda (segment)
                    (make-output-event :stream (car segment) :text (cdr segment)))
                  segments)))))
