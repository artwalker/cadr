(in-package #:cadr-chord)

(define-condition unsafe-path-error (error)
  ((segment :initarg :segment :reader unsafe-path-segment))
  (:report (lambda (condition stream)
             (format stream "unsafe path segment: ~A" (unsafe-path-segment condition)))))

(define-condition path-error (error)
  ((path :initarg :path :reader path-error-path))
  (:report (lambda (condition stream)
             (format stream "unresolvable path: ~A"
                     (canonical-json (path-error-path condition))))))

(defparameter +reserved-segments+ '("__proto__" "constructor" "prototype"))

(defun reserved-segment-p (segment)
  (and (stringp segment) (member segment +reserved-segments+ :test #'string=)))

(defun assert-safe-path (path)
  (dolist (segment path)
    (cond
      ((stringp segment)
       (when (reserved-segment-p segment)
         (error 'unsafe-path-error :segment segment)))
      ((and (integerp segment) (>= segment 0)) nil)
      (t (error 'unsafe-path-error :segment segment)))))

(defun assert-path-arg (path non-empty)
  (unless (listp path) (error "path is not an array"))
  (when (and non-empty (null path)) (error "path is empty"))
  (assert-safe-path path))

(defun assert-permutation (value)
  (unless (listp value) (error "m permutation is not an array"))
  (let ((seen (make-hash-table)))
    (dolist (index value)
      (unless (and (integerp index) (>= index 0) (< index (length value))
                   (not (gethash index seen)))
        (error "m permutation is not a bijection"))
      (setf (gethash index seen) t))))

(defun assert-valid-op (op)
  (unless (and (listp op) op) (error "op is not a tuple"))
  (case (intern-keyword (first op))
    (:r (unless (= (length op) 2) (error "r arity")))
    (:s (unless (= (length op) 3) (error "s arity"))
        (assert-path-arg (second op) t))
    (:d (unless (= (length op) 2) (error "d arity"))
        (assert-path-arg (second op) t))
    (:a (unless (and (= (length op) 3) (stringp (third op))) (error "a shape"))
        (assert-path-arg (second op) t))
    (:t (unless (and (= (length op) 3) (integerp (third op)) (>= (third op) 0))
          (error "t shape"))
        (assert-path-arg (second op) t))
    (:p (unless (= (length op) 5) (error "p arity"))
        (assert-path-arg (second op) nil)
        (unless (and (integerp (third op)) (>= (third op) 0)) (error "p index"))
        (unless (and (integerp (fourth op)) (>= (fourth op) 0)) (error "p remove"))
        (unless (listp (fifth op)) (error "p items")))
    (:m (unless (= (length op) 3) (error "m arity"))
        (assert-path-arg (second op) nil)
        (assert-permutation (third op)))
    (t (error "unknown op verb: ~A" (first op)))))

(defun intern-keyword (verb)
  (cond
    ((string= verb "r") :r)
    ((string= verb "s") :s)
    ((string= verb "d") :d)
    ((string= verb "a") :a)
    ((string= verb "t") :t)
    ((string= verb "p") :p)
    ((string= verb "m") :m)
    ((string= verb "#") :hash)
    (t :unknown)))

(defun assert-wire-ref (ref)
  (cond
    ((integerp ref) (unless (>= ref 0) (error "bad path id")))
    ((listp ref) (assert-safe-path ref))
    (t (error "path is not an array"))))

(defun assert-valid-wire-op (op)
  (unless (and (listp op) op) (error "op is not a tuple"))
  (case (intern-keyword (first op))
    (:r (unless (= (length op) 2) (error "r arity")))
    (:s (cond
          ((= (length op) 3) (assert-wire-ref (second op)))
          ((/= (length op) 2) (error "s arity"))))
    (:d (cond
          ((= (length op) 2) (assert-wire-ref (second op)))
          ((/= (length op) 1) (error "d arity"))))
    (:a (cond
          ((= (length op) 3)
           (assert-wire-ref (second op))
           (unless (stringp (third op)) (error "a value")))
          ((= (length op) 2)
           (unless (stringp (second op)) (error "a value")))
          (t (error "a arity"))))
    (:t (cond
          ((= (length op) 3)
           (assert-wire-ref (second op))
           (unless (and (integerp (third op)) (>= (third op) 0)) (error "t count")))
          ((= (length op) 2)
           (unless (and (integerp (second op)) (>= (second op) 0)) (error "t count")))
          (t (error "t arity"))))
    (:p (let ((index (if (= (length op) 5) (third op) (second op)))
              (remove (if (= (length op) 5) (fourth op) (third op)))
              (items (if (= (length op) 5) (fifth op) (fourth op))))
          (unless (member (length op) '(4 5)) (error "p arity"))
          (when (= (length op) 5) (assert-wire-ref (second op)))
          (unless (and (integerp index) (>= index 0)) (error "p index"))
          (unless (and (integerp remove) (>= remove 0)) (error "p remove"))
          (unless (listp items) (error "p items"))))
    (:m (cond
          ((= (length op) 3) (assert-wire-ref (second op)) (assert-permutation (third op)))
          ((= (length op) 2) (assert-permutation (second op)))
          (t (error "m arity"))))
    (:hash (unless (and (= (length op) 3) (integerp (second op)) (>= (second op) 0) (listp (third op)))
             (error "# shape"))
           (assert-safe-path (third op)))
    (t (error "unknown op verb: ~A" (first op)))))

(defun path-key (path)
  (canonical-json (coerce path 'vector)))

(defstruct (encoder (:constructor %make-encoder)) seen ids next-id)
(defstruct (decoder (:constructor %make-decoder)) paths)

(defun make-encoder ()
  (%make-encoder :seen (make-hash-table :test #'equal)
                 :ids (make-hash-table :test #'equal)
                 :next-id 0))

(defun make-decoder ()
  (%make-decoder :paths (make-hash-table)))

(defun encoder-encode (encoder ops)
  ;; Path omission stays inside one batch. Ids survive so a later batch can
  ;; reference a path this encoder already defined.
  (let ((previous nil)
        (out nil))
    (dolist (op ops)
      (if (string= (first op) "r")
          (progn
            (push op out)
            (clrhash (encoder-seen encoder))
            (clrhash (encoder-ids encoder))
            (setf (encoder-next-id encoder) 0
                  previous nil))
          (let* ((path (second op))
                 (key (path-key path)))
            (cond
              ((and previous (string= key previous))
               (push (case (intern-keyword (first op))
                       (:s (list "s" (third op)))
                       (:d (list "d"))
                       (:a (list "a" (third op)))
                       (:t (list "t" (third op)))
                       (:p (list "p" (third op) (fourth op) (fifth op)))
                       (:m (list "m" (third op))))
                     out))
              (t
               (let ((ref path))
                 (multiple-value-bind (existing found) (gethash key (encoder-ids encoder))
                   (cond
                     (found (setf ref existing))
                     ((gethash key (encoder-seen encoder))
                      (let ((id (encoder-next-id encoder)))
                        (incf (encoder-next-id encoder))
                        (setf (gethash key (encoder-ids encoder)) id)
                        (push (list "#" id path) out)
                        (setf ref id)))
                     (t (setf (gethash key (encoder-seen encoder)) t))))
                 (push (case (intern-keyword (first op))
                         (:s (list "s" ref (third op)))
                         (:d (list "d" ref))
                         (:a (list "a" ref (third op)))
                         (:t (list "t" ref (third op)))
                         (:p (list "p" ref (third op) (fourth op) (fifth op)))
                         (:m (list "m" ref (third op))))
                       out)
                 (setf previous key)))))))
    (nreverse out)))

(defun decoder-decode (decoder wire)
  (let ((previous nil)
        (out nil))
    (dolist (op wire)
      (assert-valid-wire-op op)
      (case (intern-keyword (first op))
        (:hash
         (assert-safe-path (third op))
         (setf (gethash (second op) (decoder-paths decoder)) (third op)))
        (:r
         (push op out)
         (clrhash (decoder-paths decoder))
         (setf previous nil))
        (t
         (let* ((short (or (and (string= (first op) "d") (= (length op) 1))
                           (and (not (member (first op) '("d" "p") :test #'string=))
                                (= (length op) 2))
                           (and (string= (first op) "p") (= (length op) 4))))
                (path (if short
                          (or previous (error 'path-error :path nil))
                          (let ((ref (second op)))
                            (if (integerp ref)
                                (or (gethash ref (decoder-paths decoder))
                                    (error 'path-error :path ref))
                                ref)))))
           (unless short (setf previous path))
           (when (and (not (member (first op) '("p" "m") :test #'string=)) (null path))
             (error 'path-error :path path))
           (push (case (intern-keyword (first op))
                   (:s (list "s" path (if short (second op) (third op))))
                   (:d (list "d" path))
                   (:a (list "a" path (if short (second op) (third op))))
                   (:t (list "t" path (if short (second op) (third op))))
                   (:p (if short
                           (list "p" path (second op) (third op) (fourth op))
                           (list "p" path (third op) (fourth op) (fifth op))))
                   (:m (list "m" path (if short (second op) (third op)))))
                 out)))))
    (nreverse out)))

(defun json-own (container key)
  (cond
    ((hash-table-p container) (nth-value 1 (gethash key container)))
    ((and (vectorp container) (integerp key) (>= key 0) (< key (length container))) t)
    (t nil)))

(defun json-read (container key)
  (cond
    ((hash-table-p container) (gethash key container))
    ((vectorp container) (aref container key))))

(defun json-write (container key value)
  (cond
    ((hash-table-p container) (setf (gethash key container) value))
    ((vectorp container)
     (unless (integerp key) (error 'unsafe-path-error :segment key))
     (when (> key (length container)) (error 'unsafe-path-error :segment key))
     (if (= key (length container))
         (vector-push-extend value container)
         (setf (aref container key) value)))))

(defun json-copy-container (value)
  (cond
    ((and (vectorp value) (not (stringp value)))
     (let ((copy (json-array)))
       (loop for element across value do (vector-push-extend element copy))
       copy))
    ((hash-table-p value)
     (let ((copy (json-object)))
       (dolist (key (json-keys value))
         (setf (gethash key copy) (gethash key value)))
       copy))
    (t (error 'path-error :path nil))))

(defun resolve-container (root path)
  (let ((node root))
    (dolist (segment path)
      (unless (json-container-p node) (error 'path-error :path path))
      (when (and (vectorp node) (not (integerp segment)))
        (error 'unsafe-path-error :segment segment))
      (unless (json-own node segment) (error 'path-error :path path))
      (setf node (json-read node segment)))
    (unless (json-container-p node) (error 'path-error :path path))
    node))

(defun copy-containers (root path owned)
  (unless (json-container-p root) (error 'path-error :path path))
  (let ((copied (if (gethash root owned)
                    root
                    (let ((copy (json-copy-container root)))
                      (setf (gethash copy owned) t)
                      copy))))
    (let ((destination copied))
      (dolist (segment path)
        (unless (json-own destination segment) (error 'path-error :path path))
        (when (and (vectorp destination) (not (integerp segment)))
          (error 'unsafe-path-error :segment segment))
        (let ((child (json-read destination segment)))
          (unless (json-container-p child) (error 'path-error :path path))
          (if (gethash child owned)
              (setf destination child)
              (let ((copied-child (json-copy-container child)))
                (json-write destination segment copied-child)
                (setf (gethash copied-child owned) t
                      destination copied-child))))))
    copied))

(defun apply-ops (target ops)
  (let ((root target))
    (dolist (op ops)
      (assert-valid-op op)
      (case (intern-keyword (first op))
        (:r (setf root (second op)))
        (:p
         (let ((array (if (null (second op)) root (resolve-container root (second op)))))
           (unless (and (vectorp array) (not (stringp array)))
             (error 'path-error :path (second op)))
           (let* ((index (third op))
                  (remove (min (fourth op) (max 0 (- (length array) index))))
                  (kept (json-array)))
             (loop for position from 0 below (length array)
                   unless (and (>= position index) (< position (+ index remove)))
                     do (vector-push-extend (aref array position) kept))
             (loop for item in (fifth op)
                   for position from index
                   do (setf kept (insert-at kept position item)))
             (if (null (second op))
                 (setf root kept)
                 (json-write (resolve-container root (butlast (second op)))
                             (car (last (second op)))
                             kept)))))
        (:m
         (let ((array (if (null (second op)) root (resolve-container root (second op)))))
           (unless (and (vectorp array) (= (length array) (length (third op))))
             (error 'path-error :path (second op)))
           (let ((previous (coerce array 'list)))
             (loop for source in (third op)
                   for index from 0
                   do (setf (aref array index) (nth source previous))))))
        (t
         (let* ((path (second op))
                (parent (resolve-container root (butlast path)))
                (key (car (last path))))
           (when (and (vectorp parent) (not (integerp key)))
             (error 'unsafe-path-error :segment key))
           (when (and (vectorp parent) (> key (length parent)))
             (error 'unsafe-path-error :segment key))
           (case (intern-keyword (first op))
             (:s (json-write parent key (third op)))
             (:d
              (cond
                ((vectorp parent)
                 (unless (< key (length parent)) (error 'path-error :path path))
                 (let ((kept (json-array)))
                   (loop for position from 0 below (length parent)
                         unless (= position key)
                           do (vector-push-extend (aref parent position) kept))
                   (replace-array parent kept)))
                (t (remhash key parent))))
             (:a
              (let ((current (json-read parent key)))
                (unless (stringp current) (error 'path-error :path path))
                (json-write parent key (concatenate 'string current (third op)))))
             (:t
              (let ((current (json-read parent key)))
                (unless (stringp current) (error 'path-error :path path))
                (json-write parent key (subseq current (third op))))))))))
    root))

(defun insert-at (array index item)
  (let ((copy (json-array)))
    (loop for position from 0 below (length array)
          do (when (= position index) (vector-push-extend item copy))
             (vector-push-extend (aref array position) copy))
    (when (= index (length array)) (vector-push-extend item copy))
    copy))

(defun replace-array (array replacement)
  (setf (fill-pointer array) 0)
  (loop for element across replacement do (vector-push-extend element array))
  array)

(defun apply-immutable (target ops)
  (let ((root target)
        (owned (make-hash-table :test #'eq)))
    (dolist (op ops)
      (assert-valid-op op)
      (if (string= (first op) "r")
          (setf root (second op))
          (let ((parent-path (if (member (first op) '("p" "m") :test #'string=)
                                 (second op)
                                 (butlast (second op)))))
            (setf root (copy-containers root parent-path owned))
            (setf root (apply-ops root (list op))))))
    root))

(defun overlap-text (left right scan &optional (probe 64) (max-candidates 8))
  (when (or (zerop (length left)) (zerop (length right)) (zerop scan))
    (return-from overlap-text 0))
  (let ((tail (if (> (length left) scan) (subseq left (- (length left) scan)) left)))
    (dolist (head-length (list (min probe (length right)) 1))
      (let ((head (subseq right 0 head-length))
            (tried 0)
            (start 0))
        (loop
          (let ((found (search head tail :start2 start)))
            (unless found (return))
            (incf tried)
            (when (> tried max-candidates) (return))
            (let ((n (- (length tail) found)))
              (when (and (<= n (length right))
                         (string= (subseq tail found) (subseq right 0 n)))
                (return-from overlap-text n)))
            (setf start (1+ found)))))
      (when (= head-length 1) (return))))
  0)

(defun emit-string (before after path operations)
  (unless (string= before after)
    (cond
      ((and (> (length after) (length before))
            (string= after before :end1 (length before)))
       (push (list "a" path (subseq after (length before))) operations))
      (t
       (let ((shared (overlap-text before after 65536)))
         (if (zerop shared)
             (push (list "s" path after) operations)
             (progn
               (push (list "t" path (- (length before) shared)) operations)
               (when (> (length after) shared)
                 (push (list "a" path (subseq after shared)) operations))))))))
  operations)

(defun diff-revisions (before after &optional (path nil))
  (nreverse (diff-into before after path nil)))

(defun diff-into (before after path operations)
  (cond
    ((json-deep-equal before after) operations)
    ((and (stringp before) (stringp after) path)
     (emit-string before after path operations))
    ((and (hash-table-p before) (hash-table-p after))
     (dolist (key (json-keys before))
       (unless (nth-value 1 (gethash key after))
         (push (list "d" (append path (list key))) operations)))
     (dolist (key (json-keys after))
       (let ((next (append path (list key))))
         (multiple-value-bind (left found) (gethash key before)
           (if found
               (setf operations (diff-into left (gethash key after) next operations))
               (push (list "s" next (gethash key after)) operations)))))
     operations)
    ((and (vectorp before) (vectorp after) (not (stringp before)) (not (stringp after)))
     (if (and (>= (length after) (length before))
              (loop for index from 0 below (length before)
                    always (json-deep-equal (aref before index) (aref after index))))
         (progn
           (when (> (length after) (length before))
             (push (list "p" path (length before) 0
                         (loop for index from (length before) below (length after)
                               collect (aref after index)))
                   operations))
           operations)
         (if path
             (cons (list "s" path after) operations)
             (cons (list "r" after) operations))))
    (path (cons (list "s" path after) operations))
    (t (cons (list "r" after) operations))))

(defstruct tracker value generation)
(defstruct change tracker state base generation status preparation)
(defstruct preparation tracker base value ops generation status)

(defun track (initial)
  (make-tracker :value initial :generation 0))

(defun tracker-begin-change (tracker)
  (make-change :tracker tracker
               :state (copy-json (tracker-value tracker))
               :base (tracker-value tracker)
               :generation (tracker-generation tracker)
               :status :open))

(defun change-prepare (change)
  (unless (eq (change-status change) :open)
    (error "Change has already been settled"))
  (setf (change-status change) :prepared)
  (let* ((ops (diff-revisions (change-base change) (change-state change)))
         (noop (null ops))
         (preparation
           (make-preparation :tracker (change-tracker change)
                             :base (change-base change)
                             :value (if noop (change-base change) (change-state change))
                             :ops ops
                             :generation (change-generation change)
                             :status :ready)))
    (setf (change-preparation change) preparation)))

(defun tracker-prepare-replace (tracker replacement)
  (let ((noop (json-deep-equal (tracker-value tracker) replacement)))
    (make-preparation :tracker tracker
                      :base (tracker-value tracker)
                      :value (if noop (tracker-value tracker) replacement)
                      :ops (if noop nil (list (list "r" replacement)))
                      :generation (tracker-generation tracker)
                      :status :ready)))

(defun tracker-adopt (tracker preparation)
  (cond
    ((not (eq (preparation-tracker preparation) tracker))
     (error "preparation belongs to a different tracker"))
    ((eq (preparation-status preparation) :used)
     (error "preparation has already been used"))
    ((eq (preparation-status preparation) :aborted)
     (error "Prepared change has been aborted"))
    ((/= (preparation-generation preparation) (tracker-generation tracker))
     (error "preparation is stale"))
    (t
     (setf (tracker-value tracker) (preparation-value preparation)
           (preparation-status preparation) :used)
     (incf (tracker-generation tracker))
     (tracker-value tracker))))

(defun change-abort (change)
  (let ((preparation (change-preparation change)))
    (when (and preparation (eq (preparation-status preparation) :ready))
      (setf (preparation-status preparation) :aborted)))
  (setf (change-status change) :aborted)
  nil)

(defun draft-get (draft key)
  (json-get draft key))

(defun draft-set (draft key value)
  (json-put draft key value))
