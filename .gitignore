# Native build output
/cadr
/cadr-server
*.core
*.fasl

# Local configuration and logs
.cadr/
.env
*.log
cadr-*.html
*-session-*.html
out.html

# Local render-diff scratch (845 MB of untracked replay/analysis output)
/.tmp/
/.cache/render-diff-captures/

# Local agent, test-home, and editor state
/.codex
/.tmp-home/
/.obsidian/
/docs/.obsidian/

# Local goal inputs (drafts and working specs).  Historical goal reports up to
# goal 10 live under docs/progress/; from goal 8 onward the accepted evidence
# lives under docs/acceptance/.  These root files are not tracked and have no
# durable copy — treat them as working state, not as the record.
/goal*.md

# Python bytecode
__pycache__/
*.py[cod]

# Editor and OS files
.DS_Store
.idea/
.vscode/
.zed/
*.swp
*.swo
*~
